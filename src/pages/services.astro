---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import PageHero from '../components/ui/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import RollButton from '../components/ui/RollButton.astro';
import { SERVICES } from '../lib/services';

const services = SERVICES;
---

<Layout title="Services | Confection Univers" description="Confection Univers : services de confection industrielle pour toges de graduation, uniformes scolaires, tenues de travail, blouses médicales, tenues de sport et uniformes d'écoles coraniques au Sénégal.">
	<main class="relative">
		<Navbar />
		
		<!-- En-tête de page (style Noryx) -->
		<PageHero
			tag="Nos services"
			title="Services de"
			titleAccent="Confection"
			lead="Des cérémonies de remise des diplômes aux établissements de santé, nous fabriquons des vêtements qui allient précision, confort et qualité professionnelle."
			words={['Uniformes', 'Toges', 'Blouses', 'Tenues de travail', 'Sport']}
			accent={2}
		>
			<RollButton href="/catalogue" label="Voir le catalogue" variant="solid" />
			<RollButton href="/contact" label="Demander un devis" />
		</PageHero>

		<!-- Services Grid Section -->
		<section class="relative z-10 -mt-10 scroll-mt-24 rounded-[3rem] border border-ink/5 bg-paper py-24 text-ink shadow-[0_24px_80px_-28px_rgba(5,10,20,0.14)] md:rounded-[4rem] md:py-32">
			<div class="mx-auto max-w-7xl px-6">
				<div class="mb-16 max-w-3xl md:mb-20">
					<SectionHead
						index="01"
						tag="Notre expertise"
						tone="light"
						title="Services de confection de <span class='nx-accent'>vêtements professionnels</span>"
						lead="Chaque service est conçu pour répondre aux besoins spécifiques des institutions sénégalaises, avec un souci constant de qualité et de satisfaction client."
					/>
				</div>

				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-motion-group data-motion-stagger="0.08" data-motion-scale>
					{
						services.map((s, i) => (
							<article class="service-card nx-card-lift nx-zoom group relative flex flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-paper shadow-[0_4px_24px_-8px_rgba(5,10,20,0.08)]">
								<div class="relative aspect-[4/3] overflow-hidden bg-surface/40">
									<img
										src={s.image}
										alt={s.title}
										class="service-card-img h-full w-full object-cover transition duration-700 ease-out"
										width="640"
										height="480"
										loading="lazy"
										decoding="async"
									/>
									<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/25 via-transparent to-transparent opacity-0 transition duration-500 group-hover:opacity-100" aria-hidden="true" />
									<span class="absolute left-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-primary/30 bg-background/85 font-display text-xs font-semibold text-primary backdrop-blur-sm transition duration-500 group-hover:border-primary group-hover:bg-primary group-hover:text-background" aria-hidden="true">
										{String(i + 1).padStart(2, '0')}
									</span>
								</div>

								<div class="flex flex-1 flex-col p-6 md:p-7">
									<h3 class="font-display text-xl font-semibold leading-snug tracking-tight text-ink transition duration-300 group-hover:text-primary md:text-[1.35rem]">
										{s.title}
									</h3>
									<p class="mt-3 flex-1 text-sm leading-relaxed text-ink/65 md:text-[0.9375rem]">{s.description}</p>
									<a href={`/services/${s.slug}`} class="mt-5 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-primary opacity-90 transition duration-300 group-hover:gap-3">
										En savoir plus
										<svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
										</svg>
									</a>
								</div>
							</article>
						))
					}
				</div>

				<div class="mt-16 flex flex-col items-center justify-center gap-4 border-t border-primary/10 pt-12 text-center md:mt-20 md:flex-row md:gap-8">
					<p class="max-w-md text-sm text-ink/55 md:text-base">Un projet spécifique ? Nous personnalisons la coupe, les tissus et les finitions pour votre institution.</p>
					<a
						href="/contact"
						class="inline-flex shrink-0 items-center justify-center rounded-full border border-primary/40 bg-ink px-8 py-3.5 text-[12px] font-semibold uppercase tracking-[0.18em] text-paper transition duration-400 hover:bg-primary hover:text-background"
					>
						Demander un devis
					</a>
				</div>
			</div>
		</section>

		<!-- Process Section -->
		<section class="relative z-10 -mt-10 rounded-[4rem] bg-background py-32 text-foreground">
			<div class="mx-auto max-w-7xl px-6">
				<div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
					<p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.35em] text-primary md:text-xs">Notre processus</p>
					<h2 class="font-display text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
						De la conception à la livraison
					</h2>
				</div>

				<div class="grid gap-12 md:grid-cols-4">
					<div class="space-y-6 text-center">
						<div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-primary/20 text-4xl">
							1
							<div class="absolute -right-4 top-1/2 hidden h-0.5 w-8 bg-primary/30 md:block"></div>
						</div>
						<h3 class="font-display text-xl font-semibold text-foreground">Consultation</h3>
						<p class="text-sm leading-relaxed text-foreground/65">
							Nous discutons de vos besoins, préférences et budget pour créer une solution sur mesure.
						</p>
					</div>

					<div class="space-y-6 text-center">
						<div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-primary/20 text-4xl">
							2
							<div class="absolute -right-4 top-1/2 hidden h-0.5 w-8 bg-primary/30 md:block"></div>
						</div>
						<h3 class="font-display text-xl font-semibold text-foreground">Conception</h3>
						<p class="text-sm leading-relaxed text-foreground/65">
							Nos créateurs développent des prototypes et échantillons selon vos spécifications.
						</p>
					</div>

					<div class="space-y-6 text-center">
						<div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-primary/20 text-4xl">
							3
							<div class="absolute -right-4 top-1/2 hidden h-0.5 w-8 bg-primary/30 md:block"></div>
						</div>
						<h3 class="font-display text-xl font-semibold text-foreground">Production</h3>
						<p class="text-sm leading-relaxed text-foreground/65">
							Fabrication en série dans notre atelier avec contrôle qualité à chaque étape.
						</p>
					</div>

					<div class="space-y-6 text-center">
						<div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-primary/20 text-4xl">
							4
						</div>
						<h3 class="font-display text-xl font-semibold text-foreground">Livraison</h3>
						<p class="text-sm leading-relaxed text-foreground/65">
							Livraison ponctuelle dans tout le Sénégal avec suivi et support client.
						</p>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</main>
</Layout>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.service-card:hover .service-card-img {
			transform: scale(1.06);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.service-card {
			transition: none;
		}
		.service-card:hover {
			transform: none;
		}
	}
</style>
