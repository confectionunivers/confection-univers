---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import CataloguePreview from '../components/CataloguePreview.astro';
import OrderProcess from '../components/OrderProcess.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Confection Univers | Confection de vêtements professionnels au Sénégal"
	description="Confection Univers accompagne les institutions et les entreprises dans la confection d'uniformes scolaires, de toges, de tenues de travail, de vêtements de sport et de blouses médicales au Sénégal."
>
	<main>
		<Navbar />
		<Hero />
		<div class="relative z-10 -mt-px">
			<TrustBadges />
		</div>
		<About />
		<Services />
		<CataloguePreview />
		<OrderProcess />
		<FAQ />
		<Contact />
		<Footer />
	</main>
</Layout>
