---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import Navbar from '../components/Navbar.astro';
import HeroCreative from '../components/HeroCreative.astro';
import TrustBadges from '../components/TrustBadges.astro';
import About from '../components/About.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import TextileQuality from '../components/TextileQuality.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import Projects from '../components/Projects.astro';
import OrderProcess from '../components/OrderProcess.astro';
import DirectorMessage from '../components/DirectorMessage.astro';
import TeamSection from '../components/TeamSection.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { faqSchema, SITE } from '../lib/seo';
import { FAQ_ITEMS } from '../lib/faq-data';
---

<Layout
	title="Confection Univers | Confection industrielle au Sénégal"
	description="Confection Univers, atelier industriel à Thiès (Sénégal) : uniformes scolaires, toges de graduation, blouses médicales, tenues de travail et de sport sur mesure."
	path="/"
	keywords={[...SITE.keywords]}
	schema={faqSchema(FAQ_ITEMS)}
>
	<main class="border-0" style="border: none !important; outline: none !important; box-shadow: none !important;">
		<Preloader />
		<Navbar />
		<HeroCreative />
		<div class="relative z-10 -mt-px">
			<TrustBadges />
		</div>
		<About />
		<WhyChoose />
		<Services />
		<Gallery />
		<TextileQuality />
		<BrandMarquee />
		<Projects />
		<OrderProcess />
		<DirectorMessage />
		<TeamSection />
		<Pricing />
		<FAQ />
		<Contact />
		<Footer />
	</main>
</Layout>
