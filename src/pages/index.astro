---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import About from '../components/About.astro';
import IndustrialProduction from '../components/IndustrialProduction.astro';
import Services from '../components/Services.astro';
import CataloguePreview from '../components/CataloguePreview.astro';
import OrderProcess from '../components/OrderProcess.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Confection Univers | Confection industrielle au Sénégal"
	description="Confection Univers est une entreprise de confection industrielle au Sénégal. Nous produisons en volume des uniformes, vêtements professionnels, tenues institutionnelles et vêtements personnalisés pour les entreprises, écoles et institutions."
>
	<main>
		<Navbar />
		<Hero />
		<div class="relative z-10 -mt-px">
			<TrustBadges />
		</div>
		<About />
		<IndustrialProduction />
		<Services />
		<CataloguePreview />
		<OrderProcess />
		<FAQ />
		<Contact />
		<Footer />
	</main>
</Layout>
