---
const catalogueUrl = '/catalogue/';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=${catalogueUrl}`} />
		<link rel="canonical" href={`https://confectionunivers.com${catalogueUrl}`} />
		<title>Redirection vers le catalogue | Confection Univers</title>
	</head>
	<body>
		<p>Le catalogue a changé d’adresse. <a href={catalogueUrl}>Accéder au catalogue</a>.</p>
		<script>window.location.replace('/catalogue/');</script>
	</body>
</html>
