---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import { COLLECTIONS, getCollection } from '../../lib/site-data';
import { collectionSchema } from '../../lib/seo';

export function getStaticPaths() {
	// Une seule source de vérité : src/lib/site-data.ts alimente aussi le
	// sitemap, les fils d'Ariane et le schéma CollectionPage.
	return COLLECTIONS.map((entry) => ({ params: { category: entry.slug } }));
}

const { category } = Astro.params;

const collection = getCollection(category ?? '');

if (!collection) {
	return Astro.redirect('/catalogue');
}

const trail = [
	{ name: 'Accueil', path: '/' },
	{ name: 'Catalogue', path: '/catalogue' },
	{ name: collection.name, path: `/collections/${collection.slug}` },
];

// Maillage croisé : les collections sœurs et la prestation correspondante.
const relatedCollections = COLLECTIONS.filter((entry) => entry.slug !== collection.slug).slice(0, 3);
---

<Layout
	title={collection.seoTitle}
	description={collection.description}
	path={`/collections/${collection.slug}`}
	image={collection.images[0]}
	imageAlt={`${collection.name} confectionnés par Confection Univers au Sénégal`}
	breadcrumbs={trail}
	schema={collectionSchema(collection)}
>
	<main id="main-content" tabindex="-1" class="relative">
		<Navbar />
		
		<!-- Hero Section -->
		<section class="relative min-h-[40vh] flex flex-col justify-center overflow-hidden pb-16 pt-32 md:pt-40" style="background: linear-gradient(135deg, #00001C 0%, #00002a 60%, #020617 100%);">
			<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_85%_60%_at_100%_0%,rgba(212,175,55,0.12),transparent_55%),radial-gradient(ellipse_70%_50%_at_0%_100%,rgba(212,175,55,0.08),transparent_50%)]"></div>
			
			<div class="mx-auto max-w-7xl px-6">
				<Breadcrumbs trail={trail} />
				<p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.38em] text-[#D4AF37] md:text-xs">
					Collection
				</p>
				<h1 class="font-display text-[clamp(2.5rem,6vw,4.75rem)] font-semibold leading-[1.05] tracking-tight text-white md:leading-[1.02]">
					<span class="mt-1 block bg-gradient-to-r from-[#D4AF37] via-[#FFFDF2] to-[#D4AF37] bg-clip-text text-transparent">
						{collection.name}
					</span>
				</h1>
				<a
					href="/catalogue"
					class="mt-6 inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 transition-all duration-300 hover:text-[#D4AF37] hover:gap-3"
				>
					<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
					</svg>
					Retour aux collections
				</a>
			</div>
		</section>

		<!-- Photo Lookbook Gallery -->
		<section class="relative z-10 py-20" style="background: linear-gradient(180deg, #00002a 0%, #00001C 100%);">
			<div class="mx-auto max-w-7xl px-6">
				<div class={collection.images.length === 1 ? 'mx-auto max-w-md' : 'grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'}>
					{
						collection.images.map((image, i) => (
							<div 
								class="photo-frame group relative overflow-hidden rounded-2xl border border-[#D4AF37]/20 bg-white/5 backdrop-blur-sm shadow-[0_8px_32px_-12px_rgba(0,0,0,0.3)] transition-all duration-500 ease-out will-change-transform hover:-translate-y-1.5 hover:border-[#D4AF37] hover:shadow-[0_12px_40px_rgba(212,175,55,0.15)] cursor-pointer"
								data-image={image}
								tabindex="0"
								role="button"
								aria-label={`Agrandir l’image — modèle ${i + 1} sur ${collection.images.length}`}
							>
								<div class="relative aspect-[3/4] overflow-hidden">
									<Picture
										src={image}
										alt={`${collection.name} confectionnés par Confection Univers — modèle ${i + 1}`}
										class="h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-105"
										sizes="(min-width: 1280px) 25vw, (min-width: 768px) 50vw, 100vw"
										loading={i < 4 ? 'eager' : 'lazy'}
										fetchpriority={i === 0 ? 'high' : 'auto'}
									/>
									<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#00001C]/60 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
									
									<!-- Zoom Icon Overlay -->
									<div class="absolute inset-0 flex items-center justify-center opacity-0 transition-all duration-500 group-hover:opacity-100">
										<div class="rounded-full bg-[#D4AF37]/20 backdrop-blur-md p-4 border border-[#D4AF37]/30">
											<svg class="h-6 w-6 text-[#D4AF37]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
											</svg>
										</div>
									</div>
								</div>
							</div>
						))
					}
				</div>
				{collection.images.length === 1 && (
					<p class="mx-auto mt-6 max-w-md text-center text-sm text-white/60">Visuel d’illustration. Contactez-nous pour définir le modèle souhaité.</p>
				)}
			</div>
		</section>

		<!-- Maillage interne : renforce le crawl des pages sœurs et de la prestation -->
		<section class="relative z-10 pb-4">
			<div class="mx-auto max-w-7xl px-6">
				<div class="flex flex-col gap-6 rounded-3xl border border-[#D4AF37]/15 bg-white/5 p-8 backdrop-blur-sm md:flex-row md:items-center md:justify-between">
					<div>
						<h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#D4AF37]">Explorer aussi</h2>
						<div class="mt-3 flex flex-wrap gap-2">
							{relatedCollections.map((entry) => (
								<a
									href={`/collections/${entry.slug}`}
									class="rounded-full border border-white/10 px-4 py-2 text-xs font-semibold text-white/70 transition-colors hover:border-[#D4AF37]/50 hover:text-[#D4AF37]"
								>
									{entry.name}
								</a>
							))}
						</div>
					</div>
					{collection.serviceSlug && (
						<a
							href={`/services/${collection.serviceSlug}`}
							class="inline-flex shrink-0 items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-[#D4AF37] transition-all hover:gap-3"
						>
							Découvrir la prestation {collection.name}
							<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</a>
					)}
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="relative z-10 py-20" style="background: linear-gradient(180deg, #00001C 0%, #00002a 100%);">
			<div class="mx-auto max-w-4xl px-6 text-center">
				<div class="relative overflow-hidden rounded-[3rem] border border-[#D4AF37]/20 bg-white/5 backdrop-blur-sm p-12 md:p-16">
					<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_60%_at_50%_0%,rgba(212,175,55,0.1),transparent_55%)]"></div>
					
					<div class="relative z-10">
						<h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
							Intéressé par cette collection ?
						</h2>
						<p class="mt-4 text-base leading-relaxed text-white/70 md:text-lg">
							Contactez-nous pour personnaliser votre commande selon vos besoins.
						</p>
						<a
							href="/contact"
							class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-[#D4AF37] px-8 py-4 text-[12px] font-bold uppercase tracking-[0.18em] text-[#00001C] transition-all duration-300 hover:bg-[#FFFDF2] hover:shadow-[0_8px_25px_rgba(212,175,55,0.3)] hover:scale-105"
						>
							Demander un devis
							<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>

		<Footer />

		<!-- Lightbox Modal -->
		<div id="lightbox" role="dialog" aria-modal="true" aria-label={`Image agrandie — ${collection.name}`} class="lightbox fixed inset-0 z-[100] hidden items-center justify-center bg-[#00001C]/95 backdrop-blur-xl">
			<button id="lightbox-close" type="button" aria-label="Fermer l’image agrandie" class="absolute top-6 right-6 rounded-full bg-white/10 p-3 text-white transition-all duration-300 hover:bg-[#D4AF37] hover:text-[#00001C]">
				<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<button id="lightbox-prev" type="button" aria-label="Image précédente" class="absolute left-6 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-4 text-white transition-all duration-300 hover:bg-[#D4AF37] hover:text-[#00001C]">
				<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
			</button>
			<button id="lightbox-next" type="button" aria-label="Image suivante" class="absolute right-6 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-4 text-white transition-all duration-300 hover:bg-[#D4AF37] hover:text-[#00001C]">
				<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</button>
			<div class="relative max-h-[90vh] max-w-[90vw]">
				<img id="lightbox-image" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />
			</div>
		</div>
	</main>

	<script>
		// Lightbox functionality
		const lightbox = document.getElementById('lightbox');
		const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
		const lightboxClose = document.getElementById('lightbox-close');
		const lightboxPrev = document.getElementById('lightbox-prev');
		const lightboxNext = document.getElementById('lightbox-next');
		const photoFrames = document.querySelectorAll('.photo-frame');
		
		let currentIndex = 0;
		const images = Array.from(photoFrames).map(frame => (frame as HTMLElement).dataset.image);
		const alts = Array.from(photoFrames).map(frame => (frame.querySelector('img') as HTMLImageElement | null)?.alt ?? '');
		let lastTrigger: HTMLElement | null = null;

		function openLightbox(index: number, trigger: HTMLElement | null = null) {
			currentIndex = index;
			lastTrigger = trigger;
			if (lightboxImage) {
				lightboxImage.src = images[index] ?? '';
				lightboxImage.alt = alts[index] ?? '';
			}
			lightbox?.classList.remove('hidden');
			lightbox?.classList.add('flex');
			document.body.style.overflow = 'hidden';
			/* Le focus entre dans le dialogue : Échap et Tab sont immédiatement utiles. */
			lightboxClose?.focus();
		}

		function closeLightbox() {
			lightbox?.classList.add('hidden');
			lightbox?.classList.remove('flex');
			document.body.style.overflow = '';
			/* Le focus retourne à la vignette qui avait ouvert la lightbox. */
			lastTrigger?.focus();
			lastTrigger = null;
		}

		function showPrev() {
			currentIndex = (currentIndex - 1 + images.length) % images.length;
			if (lightboxImage) {
				lightboxImage.src = images[currentIndex] ?? '';
				lightboxImage.alt = alts[currentIndex] ?? '';
			}
		}

		function showNext() {
			currentIndex = (currentIndex + 1) % images.length;
			if (lightboxImage) {
				lightboxImage.src = images[currentIndex] ?? '';
				lightboxImage.alt = alts[currentIndex] ?? '';
			}
		}

		photoFrames.forEach((frame, index) => {
			const el = frame as HTMLElement;
			el.addEventListener('click', () => openLightbox(index, el));
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					openLightbox(index, el);
				}
			});
		});

		lightboxClose?.addEventListener('click', closeLightbox);
		lightboxPrev?.addEventListener('click', showPrev);
		lightboxNext?.addEventListener('click', showNext);

		// Clavier : Échap ferme, flèches naviguent, Tab reste piégé dans le dialogue
		document.addEventListener('keydown', (e) => {
			/* Lightbox fermée : ne rien intercepter (flèches, Échap, Tab). */
			if (!lightbox || lightbox.classList.contains('hidden')) return;
			if (e.key === 'Escape') closeLightbox();
			if (e.key === 'ArrowLeft') showPrev();
			if (e.key === 'ArrowRight') showNext();
			if (e.key === 'Tab') {
				/* Le focus reste piégé dans le dialogue : cycle sur les 3 boutons. */
				const focusables = [lightboxClose, lightboxPrev, lightboxNext].filter(
					(b): b is HTMLElement => b instanceof HTMLElement,
				);
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				const active = document.activeElement;
				if (!lightbox.contains(active)) {
					e.preventDefault();
					first?.focus();
				} else if (e.shiftKey && active === first) {
					e.preventDefault();
					last?.focus();
				} else if (!e.shiftKey && active === last) {
					e.preventDefault();
					first?.focus();
				}
			}
		});

		// Close on background click
		lightbox?.addEventListener('click', (e) => {
			if (e.target === lightbox) closeLightbox();
		});
	</script>
</Layout>
