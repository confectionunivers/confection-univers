---
import SewingDecor from './decor/SewingDecor.astro';
import StitchFrame from './decor/StitchFrame.astro';
import SectionHead from './ui/SectionHead.astro';
import Counter from './ui/Counter.astro';
import RollButton from './ui/RollButton.astro';

/**
 * Section « À propos » — structure Noryx :
 *   { 01 } # À propos  →  grand titre  →  collage d'images parallaxe
 *   →  compteurs  →  accordéon Mission / Vision
 */
const values = [
	{
		index: '01',
		title: 'Notre mission',
		text: 'Fournir des tenues de qualité exceptionnelle qui incarnent la rigueur et l’identité de chaque institution.',
		points: ['Étude du besoin', 'Patronage sur mesure', 'Contrôle qualité'],
	},
	{
		index: '02',
		title: 'Notre vision',
		text: 'Devenir le partenaire de référence pour toutes les institutions en quête d’excellence vestimentaire.',
		points: ['Production en série', 'Délais tenus', 'Accompagnement continu'],
	},
];

const stats = [
	{ to: 8, suffix: '', label: 'gammes de confection maîtrisées' },
	{ to: 100, suffix: '%', label: 'des pièces contrôlées avant livraison' },
	{ to: 3, suffix: '', label: 'étapes claires, du devis à la livraison' },
];
---

<section id="a-propos" class="about-section nx-grain relative overflow-hidden px-6 py-24 md:py-32" aria-labelledby="about-heading">
	<!-- Halos -->
	<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
		<div class="absolute left-[8%] top-[16%] h-[520px] w-[520px] rounded-full" style="background: radial-gradient(ellipse, rgba(245, 181, 68, 0.09) 0%, transparent 70%); filter: blur(130px);"></div>
		<div class="absolute bottom-[24%] right-[12%] h-[420px] w-[420px] rounded-full" style="background: radial-gradient(ellipse, rgba(245, 181, 68, 0.07) 0%, transparent 70%); filter: blur(110px);"></div>
	</div>

	<div class="relative mx-auto max-w-7xl">
		<SectionHead
			index="01"
			tag="À propos"
			title="L’excellence de la confection <span class='nx-accent'>industrielle</span> au service de votre image."
			lead="La confection de tenues professionnelles et d’uniformes adaptés aux besoins de chaque organisation."
		/>

		<!-- Collage d'images + texte -->
		<div class="mt-16 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
			<!-- Collage : deux images décalées, la seconde en parallaxe -->
			<div class="relative">
				<div class="relative overflow-hidden rounded-[1.75rem] border border-[#F5B544]/25" data-motion="scale">
					<StitchFrame class="text-[#F5B544] opacity-45" inset="-inset-3" size={38} stroke={2} />
					<div class="aspect-[4/5] overflow-hidden" data-motion-clip>
						<img
							src="/images/about-facility.jpg"
							alt="Professionnelle portant une tenue confectionnée par Confection Univers"
							class="h-full w-full object-cover"
							width="900"
							height="1125"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>

				<!-- Seconde image, posée en bas à droite, avec parallaxe -->
				<div class="absolute -bottom-10 -right-4 hidden w-[46%] overflow-hidden rounded-[1.25rem] border border-[#F5B544]/30 bg-[#000058] shadow-[0_28px_60px_rgba(0,0,0,0.45)] sm:block lg:-right-10">
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src="/images/production-atelier.jpg"
							alt="Atelier de confection en activité"
							class="h-full w-full object-cover"
							width="640"
							height="480"
							loading="lazy"
							decoding="async"
							data-motion-parallax
							data-speed="0.1"
						/>
					</div>
				</div>

				<!-- Pastille lieu -->
				<div class="nx-badge absolute left-4 top-4 backdrop-blur-md">
					<span class="h-1.5 w-1.5 rounded-full bg-[#F5B544]"></span>
					Thiès, Sénégal
				</div>
			</div>

			<!-- Texte + accordéon -->
			<div>
				<h3 class="nx-display nx-display--md text-white" data-motion="up">Notre savoir-faire</h3>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-[#A0ACC6] md:text-lg" data-motion="up" data-motion-delay="0.08">
					Chaque commande part d’un besoin réel : un métier, une école, une équipe. Nous traduisons ce besoin
					en pièces portables, durables et cohérentes avec votre image.
				</p>

				<!-- Accordéon Mission / Vision, comme les blocs Noryx -->
				<div class="nx-acc mt-10" data-accordion data-motion="up" data-motion-delay="0.14">
					{values.map((item, i) => (
						<div class="nx-acc__item" data-open={i === 0 ? 'true' : 'false'}>
							<button type="button" class="nx-acc__trigger text-white">
								<span class="nx-acc__index">{item.index}</span>
								<span class="nx-acc__question">{item.title}</span>
								<span class="nx-acc__sign" aria-hidden="true"></span>
							</button>
							<div class="nx-acc__body">
								<div>
									<div class="nx-acc__answer">
										<p class="text-[#A0ACC6]">{item.text}</p>
										<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
											{item.points.map((point) => (
												<li class="flex items-center gap-2 text-sm text-[#A0ACC6]">
													<span class="h-1 w-1 rounded-full bg-[#F5B544]"></span>
													{point}
												</li>
											))}
										</ul>
									</div>
								</div>
							</div>
						</div>
					))}
				</div>

				<div class="mt-10">
					<RollButton href="/about" label="En savoir plus" variant="solid" />
				</div>
			</div>
		</div>

		<!-- Compteurs -->
		<div class="nx-divider mt-24"></div>
		<div class="mt-12 grid gap-10 sm:grid-cols-3" data-motion-group data-motion-stagger="0.12">
			{stats.map((stat) => (
				<Counter to={stat.to} suffix={stat.suffix} label={stat.label} tone="dark" />
			))}
		</div>
	</div>

	<!-- Décors de couture -->
	<SewingDecor variant="mannequin" class="pointer-events-none absolute -left-2 bottom-[22%] hidden h-24 w-24 text-[#F5B544] opacity-[0.13] xl:block" />
	<SewingDecor variant="spool" class="pointer-events-none absolute right-[42%] top-4 hidden h-14 w-14 text-[#F5B544] opacity-[0.14] xl:block" />
	<SewingDecor variant="yarn" class="pointer-events-none absolute -right-4 bottom-6 hidden h-24 w-24 text-[#F5B544] opacity-[0.12] lg:block" />
	<SewingDecor variant="tape" class="pointer-events-none absolute bottom-10 left-1 hidden h-20 w-20 text-[#F5B544] opacity-[0.16] lg:block" />
	<SewingDecor variant="thimble" class="pointer-events-none absolute right-2 top-10 hidden h-16 w-16 rotate-[14deg] text-[#F5B544] opacity-[0.16] xl:block" />
</section>

<style>
	.about-section {
		/* Dégradé du bleu de nuit du logo : #00004A ↔ #00004B */
		background: linear-gradient(165deg, #00004a 0%, #00004b 42%, #000058 100%);
	}
</style>
