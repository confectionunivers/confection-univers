---
import SewingDecor from './decor/SewingDecor.astro';
import StitchLine from './decor/StitchLine.astro';
import SectionHead from './ui/SectionHead.astro';
import RollButton from './ui/RollButton.astro';

/**
 * Section FAQ — accordéon numéroté façon Noryx :
 *   { 06 } # FAQ  →  questions repliées, une seule ouverte à la fois,
 *   encadré « encore une question ? » sur le côté.
 */
const faqItems = [
	{
		question: 'Existe-t-il une quantité minimale de commande (MOQ) ?',
		answer: 'La faisabilité et les quantités sont étudiées au cas par cas selon le modèle, les tailles et votre cahier des charges. Transmettez-nous votre besoin pour recevoir une proposition adaptée.',
	},
	{
		question: 'Quels sont vos délais moyens de confection et de livraison ?',
		answer: 'Le calendrier dépend des modèles, des quantités, des matières et des finitions retenues. Il est confirmé dans la proposition après étude de votre commande.',
	},
	{
		question: 'Proposez-vous la personnalisation complète avec nos logos ?',
		answer: 'Les options de logo, broderie ou marquage sont étudiées selon le vêtement et le support textile. La méthode retenue est à valider avant le lancement de la production.',
	},
	{
		question: 'Livrez-vous en dehors de Dakar et Thiès ?',
		answer: 'Indiquez la ville ou le site de réception dans votre demande. Les modalités et frais de livraison éventuels seront précisés avec le devis.',
	},
];
---

<section class="nx-grain relative z-10 overflow-hidden border-0 py-24 md:py-32" style="background: linear-gradient(150deg, #00004A 0%, #000058 52%, #00004A 100%);" aria-labelledby="faq-heading">
	<!-- Halos -->
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<div class="absolute left-[10%] top-[25%] h-[500px] w-[500px] rounded-full" style="background: radial-gradient(ellipse, rgba(250, 204, 107, 0.12) 0%, transparent 70%); filter: blur(100px);"></div>
		<div class="absolute bottom-[25%] right-[10%] h-[400px] w-[400px] rounded-full" style="background: radial-gradient(ellipse, rgba(250, 204, 107, 0.08) 0%, transparent 70%); filter: blur(80px);"></div>
	</div>

	<div class="mx-auto max-w-7xl px-6">
		<div class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16">
			<!-- Accordéon -->
			<div>
				<SectionHead
					index="06"
					tag="Questions fréquentes"
					title="Tout ce que vous voulez <span class='nx-accent'>savoir</span>"
					lead="Les réponses aux questions que les structures nous posent le plus souvent avant de commander."
				/>

				<div class="nx-acc mt-12" data-accordion data-motion="up" data-motion-delay="0.12">
					{faqItems.map((item, i) => (
						<div class="nx-acc__item" data-open={i === 0 ? 'true' : 'false'}>
							<button type="button" class="nx-acc__trigger text-white">
								<span class="nx-acc__index">{String(i + 1).padStart(2, '0')}.</span>
								<span class="nx-acc__question">{item.question}</span>
								<span class="nx-acc__sign" aria-hidden="true"></span>
							</button>
							<div class="nx-acc__body">
								<div>
									<p class="nx-acc__answer text-[#A0ACC6]">{item.answer}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Encadré d'appel, comme le bloc « Still not sure? » de Noryx -->
			<aside class="lg:sticky lg:top-28 lg:self-start" data-motion="up" data-motion-delay="0.18">
				<div class="nx-panel relative overflow-hidden p-8 md:p-10">
					<SewingDecor variant="tape" class="pointer-events-none absolute -right-4 -top-6 h-28 w-28 text-[#F5B544] opacity-[0.12]" />

					<span class="nx-badge">Réponse en 1 h</span>

					<h3 class="nx-display nx-display--md mt-6 text-white">
						Encore une <span class="nx-accent">question ?</span>
					</h3>

					<p class="mt-4 text-sm leading-relaxed text-[#A0ACC6]">
						Écrivez-nous votre besoin : pièces, quantités, délais. Nous revenons vers vous avec une proposition
						adaptée à votre structure.
					</p>

					<div class="mt-8 flex flex-wrap gap-3">
						<RollButton href="/contact" label="Nous écrire" variant="solid" />
						<RollButton href="/catalogue" label="Voir le catalogue" />
					</div>
				</div>

				<div class="nx-divider mt-8"></div>
				<p class="mt-6 text-xs leading-relaxed text-white/40">
					Confection Univers — atelier de confection industrielle, Thiès, Sénégal.
				</p>
			</aside>
		</div>
	</div>

	<StitchLine class="pointer-events-none absolute inset-x-8 bottom-4 text-[#F5B544]" step={18} opacity={0.22} />

	<!-- Décors de couture -->
	<SewingDecor variant="pin" class="pointer-events-none absolute right-6 top-[5%] hidden h-16 w-16 -rotate-[28deg] text-[#F5B544] opacity-[0.16] lg:block" />
	<SewingDecor variant="chalk" class="pointer-events-none absolute bottom-[6%] left-4 hidden h-16 w-16 text-[#F5B544] opacity-[0.16] lg:block" />
	<SewingDecor variant="thimble" class="pointer-events-none absolute left-6 top-[42%] hidden h-16 w-16 rotate-[-10deg] text-[#F5B544] opacity-[0.14] xl:block" />
	<SewingDecor variant="yarn" class="pointer-events-none absolute bottom-[22%] right-4 hidden h-20 w-20 text-[#F5B544] opacity-[0.13] xl:block" />
</section>
