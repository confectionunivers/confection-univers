---
import SewingDecor from './decor/SewingDecor.astro';
import StitchLine from './decor/StitchLine.astro';
import SectionHead from './ui/SectionHead.astro';
import RollButton from './ui/RollButton.astro';
const previewProducts = [
	{
		slug: 'tenues-professionnelles',
		title: 'Tenues professionnelles',
		image: '/images/tenue-travail.jpg',
		alt: 'Tenue de travail professionnelle',
	},
	{
		slug: 'uniformes-scolaires',
		title: 'Uniformes scolaires',
		image: '/images/uniforme-scolaire-1.jpg',
		alt: 'Élèves portant des uniformes scolaires coordonnés',
	},
	{
		slug: 'tenues-medicales',
		title: 'Blouses médicales',
		image: '/images/blouse-medicale.jpg',
		alt: 'Professionnelle de santé en blouse médicale',
	},
	{
		slug: 'tenues-academiques',
		title: 'Toges académiques',
		image: '/images/toge-graduation.jpg',
		alt: 'Diplômé en toge de graduation',
	},
];
---

<section
	id="aperçu-catalogue"
	class="relative z-10 scroll-mt-24 bg-[#F7F5F0] px-6 py-20 text-[#0A1628] md:py-28"
	lang="fr"
	aria-labelledby="catalogue-preview-heading"
>
	<div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:gap-16">
		<SectionHead
			index="04"
			tag="Nos gammes"
			tone="light"
			title="Le bon vêtement commence par <span class='nx-accent'>le bon usage.</span>"
			lead="Découvrez les tenues professionnelles, uniformes scolaires, vêtements médicaux et tenues académiques confectionnés pour les besoins des structures."
		>
			<RollButton href="/catalogue" label="Découvrir le catalogue" variant="solid" class="mt-7" />
		</SectionHead>

		<div class="grid grid-cols-2 gap-3 sm:gap-4" data-motion-group data-motion-stagger="0.1" data-motion-scale>
			{previewProducts.map((product, index) => (
				<a
					href={`/catalogue/#${product.slug}`}
					class="home-catalogue-card nx-card-lift group relative min-h-40 overflow-hidden rounded-[1.4rem] border border-[#B58433]/40 bg-[#00004B] shadow-[0_14px_32px_rgba(0,0,0,0.12)] sm:min-h-56 sm:rounded-[1.75rem]"
					aria-label={`Voir la gamme ${product.title} dans le catalogue`}
				>
					<img
						src={product.image}
						alt={product.alt}
						class="home-catalogue-image absolute inset-0 h-full w-full object-cover"
						width="640"
						height="480"
						loading="lazy"
						decoding="async"
					/>
					<span class="absolute inset-0 bg-gradient-to-t from-[#00004B]/90 via-[#00004B]/15 to-transparent" aria-hidden="true"></span>
					<span class="absolute left-3 top-3 rounded-full border border-white/25 bg-[#00004B]/50 px-2.5 py-1 text-[8px] font-semibold uppercase tracking-[0.14em] text-white/85 backdrop-blur-sm">0{index + 1}</span>
					<span class="absolute bottom-3 left-3 right-3 font-display text-sm font-semibold text-white sm:bottom-5 sm:left-5 sm:right-5 sm:text-lg">
						{product.title}
					</span>
				</a>
			))}
		</div>
	</div>


	<!-- Décors de couture (purement décoratifs) -->
	<SewingDecor variant="ribbon" class="pointer-events-none absolute left-4 top-4 hidden h-24 w-24 text-[#8B6325] opacity-[0.2] lg:block" />
	<SewingDecor variant="tape" class="pointer-events-none absolute bottom-16 right-6 hidden h-24 w-24 text-[#8B6325] opacity-[0.18] lg:block" />
	<SewingDecor variant="button" class="pointer-events-none absolute right-[38%] top-1/2 hidden h-14 w-14 text-[#8B6325] opacity-[0.18] xl:block" />
	<SewingDecor variant="scissors" class="pointer-events-none absolute right-4 top-6 hidden h-20 w-20 rotate-[16deg] text-[#8B6325] opacity-[0.14] lg:block" />
	<StitchLine class="pointer-events-none absolute inset-x-6 bottom-4 text-[#8B6325]" step={18} opacity={0.18} />
</section>

<style>
	.home-catalogue-card { transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease; }
	.home-catalogue-image { transition: transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1); }
	.home-catalogue-card:hover,
	.home-catalogue-card:focus-visible { transform: translateY(-3px); border-color: rgba(181, 132, 51, 0.85); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2); }
	.home-catalogue-card:hover .home-catalogue-image,
	.home-catalogue-card:focus-visible .home-catalogue-image { transform: scale(1.035); }
	@media (prefers-reduced-motion: reduce) { .home-catalogue-card, .home-catalogue-image { transition: none; } }
</style>
