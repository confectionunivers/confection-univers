---
import { catalogueProducts } from '../lib/catalogue';

const previewSlugs = ['tenues-sportives', 'arts-martiaux', 'ecoles-coraniques', 'tenues-africaines'];
const previewProducts = previewSlugs
	.map((slug) => catalogueProducts.find((product) => product.slug === slug))
	.filter((product) => product !== undefined);
---

<section
	id="aperçu-catalogue"
	class="relative z-10 scroll-mt-24 bg-[#F7F5F0] px-6 py-20 text-[#0A1628] md:py-28"
	lang="fr"
	aria-labelledby="catalogue-preview-heading"
>
	<div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:gap-16">
		<header class="max-w-xl">
			<p class="mb-4 flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-[#8B6325]">
				<span class="h-px w-8 bg-[#8B6325]" aria-hidden="true"></span>
				Nos gammes
			</p>
			<h2 id="catalogue-preview-heading" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl lg:text-5xl">
				Le bon vêtement commence par le bon usage.
			</h2>
			<p class="mt-5 text-base leading-relaxed text-[#0A1628]/65 md:text-lg">
				Uniformes, tenues d’équipe et vêtements professionnels : parcourez les solutions textiles et préparez votre demande sur mesure.
			</p>
			<a
				href="/catalogue"
				class="mt-7 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#00001C] px-6 py-3 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition-colors hover:bg-[#8B6325] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8B6325]"
			>
				Découvrir le catalogue <span aria-hidden="true">↗</span>
			</a>
		</header>

		<div class="grid grid-cols-2 gap-3 sm:gap-4">
			{previewProducts.map((product, index) => (
				<a
					href={`/catalogue/#${product.slug}`}
					class="home-catalogue-card group relative min-h-40 overflow-hidden bg-[#00001C] sm:min-h-56"
					aria-label={`Voir la gamme ${product.title} dans le catalogue`}
				>
					<img
						src={product.imageSmall}
						alt={product.alt}
						class="home-catalogue-image absolute inset-0 h-full w-full object-cover"
						width="640"
						height="480"
						loading="lazy"
						decoding="async"
					/>
					<span class="absolute inset-0 bg-gradient-to-t from-[#00001C]/90 via-[#00001C]/15 to-transparent" aria-hidden="true"></span>
					<span class="absolute left-3 top-3 text-[9px] font-semibold uppercase tracking-[0.14em] text-white/70">0{index + 1}</span>
					<span class="absolute bottom-3 left-3 right-3 font-display text-sm font-semibold text-white sm:bottom-5 sm:left-5 sm:right-5 sm:text-lg">
						{product.title}
					</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.home-catalogue-image { transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
	.home-catalogue-card:hover .home-catalogue-image { transform: scale(1.025); }
	@media (prefers-reduced-motion: reduce) { .home-catalogue-image { transition: none; } }
</style>
