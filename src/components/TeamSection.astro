---
import Picture from './Picture.astro';
// Les visuels actuels illustrent les métiers de l'entreprise, sans attribuer
// d'identité fictive aux personnes photographiées.
const expertise = [
	{ label: 'Conseil', image: '/images/about-facility.jpg' },
	{ label: 'Confection', image: '/images/production-atelier.jpg' },
	{ label: 'Finitions', image: '/images/finitions-professionnelles.jpg' },
];
---

<section id="notre-equipe" class="team-section" aria-labelledby="team-title">
	<div class="team-wrap">
		<div class="team-panel">
			<div class="team-content">
				<p class="team-pill"><span aria-hidden="true"></span> Notre équipe</p>
				<h2 id="team-title">Direction <span>& savoir-faire.</span></h2>
				<p class="team-intro">Derrière chaque tenue, il y a des personnes à l’écoute, des gestes précis et une même exigence du travail bien fait.</p>
				<p class="team-detail">De la direction à l’atelier, nous réunissons les compétences nécessaires pour donner forme à votre projet, de la première idée aux dernières finitions.</p>
				<a href="/contact" class="team-link">
					Échanger avec l’équipe
					<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
				</a>

				<div class="team-expertise" aria-label="Nos expertises">
				{expertise.map((item) => (
					<div class="expertise-item">
						<Picture src={item.image} alt="" sizes="48px" loading="lazy" />
						<span>{item.label}</span>
					</div>
				))}
				</div>
			</div>

			<div class="team-visuals">
				<div class="team-card">
					<Picture src="/images/about-facility.jpg" alt="Portrait professionnel illustrant l’accompagnement de la direction" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" />
					<div class="team-card-caption"><strong>La direction</strong><span>Écoute & accompagnement</span></div>
				</div>
				<div class="team-card">
					<Picture src="/images/production-atelier.jpg" alt="Professionnel ajustant un vêtement sur un mannequin dans l’atelier Confection Univers" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" />
					<div class="team-card-caption"><strong>L’atelier</strong><span>Création & confection</span></div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const teamSection = document.getElementById('notre-equipe');
	if (teamSection && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		teamSection.classList.add('is-ready');
		const observer = new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				teamSection.classList.add('is-visible');
				observer.disconnect();
			}
		}, { threshold: 0.12 });
		observer.observe(teamSection);
	}
</script>

<style>
	.team-section {
		position: relative;
		overflow: hidden;
		padding: clamp(5rem, 6vw, 6rem) 0 clamp(5.5rem, 8vw, 8rem);
		background: #f7f5f1;
	}

	.team-wrap {
		width: min(100% - 2.5rem, 1280px);
		margin-inline: auto;
	}

	.team-panel {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
		align-items: center;
		gap: clamp(2rem, 4vw, 4.5rem);
		padding: clamp(1.6rem, 3.3vw, 3.3rem);
		overflow: hidden;
		border: 1px solid rgba(250, 204, 107, 0.14);
		border-radius: clamp(22px, 2.3vw, 34px);
		background: linear-gradient(130deg, #080e32 0%, #050a2e 63%, #0b123c 100%);
		color: #fff;
	}

	.team-panel::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		background: radial-gradient(circle at 88% 12%, rgba(250, 204, 107, 0.1), transparent 35%);
		pointer-events: none;
	}

	.team-content {
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
	}

	.team-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.45rem;
		padding: 0.5rem 0.8rem;
		border: 1px solid rgba(250, 204, 107, 0.34);
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.03);
		color: #f1e6ca;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.team-pill > span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #facc6b;
		box-shadow: 0 0 12px #facc6b;
	}

	.team-content h2 {
		max-width: 12ch;
		margin: 0;
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(2.6rem, 4.4vw, 4.8rem);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.065em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.team-content h2 span {
		color: #facc6b;
	}

	.team-intro {
		max-width: 35rem;
		margin: 1.35rem 0 0;
		color: #f7f5f0;
		font-size: clamp(1rem, 1.18vw, 1.18rem);
		line-height: 1.5;
	}

	.team-detail {
		max-width: 35rem;
		margin: 1rem 0 0;
		color: #b9c2d8;
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.team-link {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		min-height: 44px;
		margin-top: 1.75rem;
		padding: 0.45rem 0.55rem 0.45rem 1.25rem;
		border: 1px solid #e2ae46;
		border-radius: 99px;
		background: linear-gradient(135deg, #fff0be, #facc6b 52%, #bc851b);
		box-shadow: 0 12px 25px -12px rgba(250, 204, 107, 0.65);
		color: #00001c;
		font-size: 0.77rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.team-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 16px 30px -10px rgba(250, 204, 107, 0.7);
	}

	.team-link:focus-visible {
		outline: 2px solid #fff4d0;
		outline-offset: 4px;
	}

	.team-link > span {
		display: grid;
		flex: none;
		width: 29px;
		height: 29px;
		place-items: center;
		border-radius: 50%;
		background: #00001c;
		color: #facc6b;
	}

	.team-link svg {
		width: 15px;
		height: 15px;
	}

	.team-expertise {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
		max-width: 430px;
		margin-top: 2.15rem;
	}

	.expertise-item {
		position: relative;
		min-width: 0;
		aspect-ratio: 1.18;
		overflow: hidden;
		border: 1px solid rgba(250, 204, 107, 0.2);
		border-radius: 11px;
		background: #172348;
	}

	.expertise-item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.expertise-item:hover img {
		transform: scale(1.06);
	}

	.expertise-item::after {
		content: '';
		position: absolute;
		inset: 30% 0 0;
		background: linear-gradient(0deg, rgba(0, 0, 28, 0.88), transparent);
		pointer-events: none;
	}

	.expertise-item span {
		position: absolute;
		z-index: 1;
		right: 0.4rem;
		bottom: 0.5rem;
		left: 0.55rem;
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
		text-shadow: 0 1px 7px rgba(0, 0, 0, 0.5);
	}

	.team-visuals {
		display: grid;
		grid-column: 1;
		grid-row: 1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem;
		min-width: 0;
	}

	.team-card {
		position: relative;
		aspect-ratio: 0.68;
		overflow: hidden;
		border: 1px solid rgba(250, 204, 107, 0.28);
		border-radius: 17px;
		background: #15204a;
	}

	.team-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
		transition: transform 0.5s ease;
	}

	.team-card:nth-child(2) img {
		object-position: 40% center;
	}

	.team-card:hover img {
		transform: scale(1.04);
	}

	.team-card-caption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem 0.85rem;
		background: linear-gradient(0deg, #0c153e 68%, rgba(12, 21, 62, 0.72));
	}

	.team-card-caption strong {
		font-size: 0.86rem;
		font-weight: 700;
	}

	.team-card-caption span {
		color: #b7c2dc;
		font-size: 0.66rem;
	}

	@media (min-width: 901px) {
		.team-section.is-ready .team-content,
		.team-section.is-ready .team-visuals {
			opacity: 0;
			transform: translateY(22px);
			transition: opacity 0.75s ease, transform 0.75s ease;
		}

		.team-section.is-visible .team-content,
		.team-section.is-visible .team-visuals {
			opacity: 1;
			transform: translateY(0);
		}

		.team-section.is-visible .team-content {
			transition-delay: 0.1s;
		}
	}

	@media (max-width: 900px) {
		.team-panel {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.team-content,
		.team-visuals {
			grid-column: 1;
			grid-row: auto;
		}

		.team-visuals {
			max-width: 580px;
		}
	}

	@media (max-width: 599px) {
		.team-section {
			padding: 5rem 0 5.5rem;
		}

		.team-panel {
			gap: 2.5rem;
			padding: 1.45rem;
		}

		.team-content h2 {
			font-size: clamp(2.35rem, 10vw, 3.3rem);
		}

		.team-intro {
			font-size: 1rem;
		}

		.team-expertise {
			gap: 0.5rem;
		}

		.expertise-item span {
			font-size: 0.6rem;
		}

		.team-visuals {
			gap: 0.5rem;
		}

		.team-card-caption {
			padding: 0.85rem 0.65rem;
		}

		.team-card-caption strong {
			font-size: 0.72rem;
		}

		.team-card-caption span {
			font-size: 0.58rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.team-content,
		.team-visuals,
		.team-card img,
		.expertise-item img,
		.team-link {
			transition: none !important;
		}
	}
</style>
