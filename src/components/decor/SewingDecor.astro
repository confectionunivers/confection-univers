---
/**
 * Illustrations de couture décoratives (SVG, tracées main).
 * Couleur héritée (`currentColor`) : la teinte se pilote via la classe du parent.
 *
 * Variantes : needle, scissors, button, thimble, spool, tape, pin, hook, chalk,
 * mannequin, yarn, zipper, ruler, ribbon.
 */
interface Props {
	variant:
		| 'needle'
		| 'scissors'
		| 'button'
		| 'thimble'
		| 'spool'
		| 'tape'
		| 'pin'
		| 'hook'
		| 'chalk'
		| 'mannequin'
		| 'yarn'
		| 'zipper'
		| 'ruler'
		| 'ribbon';
	class?: string;
	/** Épaisseur de trait relative (1 = défaut). */
	weight?: number;
}

const { variant, class: className = '', weight = 1 } = Astro.props;
const sw = 1.9 * weight;
---

<svg
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width={sw}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
	focusable="false"
>
	{variant === 'needle' && (
		<>
			<path d="M8.5 39.5 L33 15" />
			<path d="M30.4 17.6 L35.6 12.4" opacity="0.55" />
			<ellipse cx="34.6" cy="12.4" rx="3.1" ry="1.7" transform="rotate(-45 34.6 12.4)" />
			<path d="M36.4 10.6 C 43 5 33 1.4 26.4 6 C 20.6 10 22.6 18.4 29.4 19.2" opacity="0.8" />
			<path d="M8.5 39.5 L11 42" opacity="0.4" />
		</>
	)}

	{variant === 'scissors' && (
		<>
			<circle cx="13.5" cy="36.5" r="4.8" />
			<circle cx="34.5" cy="36.5" r="4.8" />
			<path d="M16.6 33.2 L40.5 9.5" />
			<path d="M31.4 33.2 L7.5 9.5" />
			<circle cx="24" cy="24" r="1.7" fill="currentColor" stroke="none" />
			<path d="M40.5 9.5 L35.4 14.6" opacity="0.45" />
			<path d="M7.5 9.5 L12.6 14.6" opacity="0.45" />
		</>
	)}

	{variant === 'button' && (
		<>
			<circle cx="24" cy="24" r="14.5" />
			<circle cx="24" cy="24" r="10.6" opacity="0.4" />
			<circle cx="19.2" cy="19.2" r="2.2" fill="currentColor" stroke="none" />
			<circle cx="28.8" cy="19.2" r="2.2" fill="currentColor" stroke="none" />
			<circle cx="19.2" cy="28.8" r="2.2" fill="currentColor" stroke="none" />
			<circle cx="28.8" cy="28.8" r="2.2" fill="currentColor" stroke="none" />
		</>
	)}

	{variant === 'thimble' && (
		<>
			<path d="M14.4 41 L15.6 21.4 a8.4 8.4 0 0 1 16.8 0 L33.6 41 Z" />
			<path d="M14.9 34.4 H33.1" />
			<circle cx="20" cy="24" r="1.15" fill="currentColor" stroke="none" />
			<circle cx="28" cy="24" r="1.15" fill="currentColor" stroke="none" />
			<circle cx="24" cy="27.6" r="1.15" fill="currentColor" stroke="none" />
			<circle cx="20" cy="30.6" r="1.15" fill="currentColor" stroke="none" />
			<circle cx="28" cy="30.6" r="1.15" fill="currentColor" stroke="none" />
		</>
	)}

	{variant === 'spool' && (
		<>
			<rect x="15.5" y="8.5" width="17" height="6" rx="2.2" />
			<rect x="15.5" y="33.5" width="17" height="6" rx="2.2" />
			<path d="M18 14.5 h12 v19 h-12 z" />
			<path d="M18 19.6 H30" opacity="0.5" />
			<path d="M18 23.9 H30" opacity="0.5" />
			<path d="M18 28.2 H30" opacity="0.5" />
			<path d="M30 21 C 38 21 40 28 33.5 30.5" opacity="0.85" />
		</>
	)}

	{variant === 'tape' && (
		<>
			<circle cx="20.5" cy="25.5" r="11.5" />
			<circle cx="20.5" cy="25.5" r="4.6" opacity="0.6" />
			<path d="M32 22.5 C 41 22.5 43.5 30 36 33.5 L 28.5 33.5" />
			<path d="M20.5 14.4 v3.2" opacity="0.5" />
			<path d="M20.5 33.4 v3.2" opacity="0.5" />
			<path d="M9.4 25.5 h3.2" opacity="0.5" />
			<path d="M28.4 25.5 h3.2" opacity="0.5" />
		</>
	)}

	{variant === 'pin' && (
		<>
			<path d="M13 35 L33.5 14.5" />
			<circle cx="36" cy="12" r="4.3" />
			<path d="M13 35 L15.6 37.6" opacity="0.45" />
		</>
	)}

	{variant === 'hook' && (
		<>
			<path d="M19 8.5 v15.5 a5.5 5.5 0 1 0 11 0 V 22" />
			<path d="M19 8.5 h6.5" />
			<path d="M33 22 L30 27 L36 27 Z" fill="currentColor" />
			<path d="M33 27 v12" opacity="0.6" />
		</>
	)}

	{variant === 'chalk' && (
		<>
			<path d="M13 35.5 L32 16.5" />
			<path d="M13 35.5 L10 38.5 L14.6 37.4 Z" />
			<path d="M32 16.5 L37.4 11.1 a3.2 3.2 0 0 1 4.6 4.6 L36.6 21" opacity="0.75" />
			<path d="M9 42 L15 42" opacity="0.35" />
		</>
	)}

	{variant === 'mannequin' && (
		<>
			{/* Tête */}
			<ellipse cx="24" cy="7.6" rx="3.4" ry="4" />
			{/* Col */}
			<path d="M22.6 11.6 L22.6 14.2 M25.4 11.6 L25.4 14.2" />
			{/* Buste */}
			<path d="M18 15.6 C15.6 17 15 20.4 15.6 23.4 C16.4 27.4 20.4 29.6 24 29.6 C27.6 29.6 31.6 27.4 32.4 23.4 C33 20.4 32.4 17 30 15.6 C27.6 14.2 20.4 14.2 18 15.6 Z" />
			{/* Taille resserrée */}
			<path d="M17.4 29.9 C19.6 31.6 28.4 31.6 30.6 29.9" opacity="0.55" />
			{/* Pied/tige */}
			<path d="M24 29.9 V38.5" />
			<circle cx="24" cy="40.8" r="2.6" />
			<path d="M18.6 44.4 H29.4" />
			{/* Repères de patronage */}
			<path d="M24 18.6 V27" stroke-dasharray="2.6 2.6" opacity="0.6" />
			<path d="M17.8 21.6 H30.2" stroke-dasharray="2.6 2.6" opacity="0.45" />
		</>
	)}

	{variant === 'yarn' && (
		<>
			<circle cx="22" cy="26" r="13" />
			<path d="M11.2 20.4 C18 24 28 32 32.6 36.4" opacity="0.5" />
			<path d="M14.6 15.2 C22 20 30.4 27 35.4 32" opacity="0.5" />
			<path d="M21.4 13.4 C28 19 33.4 24.4 35 28.6" opacity="0.5" />
			<path d="M34.4 18.6 C30.6 15.4 25.6 13.2 22 13.2" opacity="0.5" />
			<path d="M34.6 31.4 C35.6 36.6 36.4 40.4 39.6 42.4" />
			<path d="M39.6 42.4 L42.6 44.4" opacity="0.6" />
		</>
	)}

	{variant === 'zipper' && (
		<>
			{/* Rubans */}
			<rect x="18.6" y="6" width="4.6" height="36" rx="1.6" opacity="0.55" />
			<rect x="24.8" y="6" width="4.6" height="36" rx="1.6" opacity="0.55" />
			{/* Dentelure */}
			<path d="M21 8.6 h3.8 M21 12.6 h3.8 M21 16.6 h3.8 M21 20.6 h3.8 M21 24.6 h3.8 M21 28.6 h3.8 M21 32.6 h3.8 M21 36.6 h3.8" opacity="0.85" />
			{/* Curseur */}
			<path d="M19.4 30.6 L28.6 30.6 L27.4 38.2 L20.6 38.2 Z" />
			<rect x="22.6" y="38.2" width="2.8" height="4.4" rx="1.2" />
		</>
	)}

	{variant === 'ruler' && (
		<>
			<rect x="5.5" y="18.5" width="37" height="11" rx="2" />
			<path d="M11 18.5 v4.2 M16 18.5 v6.6 M21 18.5 v4.2 M26 18.5 v6.6 M31 18.5 v4.2 M36 18.5 v6.6" opacity="0.75" />
			<path d="M5.5 25 L42.5 25" opacity="0.3" />
		</>
	)}

	{variant === 'ribbon' && (
		<>
			<path d="M6 12 C14 20 20 14 24 22 C28 30 34 24 42 32" />
			<path d="M6 20 C14 28 20 22 24 30 C28 38 34 32 42 40" opacity="0.55" />
			<circle cx="24" cy="22" r="2.2" fill="currentColor" stroke="none" />
			<circle cx="24" cy="30" r="2.2" fill="currentColor" stroke="none" />
		</>
	)}
</svg>
