---
/**
 * Couture décorative : ligne de points de machine, utilisable comme séparateur
 * de section. Le tracé est un motif SVG répété (aucune image, aucun JS).
 */
interface Props {
	class?: string;
	/** Largeur des points, en px. */
	step?: number;
	/** Opacité du tracé. */
	opacity?: number;
}

const { class: className = '', step = 14, opacity = 0.4 } = Astro.props;
---

<div class={`pointer-events-none flex w-full items-center justify-center ${className}`} aria-hidden="true">
	<svg
		class="h-3 w-full"
		style={`opacity:${opacity}`}
		preserveAspectRatio="none"
		viewBox="0 0 1200 12"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-dasharray={`${step * 0.55} ${step * 0.45}`}
		focusable="false"
	>
		<path d="M0 6 H1200" />
	</svg>
</div>
