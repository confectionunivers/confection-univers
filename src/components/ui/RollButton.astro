---
/**
 * Bouton « lettres qui roulent » — signature visuelle de Noryx.
 * Au survol, le texte sort par le haut et sa copie dorée entre par le bas ;
 * la flèche avance légèrement.
 */
interface Props {
	href: string;
	label: string;
	/** `solid` = fond or, `ghost` = contour seul. */
	variant?: 'solid' | 'ghost';
	/** Affiche la flèche. */
	arrow?: boolean;
	class?: string;
}

const { href, label, variant = 'ghost', arrow = true, class: className = '' } = Astro.props;

const isSolid = variant === 'solid';
const colorClasses = isSolid
	? 'nx-btn--solid text-[#00004B]'
	: 'text-white hover:text-white';

const isExternal = /^https?:\/\//.test(href);
---

<a
	href={href}
	class:list={['nx-btn group', colorClasses, className]}
	{...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	<span class="nx-roll">
		<span class="nx-roll__face">{label}</span>
		<span class="nx-roll__ghost" aria-hidden="true">{label}</span>
	</span>
	{arrow && (
		<span class="nx-arrow" aria-hidden="true">
			<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" />
			</svg>
		</span>
	)}
</a>
