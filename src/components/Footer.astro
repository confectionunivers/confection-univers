---
import { SITE } from '../lib/seo';
import { BLOG_POSTS } from '../lib/blog-data';
import Picture from './Picture.astro';

/* Canal réel de l'atelier : les actualités partent sur WhatsApp, pas par e-mail. */
const whatsappNewsHref = `${SITE.whatsapp}?text=${encodeURIComponent(
	'Bonjour, je souhaite recevoir les actualités de Confection Univers.',
)}`;
---

<footer class="footer-gold relative overflow-hidden">
	<!-- Ourlet supérieur : pointillés réguliers, comme une couture machine -->
	<div aria-hidden="true" class="footer-stitch"></div>

	<div class="relative mx-auto max-w-7xl px-6 pb-12 pt-14 md:pt-16">
		<!-- RANGÉE 1 : logo à gauche, marque centrée, réseaux à droite -->
		<div class="grid items-center gap-8 lg:grid-cols-3">
			<div class="flex justify-center lg:justify-start">
				<a href="/" class="footer-logo-chip" aria-label="Confection Univers — accueil">
					<Picture src="/images/logo.png" alt="Confection Univers" class="h-8 w-auto" loading="lazy" />
				</a>
			</div>
			<div class="text-center">
				<p class="font-display text-3xl font-bold tracking-tight text-[#00001C]">
					Confection Univers
				</p>
				<p class="mx-auto mt-3 max-w-md text-sm font-medium italic leading-[1.7] text-[#00001C]/70">
					Habillez votre réussite
				</p>
			</div>
			<div class="flex justify-center gap-3 lg:justify-end">
				<a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="Facebook">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
				</a>
				{SITE.social.instagram && (
					<a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="Instagram">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
				)}
				<a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
				</a>
				<a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="YouTube">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505A3.015 3.015 0 0 0 24 15.814C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
				</a>
				<a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="TikTok">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
				</a>
				<a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="WhatsApp">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				</a>
			</div>
		</div>

		<!-- Couture horizontale -->
		<div aria-hidden="true" class="footer-stitch footer-stitch--inline mt-12"></div>

		<!--
			RANGÉE 2 : défilement continu des articles du blog — cartes
			rectangulaires arrondies avec l'image de chaque article. Boucle
			infinie en CSS (deux copies de la liste), pause au survol,
			défilement manuel si l'utilisateur préfère moins de mouvement.
		-->
		<div class="mt-12 text-center">
			<h4 class="footer-h">Dernières actualités</h4>
		</div>
		<div class="blog-marquee mt-6">
			<div class="blog-marquee__track">
				<ul class="flex pr-4">
					{BLOG_POSTS.map((post) => (
					<li>
						<a href={`/blog/${post.slug}`} class="blog-card">
							<Picture src={post.image} alt={post.title} class="aspect-[16/10] w-full rounded-xl object-cover" loading="lazy" />
							<span class="line-clamp-2 px-2 pb-2 pt-3 text-left text-sm font-semibold leading-snug text-[#00001C]">{post.title}</span>
						</a>
					</li>
				))}
				</ul>
				<ul aria-hidden="true" class="flex pr-4">
					{BLOG_POSTS.map((post) => (
					<li>
						<a href={`/blog/${post.slug}`} class="blog-card" tabindex="-1">
							<Picture src={post.image} alt={post.title} class="aspect-[16/10] w-full rounded-xl object-cover" loading="lazy" />
							<span class="line-clamp-2 px-2 pb-2 pt-3 text-left text-sm font-semibold leading-snug text-[#00001C]">{post.title}</span>
						</a>
					</li>
				))}
				</ul>
			</div>
		</div>

		<!-- RANGÉE 3 : panneau nuit, trois zones égales centrées -->
		<div class="mt-14 rounded-[2rem] bg-[#00001C] p-8 md:p-10">
			<div class="grid gap-10 text-center lg:grid-cols-3">
				<div>
					<h3 class="font-display text-xl font-semibold tracking-tight text-[#FACC6B]">
						Restez connecté
					</h3>
					<p class="mx-auto mt-3 max-w-xs text-sm leading-[1.7] text-foreground/70">
						Recevez nos actualités et offres exclusives directement sur WhatsApp.
					</p>
					<a href={whatsappNewsHref} target="_blank" rel="noopener noreferrer" class="footer-sub-btn mt-5">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
						Recevoir nos actualités
					</a>
				</div>
				<div>
					<h4 class="footer-h footer-h--on-night">Adresse atelier</h4>
					<p class="text-sm font-medium leading-[1.8] text-foreground/80">
						{SITE.address.street}<br />
						{SITE.address.city}<br />
						{SITE.address.countryLabel}
					</p>
				</div>
				<div>
					<h4 class="footer-h footer-h--on-night">Contactez-nous</h4>
					<div class="space-y-2">
						<a href={`mailto:${SITE.email}`} class="block text-sm font-medium text-foreground/80 transition-colors hover:text-[#FACC6B]">
							{SITE.email}
						</a>
						<a href={`tel:${SITE.phone}`} class="block text-sm font-medium text-foreground/80 transition-colors hover:text-[#FACC6B]">
							{SITE.phoneDisplay}
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- RANGÉE 4 : barre finale centrée -->
		<div class="mt-12 flex flex-col items-center gap-4 border-t border-dashed border-[#00001C]/25 pt-8 text-center">
			<p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#00001C]/60">
				© 2026 Confection Univers — Tous droits réservés.
			</p>
			<p class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-xs">
				<a href="/mentions-legales" class="font-medium text-[#00001C]/70 underline-offset-4 transition-colors hover:text-[#00001C] hover:underline">Mentions légales</a>
				<a href="/confidentialite" class="font-medium text-[#00001C]/70 underline-offset-4 transition-colors hover:text-[#00001C] hover:underline">Politique de confidentialité</a>
			</p>
			<button
				type="button"
				id="footer-scroll-top"
				class="group mt-2 inline-flex items-center gap-2 rounded-full bg-[#00001C] px-6 py-2.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#FACC6B] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#00002a]"
			>
				Retour en haut
				<span aria-hidden="true" class="transition-transform duration-300 group-hover:-translate-y-0.5">↑</span>
			</button>
		</div>
	</div>
</footer>

<script>
	// Scroll to top functionality
	document.getElementById('footer-scroll-top')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

</script>

<style>
	/* Fond : le dégradé or de la carte « L'excellence à chaque couture ». */
	.footer-gold {
		background: var(--cu-gold-grad);
	}

	/* Ourlet : pointillés réguliers, comme une couture machine. */
	.footer-stitch {
		height: 3px;
		background: repeating-linear-gradient(
			90deg,
			rgba(0, 0, 17, 0.45) 0 16px,
			transparent 16px 30px
		);
	}

	.footer-stitch--inline {
		opacity: 0.5;
	}

	.footer-h {
		margin-bottom: 1rem;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(0, 0, 17, 0.6);
	}

	.footer-h--on-night {
		color: rgba(250, 204, 107, 0.8);
	}

	.footer-link {
		font-size: 0.875rem;
		font-weight: 500;
		color: rgba(0, 0, 17, 0.8);
		text-underline-offset: 4px;
		transition: color 0.25s ease;
	}

	.footer-link:hover {
		color: #00001c;
		text-decoration: underline;
	}

	.footer-social {
		display: flex;
		height: 2.5rem;
		width: 2.5rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: #00001c;
		color: #facc6b;
		transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
	}

	.footer-social:hover {
		transform: translateY(-2px);
		background: #00002a;
		color: #ffffff;
	}

	/* Plaque blanche du logo, même recette que la navbar, en taille réduite. */
	.footer-logo-chip {
		display: inline-flex;
		align-items: center;
		padding: 6px 12px;
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.45), inset 0 -2px 0 rgba(245, 158, 11, 0.5);
	}

	.footer-logo-chip img {
		display: block;
		height: 32px;
		width: auto;
	}

	.footer-sub-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		border-radius: 9999px;
		background: var(--cu-gold-grad);
		padding: 0.75rem 1.5rem;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #00001c;
		transition: filter 0.25s ease, transform 0.25s ease;
	}

	.footer-sub-btn:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	/* Carte article : plaque blanche arrondie, image + titre. */
	.blog-card {
		display: block;
		width: 16rem;
		border-radius: 1.25rem;
		background: #ffffff;
		padding: 0.5rem;
		box-shadow: 0 10px 26px -12px rgba(0, 0, 17, 0.45);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 34px -12px rgba(0, 0, 17, 0.55);
	}

	/* Défilement continu : deux copies de la liste, translation de -50 %. */
	.blog-marquee {
		overflow: hidden;
	}

	.blog-marquee__track {
		display: flex;
		width: max-content;
		animation: blog-scroll 70s linear infinite;
	}

	.blog-marquee:hover .blog-marquee__track {
		animation-play-state: paused;
	}

	@keyframes blog-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-social,
		.footer-sub-btn,
		#footer-scroll-top,
		.blog-card {
			transition: none;
		}

		.blog-marquee {
			overflow-x: auto;
		}

		.blog-marquee__track {
			animation: none;
		}
	}
</style>
