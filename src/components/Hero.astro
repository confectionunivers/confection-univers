---
import SewingDecor from './decor/SewingDecor.astro';
import StitchLine from './decor/StitchLine.astro';
import MarqueeBand from './ui/MarqueeBand.astro';
import RollButton from './ui/RollButton.astro';
/**
 * Visuels hero : traités par le pipeline Astro (`astro:assets`).
 * -> WebP + srcset responsive + width/height corrects (pas de CLS).
 * Pour changer un visuel, remplacez le fichier dans src/assets/hero/.
 */
import { Image } from 'astro:assets';
import heroToges from '../assets/hero/hero-toges-graduation.jpg';
import heroUniformes from '../assets/hero/hero-uniformes.jpg';
import heroTenues from '../assets/hero/hero-tenues-travail-sport.jpg';

/** Raccourcis vers les collections (liens internes = maillage SEO). */
const gammes = [
	{ label: 'Uniformes scolaires', href: '/collections/uniformes-scolaires' },
	{ label: 'Tenues de travail', href: '/collections/tenue-travail' },
	{ label: 'Tenues médicales', href: '/collections/tenues-medicales' },
	{ label: 'Toges de graduation', href: '/collections/toges-graduation' },
];
---

<section
	id="hero"
	class="hero-section nx-grain relative flex min-h-screen flex-col justify-center overflow-hidden pb-0 pt-24 border-0 outline-none mb-[-1px] md:pt-28"
	aria-label="Accueil"
	lang="fr"
	style="border: none !important; outline: none !important; box-shadow: none !important; background: linear-gradient(135deg, #000025 0%, #00004A 42%, #00004B 70%, #000013 100%);"
>
	<!-- Grain -->
	<div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

	<!-- Halos -->
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<div class="hero-glow absolute left-[2%] top-[8%] h-[480px] w-[480px] rounded-full bg-primary/20 blur-[100px]"></div>
		<div class="hero-glow absolute right-[4%] top-[28%] h-[460px] w-[520px] rounded-full bg-primary-light/15 blur-[90px]"></div>
	</div>

	<div class="hero-content-wrap w-full px-6 lg:px-[4%]">
		<div class="hero-content relative mx-auto grid w-full max-w-[1400px] items-center gap-14 lg:px-8 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] xl:gap-20">
			<!-- ============ Colonne texte ============ -->
			<div class="hero-text-block flex flex-col justify-center lg:w-full">
				<!-- Badge de lieu, comme Noryx -->
				<div id="hero-subtitle" class="mb-7 flex flex-wrap items-center gap-3">
					<span class="nx-badge">
						<span class="h-1.5 w-1.5 rounded-full bg-[#F5B544]"></span>
						Confection industrielle · Thiès, Sénégal
					</span>
				</div>

				<h1 id="hero-title" class="nx-display nx-display--xl text-white">
					<span class="hero-headline block text-white">Des uniformes</span>
					<span class="hero-headline animated-gradient-text mt-1 block">pour vos équipes</span>
				</h1>

				<p
					id="hero-description"
					class="mt-8 max-w-xl text-base font-normal leading-[1.65] text-foreground/75 md:text-lg"
				>
					Production en série pour les entreprises, les écoles et les institutions :
					du choix du modèle et des tissus jusqu’à la livraison de vos commandes.
				</p>

				<!-- Boutons à lettres roulantes -->
				<div class="hero-reveal mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
					<RollButton href="/contact" label="Demander un devis" variant="solid" />
					<RollButton href="/catalogue" label="Voir nos produits" />
				</div>

				<!-- Bloc de chiffres, comme la note de Noryx -->
				<div class="hero-reveal mt-12 flex flex-wrap items-center gap-x-10 gap-y-6 border-t border-white/10 pt-8">
					<div>
						<div class="nx-stat__value text-white">8</div>
						<p class="nx-stat__label text-[#A0ACC6]">gammes de confection</p>
					</div>
					<div class="h-12 w-px bg-white/10"></div>
					<div>
						<div class="nx-stat__value text-white">100<span class="text-primary">%</span></div>
						<p class="nx-stat__label text-[#A0ACC6]">pièces contrôlées</p>
					</div>
					<div class="h-12 w-px bg-white/10"></div>
					<div>
						<div class="nx-stat__value text-white">Thiès</div>
						<p class="nx-stat__label text-[#A0ACC6]">atelier au Sénégal</p>
					</div>
				</div>

				<!-- Raccourcis vers les gammes -->
				<nav class="hero-reveal relative mt-12" aria-label="Nos gammes">
					<ul class="flex flex-wrap items-center gap-2.5">
						{gammes.map((gamme) => (
							<li>
								<a
									href={gamme.href}
									class="hero-gamme-chip inline-flex items-center rounded-full border border-[rgba(250,204,107,0.2)] bg-[rgba(0,0,0,0.25)] px-3.5 py-1.5 text-[13px] font-medium text-foreground/70"
								>
									{gamme.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<!-- ============ Colonne visuelle (inchangée : mêmes photos) ============ -->
			<div id="hero-images" class="relative w-full lg:w-full">
				<div
					class="hero-3d-container grid min-h-[320px] grid-cols-[1.1fr_0.9fr] grid-rows-2 gap-3 sm:min-h-[420px] sm:gap-5 md:min-h-[min(650px,75vh)] md:gap-6 perspective-1000"
				>
					<!-- Visuel principal -->
					<figure
						class="hero-figure-3d group relative col-span-1 row-span-2 overflow-hidden rounded-[1.75rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-[400px] transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
					>
						<Image
							src={heroToges}
							alt="Toge de graduation confectionnée par Confection Univers"
							class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
							widths={[500, 700, 900, 1200]}
							sizes="(max-width: 767px) 50vw, (max-width: 1279px) 50vw, 300px"
							format="webp"
							quality={78}
							loading="eager"
							decoding="async"
							fetchpriority="high"
						/>
						<div class="hero-image-shade pointer-events-none absolute inset-0 bg-gradient-to-t from-background/50 via-transparent to-transparent md:opacity-100"></div>
						<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
					</figure>

					<!-- Visuel secondaire 1 -->
					<figure
						class="hero-figure-3d group relative overflow-hidden rounded-[1.75rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-0 transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
					>
						<Image
							src={heroUniformes}
							alt="Uniformes scolaires confectionnés en série"
							class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
							widths={[400, 600, 800, 1000]}
							sizes="(max-width: 767px) 44vw, (max-width: 1279px) 44vw, 280px"
							format="webp"
							quality={78}
							loading="eager"
							decoding="async"
						/>
						<div class="hero-image-shade pointer-events-none absolute inset-0 bg-gradient-to-br from-background/20 to-transparent"></div>
						<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
					</figure>

					<!-- Visuel secondaire 2 -->
					<figure
						class="hero-figure-3d group relative overflow-hidden rounded-[1.75rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-0 transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
					>
						<Image
							src={heroTenues}
							alt="Tenues de travail et de sport coordonnées"
							class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
							widths={[400, 600, 800, 1000]}
							sizes="(max-width: 767px) 44vw, (max-width: 1279px) 44vw, 280px"
							format="webp"
							quality={78}
							loading="eager"
							decoding="async"
						/>
						<div class="hero-image-shade pointer-events-none absolute inset-0 bg-gradient-to-tl from-background/25 to-transparent"></div>
						<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
					</figure>
				</div>
			</div>
		</div>
	</div>

	<!-- Bandeau défilant, signature Noryx, en bas du hero -->
	<MarqueeBand
		class="relative z-10 mt-16 border-t border-white/10 pt-8"
		tone="dark"
		duration={18}
		words={['Uniformes scolaires', 'Toges', 'Tenues de travail', 'Blouses', 'Sport', 'Kimonos']}
		accent={2}
	/>

	<!-- Décors de couture -->
	<SewingDecor variant="mannequin" class="pointer-events-none absolute left-3 top-[30%] hidden h-28 w-28 text-[#F5B544] opacity-[0.14] xl:block" />
	<SewingDecor variant="scissors" class="pointer-events-none absolute right-4 top-[62%] hidden h-20 w-20 rotate-[24deg] text-[#F5B544] opacity-[0.13] xl:block" />
	<SewingDecor variant="yarn" class="pointer-events-none absolute -bottom-8 left-[38%] hidden h-20 w-20 text-[#F5B544] opacity-[0.13] lg:block" />
	<SewingDecor variant="needle" class="pointer-events-none absolute -bottom-6 -left-2 hidden h-24 w-24 rotate-[12deg] text-[#F5B544] opacity-[0.10] lg:block" />
	<SewingDecor variant="button" class="pointer-events-none absolute -bottom-7 right-8 hidden h-16 w-16 text-[#F5B544] opacity-[0.10] lg:block" />
	<StitchLine class="pointer-events-none absolute inset-x-8 bottom-2 text-[#F5B544]" step={18} opacity={0.15} />
</section>

<script>
	import gsap from 'gsap';
	import { prefersReducedMotion } from '../lib/animations';

	const heroFrames = Array.from(document.querySelectorAll<HTMLElement>('.hero-figure-3d'));

	if (!prefersReducedMotion()) {
		const entrance = gsap.timeline({
			defaults: { ease: 'power3.out' },
			onComplete: () => gsap.set(heroFrames, { clearProps: 'transform,opacity,visibility' }),
		});
		// #hero-subtitle est maintenant le 1er <span> du <h1> : on l'exclut de la
		// séquence du titre pour éviter qu'il soit animé deux fois.
		entrance
			.fromTo('#hero-subtitle', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.7 })
			.fromTo('#hero-title span:not(#hero-subtitle)', { autoAlpha: 0, y: 28, rotateX: -8, transformOrigin: '50% 100%' }, { autoAlpha: 1, y: 0, rotateX: 0, stagger: 0.11, duration: 0.78 }, '-=0.42')
			.fromTo('#hero-description', { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.65 }, '-=0.42')
			.fromTo('.hero-reveal', { autoAlpha: 0, y: 15 }, { autoAlpha: 1, y: 0, stagger: 0.14, duration: 0.62 }, '-=0.32')
			.fromTo(heroFrames, { autoAlpha: 0, y: 26, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, stagger: 0.13, duration: 0.95 }, '-=0.72');
	}
</script>

<style>
	.animated-gradient-text {
		background: linear-gradient(135deg, #FACC6B 0%, #F59E0B 50%, #D97706 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-section {
		border: none !important;
		outline: none !important;
	}

	.perspective-1000 {
		perspective: 1000px;
	}

	.transform-style-3d {
		transform-style: preserve-3d;
	}

	.cta-button-primary {
		position: relative;
		overflow: hidden;
		box-shadow: 0 8px 32px -8px rgba(198, 161, 95, 0.35);
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.cta-button-primary:hover {
		box-shadow: 0 12px 34px -8px rgba(198, 161, 95, 0.45);
		transform: translateY(-2px);
	}

	.cta-button-secondary {
		transition: background-color 180ms ease, border-color 180ms ease;
	}

	.cta-button-glow {
		pointer-events: none;
	}

	/* Raccourcis vers les gammes */
	.hero-gamme-chip {
		transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
	}

	.hero-gamme-chip:hover {
		border-color: rgba(250, 204, 107, 0.55);
		background-color: rgba(0, 0, 0, 0.45);
		color: #facc6b;
	}

	/*
	 * Les halos flous sont des calques de compositing coûteux : on les
	 * allège franchement sur petit écran plutôt que de les empiler.
	 */
	@media (max-width: 767px) {
		.hero-glow {
			filter: blur(60px);
			opacity: 0.55;
		}
	}

	.hero-text-block {
		perspective: 900px;
		transform-style: preserve-3d;
		/* Référence pour les unités `cqw` du titre ci-dessous. */
		container-type: inline-size;
	}

	/*
	 * Le titre se dimensionne sur la LARGEUR DE SA COLONNE (cqw), pas sur
	 * celle de la fenêtre (vw). C'est ce qui corrige la casse en 3 lignes :
	 * avec `vw`, le titre grossissait avec l'écran alors que sa colonne,
	 * elle, restait bloquée par le `max-width` du conteneur.
	 * 11cqw laisse ~30% de marge sur la ligne la plus longue, donc le
	 * `nowrap` ne peut pas déborder quelle que soit la police chargée.
	 */
	.hero-headline {
		/*
		 * Borne basse à 2rem (et non 2.5rem) : c'est ce qui permet à
		 * « pour vos équipes » de tenir sur UNE ligne jusqu'à 320px de large.
		 * On perd 2-3px de corps sur mobile, on gagne un titre sur 2 lignes
		 * propres au lieu de 3.
		 */
		font-size: clamp(2rem, 11cqw, 3.75rem);
	}

	@media (min-width: 1024px) {
		.hero-headline {
			white-space: nowrap;
		}
	}

	.hero-3d-container {
		perspective: 1500px;
		transform-style: preserve-3d;
	}

	.hero-figure-3d {
		isolation: isolate;
		border-color: rgba(250, 204, 107, 0.42);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 0 0 0 1px rgba(245, 181, 68, 0.1), 0 3px 0 rgba(161, 98, 7, 0.42), 0 24px 60px rgba(0, 0, 0, 0.6);
		transform-style: preserve-3d;
		backface-visibility: hidden;
		transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 280ms ease, box-shadow 350ms ease;
	}

	.hero-figure-3d::before {
		position: absolute;
		inset: 8px;
		z-index: 4;
		border: 1px solid rgba(250, 204, 107, 0.27);
		border-radius: 1.05rem;
		content: '';
		pointer-events: none;
	}

	.hero-figure-3d::after {
		position: absolute;
		inset: 1px 13% auto;
		z-index: 4;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 239, 190, 0.72), transparent);
		content: '';
		pointer-events: none;
	}

	.hero-figure-3d:nth-of-type(1) { transform: rotateY(-1.4deg) rotateX(0.5deg) translateZ(5px); }
	.hero-figure-3d:nth-of-type(2) { transform: rotateY(1.8deg) rotateX(-0.5deg) translateZ(2px); }
	.hero-figure-3d:nth-of-type(3) { transform: rotateY(1.2deg) rotateX(0.7deg) translateZ(4px); }

	.hero-figure-3d .hero-img-3d {
		transition: opacity 320ms ease, filter 320ms ease, transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.hero-image-shade { z-index: 2; }



	.hero-figure-3d:hover {
		border-color: rgba(250, 204, 107, 0.78);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(245, 181, 68, 0.2), 0 4px 0 rgba(161, 98, 7, 0.35), 0 34px 72px rgba(0, 0, 0, 0.66), 0 0 24px rgba(245, 181, 68, 0.1);
		transform: perspective(1200px) translateY(-5px) translateZ(18px) rotateX(0) rotateY(0);
	}

	.hero-figure-3d:hover .hero-img-3d { transform: scale(1.035); }

	.whatsapp-float:hover {
		transform: scale(1.06);
	}



	@media (prefers-reduced-motion: reduce) {
		.hero-reveal {
			opacity: 1;
			animation: none;
		}

		.hero-figure-3d,
		.hero-figure-3d .hero-img-3d,
		.cta-button-primary,
		.cta-button-secondary,
		.whatsapp-float {
			transition: none;
			animation: none;
		}
	}

	@media (hover: none) {
		.hero-figure-3d:hover,
		.hero-figure-3d:hover .hero-img-3d {
			transform: none;
		}
	}
</style>
