---
/**
 * Visuels hero : traités par le pipeline Astro (`astro:assets`).
 * -> WebP + srcset responsive + width/height corrects (pas de CLS).
 * Pour changer un visuel, remplacez le fichier dans src/assets/hero/.
 */
import { Image } from 'astro:assets';
import heroToges from '../assets/hero/hero-toges-graduation.jpg';
import heroUniformes from '../assets/hero/hero-uniformes.jpg';
import heroTenues from '../assets/hero/hero-tenues-travail-sport.jpg';

/** Raccourcis vers les collections (liens internes = maillage SEO). */
const gammes = [
	{ label: 'Uniformes scolaires', href: '/collections/uniformes-scolaires' },
	{ label: 'Tenues de travail', href: '/collections/tenue-travail' },
	{ label: 'Tenues médicales', href: '/collections/tenues-medicales' },
	{ label: 'Toges de graduation', href: '/collections/toges-graduation' },
];
---

<section
	id="hero"
	class="hero-section relative flex min-h-screen flex-col justify-center overflow-hidden pb-0 pt-20 md:pt-24 border-0 outline-none mb-[-1px]"
	aria-label="Accueil"
	lang="fr"
	style="border: none !important; outline: none !important; box-shadow: none !important; background: linear-gradient(135deg, #050816 0%, #0b1024 60%, #020617 100%);"
>
	<!-- Grain Texture Overlay -->
	<div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
	
	<!--
		Halos d'ambiance.
		Perf : 2 calques flous au lieu de 4 (chaque blur = une couche de compositing
		coûteuse sur mobile). Le dégradé de maille, lui, ne coûte rien.
	-->
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
		<!-- Halo principal, derrière le bloc de texte -->
		<div class="hero-glow absolute left-[2%] top-[8%] h-[480px] w-[480px] rounded-full bg-primary/20 blur-[100px]"></div>
		<!-- Halo chaud, derrière les visuels -->
		<div class="hero-glow absolute right-[4%] top-[28%] h-[460px] w-[520px] rounded-full bg-primary-light/15 blur-[90px]"></div>
		<!-- Dégradé de maille (aucun coût de rendu) -->
		<div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-primary-light/5"></div>
	</div>



	<!-- Indicateur de défilement -->
	<div class="absolute bottom-24 left-1/2 -translate-x-1/2 z-10 pointer-events-none">
		<div class="scroll-down-indicator flex flex-col items-center gap-2">
			<span class="text-primary/60 text-xs uppercase tracking-widest">Défiler</span>
			<div class="scroll-chevron h-6 w-6 text-primary/60">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
				</svg>
			</div>
		</div>
	</div>

	<!-- WhatsApp Floating Button -->
	<a
		href="https://wa.me/221772960776"
		target="_blank"
		rel="noopener noreferrer"
		class="whatsapp-float fixed bottom-8 right-8 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] rounded-full shadow-lg hover:shadow-xl transition-all duration-300 group transform-gpu will-change-transform"
		aria-label="Contactez-nous sur WhatsApp"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
			<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
		</svg>
	</a>
	
	<!--
		Main Content
		Alignement : la navbar utilise `padding: 20px 4%` + une pilule
		`max-width:1400px` avec `padding: 16px 32px`. On reproduit exactement
		la même gouttière ici pour que le titre s'aligne sur le logo.
		Mobile : on retombe sur une simple marge de 24px.
	-->
	<div class="hero-content-wrap w-full px-6 lg:px-[4%]">
	<!--
		La bascule 2 colonnes se fait à `xl` (1280px) et non `lg` (1024px) :
		entre les deux, la colonne de texte ne ferait que 448px, ce qui
		réempilerait les deux CTA (499px à eux deux). Sur tablette on garde
		donc une colonne pleine largeur, bien plus confortable.
	-->
	<div
		class="hero-content mx-auto grid w-full max-w-[1400px] items-center gap-12 lg:px-8 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] xl:gap-20 relative"
	>
		<!-- Left Column: Text Content -->
		<div class="hero-text-block flex flex-col justify-center lg:w-full">
			<!--
				Le sur-titre est désormais la 1re ligne du <h1> : visuellement
				identique, mais « Thiès, Sénégal » entre dans le titre principal
				(le signal SEO le plus fort de la page). Zéro coût de design.
			-->
			<h1 id="hero-title" class="font-display tracking-tight">
				<span
					id="hero-subtitle"
					class="mb-5 block text-[11px] font-semibold uppercase tracking-[0.2em] text-[rgba(250,204,107,0.85)] md:text-xs"
				>
					Confection industrielle · Thiès, Sénégal
				</span>
				<span class="hero-headline block font-semibold leading-[1.05] text-[#F9FAFB] md:leading-[1.02]">
					Des uniformes
				</span>
				<span class="hero-headline animated-gradient-text mt-1 block font-bold leading-[1.05] md:leading-[1.02]">
					pour vos équipes
				</span>
			</h1>

			<p
				id="hero-description"
				class="mt-8 max-w-xl text-base font-normal leading-[1.6] text-foreground/80 md:text-lg md:leading-[1.7]"
			>
				Production en série pour les entreprises, les écoles et les institutions :
				du choix du modèle et des tissus jusqu’à la livraison de vos commandes.
			</p>

			<div class="hero-reveal mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center" style="--hero-d: 240ms">
				<a
					href="/contact"
					class="cta-button-primary group relative inline-flex min-h-[3.25rem] items-center justify-center overflow-hidden rounded-full px-8 py-3.5 text-center text-[13px] font-semibold uppercase tracking-[0.18em] text-background transition-all duration-500 transform-gpu will-change-transform"
					style="background: linear-gradient(135deg, #FACC6B 0%, #F59E0B 50%, #D97706 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,0.15), 0 18px 40px rgba(0, 0, 0, 0.50); border: 1px solid rgba(161, 98, 7, 0.7);"
				>
					<span class="relative z-10 transition-transform duration-300 transform-gpu will-change-transform">Demander un devis</span>
					<span class="cta-button-glow absolute inset-0 rounded-full border-2 border-primary/0 transition-all duration-500 group-hover:border-primary/50 group-hover:shadow-[0_0_30px_rgba(198,161,95,0.4)]"></span>
				</a>
				<a
					href="/catalogue"
					class="cta-button-secondary group relative inline-flex min-h-[3.25rem] items-center justify-center rounded-full border-2 border-[rgba(250,204,107,0.3)] bg-[rgba(0,0,0,0.3)] px-8 py-3.5 text-center text-[13px] font-semibold uppercase tracking-[0.18em] text-[#F9FAFB] transition-all duration-400 hover:bg-[rgba(0,0,0,0.5)] hover:border-[rgba(250,204,107,0.5)] transform-gpu will-change-transform"
				>
					<span class="relative z-10 transition-all duration-300 transform-gpu will-change-transform">Voir nos produits</span>
					<span class="cta-button-glow absolute inset-0 rounded-full border-2 border-primary/0 transition-all duration-400 group-hover:border-primary group-hover:shadow-[0_0_20px_rgba(198,161,95,0.3)]"></span>
				</a>
			</div>

			<!--
				Avant : « Séries pour équipes · Répartition des tailles · Options
				étudiées » — trois formules vagues, non cliquables.
				Après : les gammes réelles, en liens internes vers les collections.
				L'acheteur sait en 2 secondes s'il est au bon endroit.
			-->
			<nav
				class="hero-reveal relative mt-14 pt-10"
				style="--hero-d: 320ms"
				aria-label="Nos gammes"
			>
				<div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-[rgba(148,163,184,0.25)] to-transparent"></div>
				<ul class="flex flex-wrap items-center gap-2.5">
					{gammes.map((gamme) => (
						<li>
							<a
								href={gamme.href}
								class="hero-gamme-chip inline-flex items-center rounded-full border border-[rgba(250,204,107,0.2)] bg-[rgba(0,0,0,0.25)] px-3.5 py-1.5 text-[13px] font-medium text-foreground/70"
							>
								{gamme.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<!-- Visuels des gammes -->
		<div
			id="hero-images"
			class="relative w-full lg:w-full"
		>
			<!--
				La mosaïque est en 2 colonnes DÈS le mobile. Auparavant elle
				passait en pile verticale sous 768px : trois visuels portrait
				empilés, soit ~1500px de hauteur à faire défiler avant d'arriver
				au moindre contenu. Rédhibitoire sur mobile.
			-->
			<div
				class="hero-3d-container grid min-h-[320px] grid-cols-[1.1fr_0.9fr] grid-rows-2 gap-3 sm:min-h-[420px] sm:gap-5 md:min-h-[min(650px,75vh)] md:gap-6 perspective-1000"
			>
				<!-- Main Card (Larger - Graduation) -->
				<figure
					class="hero-figure-3d group relative col-span-1 row-span-2 overflow-hidden rounded-[1.5rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-[400px] transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
				>
					<Image
						src={heroToges}
						alt="Toge de graduation confectionnée par Confection Univers"
						class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
						widths={[400, 600, 736]}
						sizes="(max-width: 767px) 50vw, (max-width: 1279px) 50vw, 300px"
						format="webp"
						quality={78}
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
					<div
						class="hero-image-shade pointer-events-none absolute inset-0 bg-gradient-to-t from-background/50 via-transparent to-transparent md:opacity-100"
					></div>
					<!-- 3D Lighting Overlay -->
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
				</figure>

				<!-- Secondary Card 1 (Smaller - Uniformes) -->
				<figure
					class="hero-figure-3d group relative overflow-hidden rounded-[1.5rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-0 transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
				>
					<Image
						src={heroUniformes}
						alt="Tenue de ville sur mesure pour entreprise"
						class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
						widths={[300, 500, 700]}
						sizes="(max-width: 767px) 42vw, (max-width: 1279px) 41vw, 245px"
						format="webp"
						quality={78}
						loading="eager"
						decoding="async"
					/>
					<div class="hero-image-shade pointer-events-none absolute inset-0 bg-gradient-to-br from-background/20 to-transparent"></div>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
				</figure>

				<!-- Secondary Card 2 (Smaller - Tenues) -->
				<figure
					class="hero-figure-3d group relative overflow-hidden rounded-[1.5rem] border border-[rgba(250,204,107,0.25)] shadow-[0_24px_60px_rgba(0,0,0,0.60)] md:min-h-0 transform-style-3d transform-gpu will-change-transform transition-all duration-200 ease hover:shadow-2xl"
				>
					<Image
						src={heroTenues}
						alt="Tenue de cérémonie et toge de graduation"
						class="hero-img-3d h-full w-full object-cover transform-gpu will-change-transform transition-transform duration-[1.1s] ease-out"
						widths={[300, 500, 700]}
						sizes="(max-width: 767px) 42vw, (max-width: 1279px) 41vw, 245px"
						format="webp"
						quality={78}
						loading="eager"
						decoding="async"
					/>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-tl from-background/25 to-transparent"></div>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
				</figure>
			</div>

			<!-- Decorative Circle -->
			<div
				class="pointer-events-none absolute -right-4 top-1/2 hidden h-48 w-48 -translate-y-1/2 rounded-full border border-primary/10 lg:block xl:-right-8"
				aria-hidden="true"
			></div>
		</div>
	</div>
	</div>
</section>

<script>
	import gsap from 'gsap';
	import { prefersReducedMotion } from '../lib/animations';

	const heroFrames = Array.from(document.querySelectorAll<HTMLElement>('.hero-figure-3d'));

	if (!prefersReducedMotion()) {
		const entrance = gsap.timeline({
			defaults: { ease: 'power3.out' },
			onComplete: () => gsap.set(heroFrames, { clearProps: 'transform,opacity,visibility' }),
		});
		// #hero-subtitle est maintenant le 1er <span> du <h1> : on l'exclut de la
		// séquence du titre pour éviter qu'il soit animé deux fois.
		entrance
			.fromTo('#hero-subtitle', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.7 })
			.fromTo('#hero-title span:not(#hero-subtitle)', { autoAlpha: 0, y: 28, rotateX: -8, transformOrigin: '50% 100%' }, { autoAlpha: 1, y: 0, rotateX: 0, stagger: 0.11, duration: 0.78 }, '-=0.42')
			.fromTo('#hero-description', { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.65 }, '-=0.42')
			.fromTo('.hero-reveal', { autoAlpha: 0, y: 15 }, { autoAlpha: 1, y: 0, stagger: 0.14, duration: 0.62 }, '-=0.32')
			.fromTo(heroFrames, { autoAlpha: 0, y: 26, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, stagger: 0.13, duration: 0.95 }, '-=0.72');
	}
</script>

<style>
	.animated-gradient-text {
		background: linear-gradient(135deg, #FACC6B 0%, #F59E0B 50%, #D97706 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-section {
		border: none !important;
		outline: none !important;
	}

	.perspective-1000 {
		perspective: 1000px;
	}

	.transform-style-3d {
		transform-style: preserve-3d;
	}

	.cta-button-primary {
		position: relative;
		overflow: hidden;
		box-shadow: 0 8px 32px -8px rgba(198, 161, 95, 0.35);
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.cta-button-primary:hover {
		box-shadow: 0 12px 34px -8px rgba(198, 161, 95, 0.45);
		transform: translateY(-2px);
	}

	.cta-button-secondary {
		transition: background-color 180ms ease, border-color 180ms ease;
	}

	.cta-button-glow {
		pointer-events: none;
	}

	/* Raccourcis vers les gammes */
	.hero-gamme-chip {
		transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
	}

	.hero-gamme-chip:hover {
		border-color: rgba(250, 204, 107, 0.55);
		background-color: rgba(0, 0, 0, 0.45);
		color: #facc6b;
	}

	/*
	 * Les halos flous sont des calques de compositing coûteux : on les
	 * allège franchement sur petit écran plutôt que de les empiler.
	 */
	@media (max-width: 767px) {
		.hero-glow {
			filter: blur(60px);
			opacity: 0.55;
		}
	}

	.hero-text-block {
		perspective: 900px;
		transform-style: preserve-3d;
		/* Référence pour les unités `cqw` du titre ci-dessous. */
		container-type: inline-size;
	}

	/*
	 * Le titre se dimensionne sur la LARGEUR DE SA COLONNE (cqw), pas sur
	 * celle de la fenêtre (vw). C'est ce qui corrige la casse en 3 lignes :
	 * avec `vw`, le titre grossissait avec l'écran alors que sa colonne,
	 * elle, restait bloquée par le `max-width` du conteneur.
	 * 11cqw laisse ~30% de marge sur la ligne la plus longue, donc le
	 * `nowrap` ne peut pas déborder quelle que soit la police chargée.
	 */
	.hero-headline {
		/*
		 * Borne basse à 2rem (et non 2.5rem) : c'est ce qui permet à
		 * « pour vos équipes » de tenir sur UNE ligne jusqu'à 320px de large.
		 * On perd 2-3px de corps sur mobile, on gagne un titre sur 2 lignes
		 * propres au lieu de 3.
		 */
		font-size: clamp(2rem, 11cqw, 3.75rem);
	}

	@media (min-width: 1024px) {
		.hero-headline {
			white-space: nowrap;
		}
	}

	.hero-3d-container {
		perspective: 1500px;
		transform-style: preserve-3d;
	}

	.hero-figure-3d {
		isolation: isolate;
		border-color: rgba(250, 204, 107, 0.42);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 0 0 0 1px rgba(245, 181, 68, 0.1), 0 3px 0 rgba(161, 98, 7, 0.42), 0 24px 60px rgba(0, 0, 0, 0.6);
		transform-style: preserve-3d;
		backface-visibility: hidden;
		transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 280ms ease, box-shadow 350ms ease;
	}

	.hero-figure-3d::before {
		position: absolute;
		inset: 8px;
		z-index: 4;
		border: 1px solid rgba(250, 204, 107, 0.27);
		border-radius: 1.05rem;
		content: '';
		pointer-events: none;
	}

	.hero-figure-3d::after {
		position: absolute;
		inset: 1px 13% auto;
		z-index: 4;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 239, 190, 0.72), transparent);
		content: '';
		pointer-events: none;
	}

	.hero-figure-3d:nth-of-type(1) { transform: rotateY(-1.4deg) rotateX(0.5deg) translateZ(5px); }
	.hero-figure-3d:nth-of-type(2) { transform: rotateY(1.8deg) rotateX(-0.5deg) translateZ(2px); }
	.hero-figure-3d:nth-of-type(3) { transform: rotateY(1.2deg) rotateX(0.7deg) translateZ(4px); }

	.hero-figure-3d .hero-img-3d {
		transition: opacity 320ms ease, filter 320ms ease, transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.hero-image-shade { z-index: 2; }



	.hero-figure-3d:hover {
		border-color: rgba(250, 204, 107, 0.78);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(245, 181, 68, 0.2), 0 4px 0 rgba(161, 98, 7, 0.35), 0 34px 72px rgba(0, 0, 0, 0.66), 0 0 24px rgba(245, 181, 68, 0.1);
		transform: perspective(1200px) translateY(-5px) translateZ(18px) rotateX(0) rotateY(0);
	}

	.hero-figure-3d:hover .hero-img-3d { transform: scale(1.035); }

	.whatsapp-float:hover {
		transform: scale(1.06);
	}



	@media (prefers-reduced-motion: reduce) {
		.hero-reveal {
			opacity: 1;
			animation: none;
		}

		.hero-figure-3d,
		.hero-figure-3d .hero-img-3d,
		.cta-button-primary,
		.cta-button-secondary,
		.whatsapp-float {
			transition: none;
			animation: none;
		}
	}

	@media (hover: none) {
		.hero-figure-3d:hover,
		.hero-figure-3d:hover .hero-img-3d {
			transform: none;
		}
	}
</style>
