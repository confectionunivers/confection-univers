---
const technicalDetails = [
	{ label: 'TISSU', text: 'Tissu résistant et confortable', note: 'Adapté à un usage quotidien.', side: 'left' },
	{ label: 'COL', text: 'Coupe structurée', note: 'Finition élégante.', side: 'left' },
	{ label: 'DÉTAILS', text: 'Coutures renforcées', note: 'Finitions soignées.', side: 'left' },
	{ label: 'ÉCUSSON', text: 'Broderie personnalisée', note: "Logo de l'établissement.", side: 'right' },
	{ label: 'PANTALON', text: 'Coupe nette', note: 'Aisance au quotidien.', side: 'right' },
	{ label: 'FINITION', text: 'Contrôle qualité', note: 'Détails réalisés avec précision.', side: 'right' },
];
---

<section id="hero" class="cu-hero" aria-labelledby="hero-title" lang="fr">
	<div class="cu-hero__atmosphere" aria-hidden="true"></div>

	<div class="cu-hero__grid">
		<div class="cu-hero__copy">
			<div class="cu-hero__kicker hero-reveal hero-reveal--1">Confectionnement industriel</div>

			<h1 id="hero-title" class="cu-hero__title hero-reveal hero-reveal--2">
				Nous donnons forme<br />
				<span>à vos exigences.</span>
			</h1>

			<p class="cu-hero__description hero-reveal hero-reveal--3">
				Uniformes, vêtements professionnels et tenues personnalisées, conçus pour répondre aux exigences des entreprises, écoles et institutions.
			</p>

			<div class="cu-hero__actions hero-reveal hero-reveal--4">
				<a class="cu-hero__primary" href="/contact">Demander un devis <span aria-hidden="true">→</span></a>
				<a class="cu-hero__secondary" href="/projects">Découvrir nos réalisations <span aria-hidden="true">↗</span></a>
			</div>

			<div class="cu-hero__proof hero-reveal hero-reveal--5" aria-label="Nos engagements">
				<span>Qualité maîtrisée</span>
				<span>Production en volume</span>
				<span>Personnalisation</span>
			</div>
		</div>

		<div class="cu-hero__stage hero-reveal hero-reveal--stage" aria-label="Uniforme scolaire premium présenté en showroom">
			<div class="cu-hero__product-media">
				<div class="cu-hero__product-light" aria-hidden="true"></div>
				<div class="cu-hero__product-podium" aria-hidden="true"></div>
				<img
					class="cu-hero__product-image"
					src="/images/hero-showroom-mannequin-cutout.png"
					alt="Mannequin doré portant une tenue institutionnelle beige et bleu nuit, présenté sur un podium ivoire"
					width="225"
					height="691"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</div>

			<div class="cu-hero__annotations" aria-label="Détails de confection">
				{technicalDetails.map((detail, index) => (
					<div class:list={["cu-callout", `cu-callout--${detail.side}`, `cu-callout--${index + 1}`]}>
						<span class="cu-callout__label">{detail.label}</span>
						<strong>{detail.text}</strong>
						<small>{detail.note}</small>
					</div>
				))}
			</div>
		</div>

		<aside class="cu-hero__solutions hero-reveal hero-reveal--6" aria-label="Nos solutions">
			<p class="cu-hero__solutions-label">Nos solutions</p>
			<ul>
				<li>Uniformes scolaires</li>
				<li>Vêtements professionnels</li>
				<li>Tenues personnalisées</li>
				<li>Production en série</li>
			</ul>
			<p class="cu-hero__solutions-note">Du prototype à la production.</p>
		</aside>
	</div>

	<div class="cu-hero__scroll" aria-hidden="true">
		<span>Défiler</span><i></i>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>('#hero');
	const product = document.querySelector<HTMLElement>('.cu-hero__product-image');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (hero && product && !reduceMotion) {
		let frame = 0;
		const updateParallax = () => {
			frame = 0;
			const bounds = hero.getBoundingClientRect();
			const offset = Math.max(-18, Math.min(18, (window.innerHeight / 2 - (bounds.top + bounds.height / 2)) * 0.045));
			product.style.transform = `translate3d(0, ${offset}px, 0)`;
		};

		window.addEventListener('scroll', () => {
			if (!frame) frame = window.requestAnimationFrame(updateParallax);
		}, { passive: true });
		updateParallax();
	}
</script>

<style>
	.cu-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding: 112px 28px 38px;
		overflow: hidden;
		background: #081524;
		color: #f6f3ed;
	}

	.cu-hero::before {
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			radial-gradient(ellipse 42% 70% at 56% 52%, rgba(26, 54, 83, 0.58), transparent 68%),
			radial-gradient(ellipse 34% 80% at 100% 70%, rgba(19, 42, 68, 0.45), transparent 72%);
		content: '';
	}

	.cu-hero::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
		mix-blend-mode: soft-light;
		opacity: 0.16;
		pointer-events: none;
		content: '';
	}

	.cu-hero__atmosphere {
		position: absolute;
		top: -28%;
		left: 51%;
		z-index: -1;
		width: 1px;
		height: 140%;
		background: linear-gradient(180deg, transparent 0%, rgba(214, 166, 76, 0.18) 37%, rgba(214, 166, 76, 0.03) 70%, transparent 100%);
		box-shadow: 0 0 90px 45px rgba(192, 142, 45, 0.035);
		transform: rotate(13deg);
		pointer-events: none;
	}

	.cu-hero__grid {
		display: grid;
		grid-template-columns: minmax(290px, 0.9fr) minmax(570px, 1.36fr) minmax(208px, 0.5fr);
		align-items: center;
		gap: clamp(20px, 2.6vw, 48px);
		width: min(100%, 1540px);
		min-height: calc(100svh - 150px);
		margin: 0 auto;
	}

	.cu-hero__copy {
		position: relative;
		z-index: 3;
		max-width: 440px;
		padding-bottom: 5px;
	}

	.cu-hero__kicker,
	.cu-hero__solutions-label,
	.cu-callout__label {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.21em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.cu-hero__kicker {
		display: flex;
		align-items: center;
		gap: 13px;
		margin-bottom: 25px;
		color: #d7ad5c;
	}

	.cu-hero__kicker::before {
		display: block;
		width: 30px;
		height: 1px;
		background: #bd8a2d;
		content: '';
	}

	.cu-hero__title {
		max-width: 620px;
		margin: 0;
		font-family: 'Manrope', 'Inter', ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(3rem, 4.8vw, 5.35rem);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 0.99;
		color: #f8f6f1;
	}

	.cu-hero__title span {
		font-weight: 700;
		color: #d3a44f;
	}

	.cu-hero__description {
		max-width: 410px;
		margin: 31px 0 0;
		font-size: 15px;
		font-weight: 400;
		letter-spacing: -0.01em;
		line-height: 1.72;
		color: rgba(238, 240, 237, 0.68);
	}

	.cu-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
		margin-top: 35px;
	}

	.cu-hero__primary,
	.cu-hero__secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		min-height: 50px;
		padding: 0 22px;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.13em;
		line-height: 1;
		text-transform: uppercase;
		text-decoration: none;
		transition: transform 220ms ease, background 220ms ease, border-color 220ms ease;
	}

	.cu-hero__primary {
		border: 1px solid #c99b43;
		background: #be8c30;
		color: #101b2b;
		box-shadow: 0 13px 25px rgba(0, 0, 0, 0.16);
	}

	.cu-hero__primary span,
	.cu-hero__secondary span {
		font-size: 17px;
		font-weight: 400;
		line-height: 0;
	}

	.cu-hero__primary:hover {
		background: #d2ab61;
		transform: translateY(-2px);
	}

	.cu-hero__secondary {
		padding-inline: 4px;
		border-bottom: 1px solid rgba(211, 164, 79, 0.55);
		color: rgba(248, 246, 241, 0.82);
	}

	.cu-hero__secondary:hover {
		border-color: #d3a44f;
		color: #e3bb72;
		transform: translateY(-2px);
	}

	.cu-hero__proof {
		display: flex;
		flex-wrap: wrap;
		gap: 9px 19px;
		margin-top: 40px;
		padding-top: 18px;
		border-top: 1px solid rgba(222, 211, 188, 0.15);
	}

	.cu-hero__proof span {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: rgba(239, 237, 230, 0.63);
		white-space: nowrap;
	}

	.cu-hero__proof span::before {
		color: #d3a44f;
		content: '✓';
		font-size: 12px;
	}

	.cu-hero__stage {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: min(77svh, 780px);
		min-height: 560px;
	}

	.cu-hero__product-media {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(100%, 340px);
		height: 100%;
		will-change: transform;
	}

	.cu-hero__product-media::before {
		position: absolute;
		top: 14%;
		left: 50%;
		width: 220px;
		height: 62%;
		border-radius: 50%;
		background: rgba(205, 159, 69, 0.055);
		box-shadow: 0 0 85px rgba(212, 166, 80, 0.10);
		content: '';
		transform: translateX(-50%);
	}

	.cu-hero__product-light {
		position: absolute;
		bottom: 2.5%;
		left: 50%;
		z-index: 0;
		width: min(285px, 100%);
		height: 22px;
		border-radius: 50%;
		background: rgba(232, 175, 54, 0.34);
		filter: blur(16px);
		transform: translateX(-50%);
	}

	.cu-hero__product-podium {
		position: absolute;
		bottom: 3.5%;
		left: 50%;
		z-index: 0;
		width: min(320px, 100%);
		height: 76px;
		border: 1px solid rgba(255, 221, 125, 0.9);
		border-radius: 50% / 24%;
		background: linear-gradient(180deg, #dca943 0%, #bb8224 19%, #9a6417 23%, #c58b25 78%, #6d430d 100%);
		box-shadow: 0 10px 0 -2px rgba(241, 191, 72, 0.74), 0 18px 26px rgba(0, 0, 0, 0.35), 0 0 26px rgba(217, 164, 45, 0.22);
		transform: translateX(-50%);
	}

	.cu-hero__product-podium::before {
		position: absolute;
		top: -2px;
		left: -1px;
		width: calc(100% + 2px);
		height: 34px;
		border: 1px solid rgba(255, 224, 140, 0.95);
		border-radius: 50%;
		background: radial-gradient(ellipse at 50% 28%, #fff2b7 0%, #f1cc6c 38%, #c88c28 82%, #875514 100%);
		box-shadow: inset 0 -5px 5px rgba(121, 73, 13, 0.3), 0 2px 0 rgba(255, 238, 166, 0.78);
		content: '';
	}

	.cu-hero__product-podium::after {
		position: absolute;
		bottom: 6px;
		left: 8%;
		width: 84%;
		height: 8px;
		border-radius: 50%;
		background: rgba(255, 218, 107, 0.8);
		box-shadow: 0 0 12px rgba(255, 205, 73, 0.8);
		content: '';
	}

	.cu-hero__product-image {
		position: relative;
		z-index: 1;
		display: block;
		height: 89%;
		width: auto;
		max-width: none;
		object-fit: contain;
		filter: saturate(0.96) contrast(1.02);
		will-change: transform;
	}

	.cu-hero__annotations {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	.cu-callout {
		position: absolute;
		width: 152px;
		font-size: 10px;
		line-height: 1.35;
		color: rgba(242, 240, 233, 0.7);
	}

	.cu-callout--left {
		left: 0;
		text-align: right;
	}

	.cu-callout--right {
		right: 0;
		text-align: left;
	}

	.cu-callout--left::after,
	.cu-callout--right::before {
		position: absolute;
		top: 7px;
		width: 38px;
		height: 1px;
		background: linear-gradient(90deg, rgba(204, 156, 67, 0.08), rgba(204, 156, 67, 0.72));
		content: '';
	}

	.cu-callout--left::after {
		right: -45px;
	}

	.cu-callout--right::before {
		left: -45px;
		background: linear-gradient(90deg, rgba(204, 156, 67, 0.72), rgba(204, 156, 67, 0.08));
	}

	.cu-callout--left::before,
	.cu-callout--right::after {
		position: absolute;
		top: 4px;
		width: 6px;
		height: 6px;
		border: 1px solid #c99b43;
		border-radius: 50%;
		background: #081524;
		content: '';
	}

	.cu-callout--left::before {
		right: -49px;
	}

	.cu-callout--right::after {
		left: -49px;
	}

	.cu-callout__label {
		display: block;
		margin-bottom: 7px;
		color: #d4a858;
	}

	.cu-callout strong,
	.cu-callout small {
		display: block;
	}

	.cu-callout strong {
		font-size: 11px;
		font-weight: 600;
		color: rgba(246, 243, 237, 0.86);
	}

	.cu-callout small {
		margin-top: 2px;
		font-size: 10px;
		font-weight: 400;
		color: rgba(224, 226, 222, 0.47);
	}

	.cu-callout--1 { top: 33%; }
	.cu-callout--2 { top: 47%; }
	.cu-callout--3 { top: 63%; }
	.cu-callout--4 { top: 35%; }
	.cu-callout--5 { top: 52%; }
	.cu-callout--6 { top: 68%; }

	.cu-hero__solutions {
		align-self: center;
		max-width: 220px;
		padding-left: 23px;
		border-left: 1px solid rgba(211, 164, 79, 0.4);
	}

	.cu-hero__solutions-label {
		margin: 0 0 22px;
		color: #d4a858;
	}

	.cu-hero__solutions ul {
		display: grid;
		gap: 13px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cu-hero__solutions li {
		position: relative;
		padding-left: 13px;
		font-size: 11px;
		font-weight: 500;
		line-height: 1.35;
		color: rgba(235, 235, 230, 0.68);
	}

	.cu-hero__solutions li::before {
		position: absolute;
		top: 0.55em;
		left: 0;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: #d1a04a;
		content: '';
	}

	.cu-hero__solutions-note {
		margin: 35px 0 0;
		font-family: Georgia, serif;
		font-size: 13px;
		font-style: italic;
		line-height: 1.45;
		color: rgba(239, 232, 214, 0.55);
	}

	.cu-hero__scroll {
		position: absolute;
		bottom: 24px;
		left: 50%;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		transform: translateX(-50%);
	}

	.cu-hero__scroll span {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(237, 233, 220, 0.38);
	}

	.cu-hero__scroll i {
		display: block;
		width: 30px;
		height: 1px;
		background: linear-gradient(90deg, #c7973c, transparent);
	}

	.hero-reveal {
		opacity: 0;
		animation: cu-fade-up 800ms cubic-bezier(0.22, 0.7, 0.2, 1) forwards;
	}

	.hero-reveal--1 { animation-delay: 120ms; }
	.hero-reveal--2 { animation-delay: 220ms; }
	.hero-reveal--3 { animation-delay: 330ms; }
	.hero-reveal--4 { animation-delay: 430ms; }
	.hero-reveal--5 { animation-delay: 540ms; }
	.hero-reveal--6 { animation-delay: 570ms; }
	.hero-reveal--stage {
		animation-name: cu-product-in;
		animation-duration: 1100ms;
		animation-delay: 180ms;
	}

	@keyframes cu-fade-up {
		from { opacity: 0; transform: translateY(18px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes cu-product-in {
		from { opacity: 0; transform: translateY(24px) scale(0.985); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	@media (max-width: 1279px) and (min-width: 821px) {
		.cu-hero {
			padding-inline: 24px;
		}

		.cu-hero__grid {
			grid-template-columns: minmax(250px, 0.7fr) minmax(490px, 1.3fr) minmax(165px, 0.42fr);
			gap: 18px;
		}

		.cu-hero__stage {
			min-height: 510px;
			height: min(72svh, 670px);
		}

		.cu-hero__product-image {
			height: 89%;
		}

		.cu-callout {
			width: 125px;
		}

		.cu-callout--left::after,
		.cu-callout--right::before,
		.cu-callout--left::before,
		.cu-callout--right::after {
			display: none;
		}

		.cu-hero__title {
			font-size: clamp(2.9rem, 4.4vw, 4.1rem);
		}
	}

	@media (max-width: 1100px) and (min-width: 821px) {
		.cu-hero__grid {
			grid-template-columns: minmax(220px, 0.72fr) minmax(430px, 1.28fr);
			align-items: center;
			gap: 22px;
		}

		.cu-hero__solutions {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-items: center;
			gap: 24px;
			width: 100%;
			max-width: none;
			padding: 16px 0 0;
			border-top: 1px solid rgba(211, 164, 79, 0.32);
			border-left: 0;
		}

		.cu-hero__solutions-label {
			margin: 0;
		}

		.cu-hero__solutions ul {
			display: flex;
			flex-wrap: wrap;
			gap: 8px 22px;
		}

		.cu-hero__solutions-note {
			margin: 0;
		}
	}

	@media (max-width: 820px) {
		.cu-hero {
			display: block;
			min-height: 0;
			padding: 104px 20px 58px;
		}

		.cu-hero__grid {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			min-height: 0;
			gap: 0;
		}

		.cu-hero__copy {
			display: contents;
		}

		.cu-hero__kicker {
			order: 1;
			margin: 4px 0 21px;
			font-size: 9px;
		}

		.cu-hero__title {
			order: 2;
			max-width: 550px;
			font-size: clamp(2.65rem, 11.5vw, 4.2rem);
			letter-spacing: -0.07em;
			line-height: 1.01;
		}

		.cu-hero__stage {
			order: 3;
			height: auto;
			min-height: 0;
			margin: 10px auto 0;
		}

		.cu-hero__product-media {
			height: clamp(430px, 66svh, 590px);
		}

		.cu-hero__product-image {
			height: 89%;
		}

		.cu-hero__product-light,
		.cu-hero__product-podium {
			bottom: 2%;
		}

		.cu-hero__annotations {
			position: relative;
			inset: auto;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px 18px;
			margin: 8px 2px 0;
		}

		.cu-callout,
		.cu-callout--left,
		.cu-callout--right {
			position: relative;
			top: auto;
			right: auto;
			left: auto;
			width: auto;
			text-align: left;
		}

		.cu-callout::before,
		.cu-callout::after {
			display: none;
		}

		.cu-callout__label {
			margin-bottom: 5px;
			font-size: 9px;
		}

		.cu-callout strong {
			font-size: 10px;
		}

		.cu-callout small {
			font-size: 9px;
		}

		.cu-hero__description {
			order: 4;
			max-width: 560px;
			margin-top: 35px;
			font-size: 14px;
			line-height: 1.65;
		}

		.cu-hero__actions {
			order: 5;
			align-items: stretch;
			margin-top: 26px;
		}

		.cu-hero__primary {
			min-width: min(100%, 220px);
		}

		.cu-hero__secondary {
			justify-content: flex-start;
			min-height: 44px;
		}

		.cu-hero__proof {
