---
/**
 * Header : logo à gauche, pilules de navigation sombres au centre,
 * bouton « Demander un devis » et bouton menu à droite.
 * Palette : bleu nuit (#00001C) et or (#D4AF37).
 */
const NAV = [
	{ label: 'Accueil', href: '/' },
	{ label: 'À propos', href: '/about' },
	{
		label: 'Services',
		href: '/services',
		children: [
			{ label: 'Nos services', href: '/services' },
			{ label: 'Catalogue', href: '/catalogue' },
		],
	},
	{
		label: 'Pages',
		href: '/blog',
		children: [
			{ label: 'Blog', href: '/blog' },
			{ label: 'Contact', href: '/contact' },
		],
	},
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
const groupActive = (item: { href: string; children?: { href: string }[] }) =>
	isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-[60]">
	<div class="header-inner mx-auto flex items-center justify-between gap-4">
		<!-- Logo -->
		<a href="/" class="logo-link shrink-0" aria-label="Confection Univers — accueil">
			<img src="/images/logo.png" alt="Confection Univers" class="h-10 w-auto md:h-11" width="200" height="76" decoding="async" />
		</a>

		<!-- Navigation centrale -->
		<nav class="hidden items-center gap-2 lg:flex" aria-label="Navigation principale">
			{
				NAV.map((item) =>
					item.children ? (
						<div class="pill-group relative">
							<button
								type="button"
								class:list={['pill', groupActive(item) && 'is-active']}
								aria-haspopup="true"
								aria-expanded="false"
								data-dropdown
							>
								<span>{item.label}</span>
								<svg class="chevron h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
								</svg>
							</button>
							<div class="dropdown" role="menu">
								{item.children.map((c) => (
									<a href={c.href} role="menuitem" class:list={['dropdown-link', isActive(c.href) && 'is-active']}>
										{c.label}
									</a>
								))}
							</div>
						</div>
					) : (
						<a href={item.href} class:list={['pill', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
							<span>{item.label}</span>
						</a>
					),
				)
			}
		</nav>

		<!-- Actions à droite -->
		<div class="flex items-center gap-1.5">
			<a href="/contact" class="btn-cta hidden items-center gap-2 md:inline-flex">
				<span>Demander un devis</span>
			</a>
			<button type="button" id="menu-toggle" class="burger-pill" aria-expanded="false" aria-controls="menu-drawer" aria-label="Ouvrir le menu">
				<span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
			</button>
		</div>
	</div>
</header>

<!-- Tiroir latéral -->
<div id="menu-overlay" class="menu-overlay fixed inset-0 z-[68]" hidden></div>
<aside id="menu-drawer" class="menu-drawer fixed inset-y-0 right-0 z-[70] flex w-[min(420px,100vw)] flex-col px-8 pb-10 pt-8" aria-label="Menu" aria-hidden="true">
	<div class="mb-10 flex items-center justify-between">
		<img src="/images/logo.png" alt="" class="h-10 w-auto" width="200" height="76" />
		<button type="button" id="menu-close" class="close-pill" aria-label="Fermer le menu">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
	</div>

	<nav class="flex flex-col gap-1" aria-label="Menu mobile">
		{
			NAV.flatMap((item) => [item, ...(item.children ?? [])]).map((l) => (
				<a href={l.href} class:list={['drawer-link', isActive(l.href) && 'is-active']}>
					{l.label}
				</a>
			))
		}
	</nav>

	<a href="/contact" class="btn-cta mt-auto inline-flex w-full justify-center">Demander un devis</a>
	<p class="mt-6 text-sm text-white/60">confectionunivers@gmail.com · +221 77 296 07 76</p>
</aside>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const drawer = document.getElementById('menu-drawer');
	const overlay = document.getElementById('menu-overlay');
	const closeBtn = document.getElementById('menu-close');

	const setDrawer = (open: boolean) => {
		drawer?.classList.toggle('is-open', open);
		drawer?.setAttribute('aria-hidden', open ? 'false' : 'true');
		overlay?.toggleAttribute('hidden', !open);
		overlay?.classList.toggle('is-visible', open);
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle?.classList.toggle('is-open', open);
	};

	toggle?.addEventListener('click', () => setDrawer(!drawer?.classList.contains('is-open')));
	closeBtn?.addEventListener('click', () => setDrawer(false));
	overlay?.addEventListener('click', () => setDrawer(false));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			setDrawer(false);
			document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
		}
	});

	// Sous-menus : ouverture au clic (tactile) ; le survol est géré en CSS
	document.querySelectorAll<HTMLButtonElement>('[data-dropdown]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const open = btn.getAttribute('aria-expanded') !== 'true';
			document.querySelectorAll<HTMLButtonElement>('[data-dropdown]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('.pill-group')) {
			document.querySelectorAll<HTMLButtonElement>('[data-dropdown]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
		}
	});

	// Léger rappel visuel quand la page est défilée
	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>

<style>
	/* ---------- Header ---------- */
	.site-header {
		padding: 28px 0 0;
		pointer-events: none;
	}

	.header-inner {
		width: 92vw;
		pointer-events: auto;
	}

	/* Largeur de la référence : contenu centré, environ 2/3 de l'écran */
	@media (min-width: 1024px) {
		.header-inner {
			width: min(66vw, 1240px);
		}
	}

	.logo-link img {
		filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
	}

	.site-header.is-scrolled {
		padding-top: 14px;
	}

	.site-header {
		transition: padding 0.4s ease;
	}

	/* ---------- Pilules ---------- */
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 16px;
		border-radius: 9999px;
		border: 1px solid rgba(212, 175, 55, 0.12);
		background: rgba(6, 8, 26, 0.72);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.01em;
		white-space: nowrap;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
	}

	.pill:hover {
		background: rgba(212, 175, 55, 0.18);
		border-color: rgba(212, 175, 55, 0.45);
		color: #FACC6B;
	}

	.pill.is-active {
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 100%);
		border-color: transparent;
		color: #00001C;
	}

	.pill .chevron {
		transition: transform 0.3s ease;
	}

	.pill-group[data-open='true'] .chevron,
	.pill-group:hover .chevron,
	.pill-group:focus-within .chevron,
	.pill[aria-expanded='true'] .chevron {
		transform: rotate(180deg);
	}

	/* Sous-menu */
	.dropdown {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		min-width: 200px;
		padding: 8px;
		border-radius: 16px;
		background: rgba(6, 8, 26, 0.94);
		border: 1px solid rgba(212, 175, 55, 0.25);
		box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(14px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
	}

	.pill-group:hover .dropdown,
	.pill-group:focus-within .dropdown,
	.pill[aria-expanded='true'] + .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown-link {
		display: block;
		padding: 10px 14px;
		border-radius: 10px;
		color: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 500;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.dropdown-link:hover,
	.dropdown-link.is-active {
		background: rgba(212, 175, 55, 0.18);
		color: #FACC6B;
	}

	/* ---------- Boutons ---------- */
	.btn-cta {
		height: 36px;
		padding: 0 18px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		color: #00001C;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 8px 20px -8px rgba(212, 175, 55, 0.6);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.btn-cta:hover {
		transform: translateY(-1px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 12px 26px -8px rgba(212, 175, 55, 0.75);
	}

	.burger-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 36px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 8px 20px -8px rgba(212, 175, 55, 0.6);
		transition: transform 0.3s ease;
	}

	.burger-pill:hover {
		transform: translateY(-1px);
	}

	.burger-lines {
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 16px;
	}

	.burger-lines span {
		display: block;
		height: 2px;
		border-radius: 2px;
		background: #00001C;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.burger-pill.is-open .burger-lines span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.burger-pill.is-open .burger-lines span:nth-child(2) {
		opacity: 0;
	}

	.burger-pill.is-open .burger-lines span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* ---------- Tiroir ---------- */
	.menu-overlay {
		background: rgba(0, 0, 14, 0.6);
		backdrop-filter: blur(4px);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.menu-overlay.is-visible {
		opacity: 1;
	}

	.menu-drawer {
		background: linear-gradient(170deg, #00001C 0%, #000028 60%, #0a1040 100%);
		border-left: 1px solid rgba(212, 175, 55, 0.3);
		box-shadow: -30px 0 60px -20px rgba(0, 0, 0, 0.6);
		transform: translateX(100%);
		transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
		overflow-y: auto;
	}

	.menu-drawer.is-open {
		transform: translateX(0);
	}

	.close-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 9999px;
		color: #FACC6B;
		border: 1px solid rgba(212, 175, 55, 0.4);
		transition: background-color 0.3s ease;
	}

	.close-pill:hover {
		background: rgba(212, 175, 55, 0.15);
	}

	.drawer-link {
		padding: 12px 0;
		border-bottom: 1px solid rgba(212, 175, 55, 0.12);
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: 24px;
		font-weight: 600;
		color: #ffffff;
		transition: color 0.3s ease, padding-left 0.3s ease;
	}

	.drawer-link:hover,
	.drawer-link.is-active {
		color: #FACC6B;
		padding-left: 10px;
	}

	.site-header .btn-cta {
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-drawer,
		.menu-overlay,
		.pill,
		.dropdown,
		.btn-cta,
		.burger-pill {
			transition: none;
		}
	}
</style>
