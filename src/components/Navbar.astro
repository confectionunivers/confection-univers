---
/**
 * Header : logo (sur fond blanc), 6 liens de navigation, bouton « Demander un devis »
 * et bouton menu qui ouvre un tiroir blanc. Palette : bleu nuit (#00001C) et or (#D4AF37).
 */

const NAV = [
	{ label: 'Accueil', href: '/' },
	{ label: 'À propos', href: '/about' },
	{ label: 'Services', href: '/services' },
	{ label: 'Catalogue', href: '/catalogue' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));

const gallery = ['/images/gallery1.jpg', '/images/gallery2.jpg', '/images/gallery3.jpg', '/images/gallery4.jpg'];
const social = [
	{ label: 'Facebook', href: 'https://facebook.com/confectionunivers', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
	{ label: 'Instagram', href: 'https://instagram.com/confectionunivers', icon: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 2a2.5 2.5 0 100 5 2.5 2.5 0 000-5z' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/company/confectionunivers', icon: 'M4 3a2 2 0 110 4 2 2 0 010-4zm-1 6h3v12H3V9zm6 0h3v2c.5-1 1.8-2 3.6-2C19.5 9 21 10.5 21 13.5V21h-3v-6.5c0-1.6-.6-2.5-2-2.5s-2.5 1-2.5 2.6V21H9V9z' },
	{ label: 'WhatsApp', href: 'https://wa.me/221772960776', icon: 'M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z' },
];
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-[60]">
	<div class="top-info-bar" role="region" aria-label="Informations de contact">
		<div class="top-info-inner">
			<span class="top-info-brand">Confection de vêtements professionnels au Sénégal</span>
			<div class="top-info-details">
				<a href="tel:+221772960776" class="top-info-link">+221 77 296 07 76</a>
				<a href="mailto:confectionunivers@gmail.com" class="top-info-link top-info-email">confectionunivers@gmail.com</a>
				<span class="top-info-link top-info-location">Thiès, Sénégal</span>
			</div>
		</div>
	</div>
	<div class="header-inner mx-auto flex items-center justify-between gap-4">
		<a href="/" class="logo-link logo-chip shrink-0" aria-label="Confection Univers — accueil">
			<img src="/images/logo.png" alt="Confection Univers" class="h-12 w-auto md:h-14" width="200" height="76" decoding="async" />
		</a>

		<!-- Liens de navigation (grand écran) -->
		<nav class="hidden items-center gap-2 xl:flex" aria-label="Navigation principale">
			{
				NAV.map((item) => (
					<a href={item.href} class:list={['pill', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
						<span>{item.label}</span>
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1.5">
			<a href="/contact" class="btn-cta hidden items-center md:inline-flex">Demander un devis</a>
			<button type="button" id="menu-toggle" class="burger-pill" aria-expanded="false" aria-controls="menu-drawer" aria-label="Ouvrir le menu">
				<span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
			</button>
		</div>
	</div>
</header>

<div id="menu-overlay" class="menu-overlay fixed inset-0 z-[68]" hidden></div>

<aside id="menu-drawer" class="menu-drawer fixed inset-y-0 right-0 z-[70] flex w-[min(360px,92vw)] flex-col" aria-label="Menu" aria-hidden="true">
	<div class="flex items-center justify-between px-7 pb-4 pt-7">
		<a href="/" aria-label="Accueil" class="logo-chip"><img src="/images/logo.png" alt="Confection Univers" class="h-12 w-auto" width="200" height="76" /></a>
		<button type="button" id="menu-close" class="close-btn" aria-label="Fermer le menu">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
	</div>

	<div class="flex-1 overflow-y-auto px-7 pb-8">
		<nav aria-label="Menu mobile" class="drawer-nav">
			{
				NAV.map((item) => (
					<a href={item.href} class:list={['drawer-link', isActive(item.href) && 'is-active']}>
						<span>{item.label}</span>
					</a>
				))
			}
		</nav>

		<section class="mt-10" aria-labelledby="drawer-gallery">
			<h2 id="drawer-gallery" class="mb-4 text-lg font-semibold text-[#00001C]">Nos réalisations</h2>
			<div class="grid grid-cols-2 gap-3">
				{
					gallery.map((src) => (
						<a href="/catalogue" class="tile block overflow-hidden rounded-xl">
							<img src={src} alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</a>
					))
				}
			</div>
		</section>

		<section class="mt-10" aria-labelledby="drawer-follow">
			<h2 id="drawer-follow" class="mb-4 text-lg font-semibold text-[#00001C]">Suivez-nous</h2>
			<div class="flex gap-3">
				{
					social.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer" class="social-icon flex h-10 w-10 items-center justify-center rounded-full" aria-label={s.label}>
							<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
						</a>
					))
				}
			</div>
		</section>

		<a href="/contact" class="btn-cta mt-10 flex w-full justify-center">Demander un devis</a>
	</div>
</aside>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const drawer = document.getElementById('menu-drawer');
	const overlay = document.getElementById('menu-overlay');
	const closeBtn = document.getElementById('menu-close');

	const setDrawer = (open: boolean) => {
		drawer?.classList.toggle('is-open', open);
		drawer?.setAttribute('aria-hidden', open ? 'false' : 'true');
		if (overlay) {
			overlay.hidden = !open;
			overlay.classList.toggle('is-visible', open);
		}
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle?.classList.toggle('is-open', open);
		document.body.classList.toggle('menu-locked', open);
	};

	toggle?.addEventListener('click', () => setDrawer(!drawer?.classList.contains('is-open')));
	closeBtn?.addEventListener('click', () => setDrawer(false));
	overlay?.addEventListener('click', () => setDrawer(false));
	drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));

	// Accordéons du tiroir
	drawer?.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const open = btn.getAttribute('aria-expanded') !== 'true';
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			btn.parentElement?.classList.toggle('is-open', open);
		});
	});

	// Sous-menus des pilules : au clic (tactile)
	const dropdowns = document.querySelectorAll<HTMLButtonElement>('[data-dropdown]');
	const closeDropdowns = () => dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
	dropdowns.forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = btn.getAttribute('aria-expanded') !== 'true';
			closeDropdowns();
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('.pill-group')) closeDropdowns();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			setDrawer(false);
			closeDropdowns();
		}
	});

	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>

<style>
	/* ---------- Header ---------- */
	.site-header {
		padding: 0;
		pointer-events: none;
	}

	.top-info-bar {
		width: 100%;
		height: 36px;
		pointer-events: auto;
		border-bottom: 1px solid rgba(184, 134, 11, 0.28);
		background: linear-gradient(100deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 248, 226, 0.97) 54%, rgba(250, 204, 107, 0.94) 100%);
		color: #00001C;
		box-shadow: 0 5px 18px rgba(0, 0, 0, 0.12);
	}

	.top-info-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: 92vw;
		height: 100%;
		margin: 0 auto;
	}

	.top-info-brand {
		color: rgba(0, 0, 28, 0.72);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.top-info-details {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 1.6vw, 1.5rem);
	}

	.top-info-link {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: #00001C;
		font-size: 11px;
		font-weight: 600;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.top-info-link::before {
		content: '';
		width: 5px;
		height: 5px;
		flex: 0 0 5px;
		border-radius: 50%;
		background: #B8860B;
	}

	.top-info-link:hover {
		color: #8A6500;
	}

	.header-inner {
		width: 92vw;
		margin-top: 10px;
		pointer-events: auto;
		transition: margin-top 0.35s ease;
	}

	.site-header.is-scrolled .header-inner {
		margin-top: 6px;
	}

	@media (max-width: 1023px) {
		.top-info-brand,
		.top-info-email {
			display: none;
		}

		.top-info-inner {
			justify-content: flex-end;
		}
	}

	@media (max-width: 540px) {
		.top-info-bar {
			height: 32px;
		}

		.top-info-inner {
			justify-content: center;
		}

		.top-info-location {
			display: none;
		}

		.top-info-link {
			font-size: 10px;
		}
	}

	@media (min-width: 1536px) {
		.header-inner,
		.top-info-inner {
			width: min(66vw, 1240px);
		}
	}

	/* Logo sur fond blanc : visible quel que soit le hero */
	.logo-chip {
		display: inline-flex;
		align-items: center;
		padding: 8px 18px;
		border-radius: 18px;
		background: #ffffff;
		box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.5), inset 0 -2px 0 rgba(212, 175, 55, 0.5);
	}

	.logo-chip img {
		height: 48px;
		width: auto;
	}

	/* ---------- Pilules ---------- */
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 14px;
		border-radius: 9999px;
		border: 1px solid rgba(212, 175, 55, 0.12);
		background: rgba(6, 8, 26, 0.72);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.pill:hover {
		background: rgba(212, 175, 55, 0.18);
		border-color: rgba(212, 175, 55, 0.45);
		color: #FACC6B;
	}

	.pill.is-active {
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 100%);
		border-color: transparent;
		color: #00001C;
	}

	.pill .chevron {
		transition: transform 0.3s ease;
	}

	.pill-group:hover .chevron,
	.pill-group:focus-within .chevron,
	.pill[aria-expanded='true'] .chevron {
		transform: rotate(180deg);
	}

	/* Sous-menu */
	.dropdown {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		z-index: 5;
		min-width: 230px;
		max-height: 70vh;
		overflow-y: auto;
		padding: 8px;
		border-radius: 16px;
		background: rgba(6, 8, 26, 0.95);
		border: 1px solid rgba(212, 175, 55, 0.25);
		box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(14px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
	}

	.pill-group:hover .dropdown,
	.pill-group:focus-within .dropdown,
	.pill[aria-expanded='true'] + .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown-link {
		display: block;
		padding: 9px 14px;
		border-radius: 10px;
		color: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 500;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.dropdown-link:hover,
	.dropdown-link.is-active {
		background: rgba(212, 175, 55, 0.18);
		color: #FACC6B;
	}

	/* ---------- Boutons ---------- */
	.btn-cta {
		justify-content: center;
		height: 36px;
		padding: 0 18px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		color: #00001C;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 8px 20px -8px rgba(212, 175, 55, 0.6);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.btn-cta:hover {
		transform: translateY(-1px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 12px 26px -8px rgba(212, 175, 55, 0.75);
	}

	.burger-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 36px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 8px 20px -8px rgba(212, 175, 55, 0.6);
		transition: transform 0.3s ease;
	}

	.burger-pill:hover {
		transform: translateY(-1px);
	}

	.burger-lines {
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 16px;
	}

	.burger-lines span {
		display: block;
		height: 2px;
		border-radius: 2px;
		background: #00001C;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.burger-pill.is-open .burger-lines span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.burger-pill.is-open .burger-lines span:nth-child(2) {
		opacity: 0;
	}

	.burger-pill.is-open .burger-lines span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* ---------- Tiroir (blanc, comme la référence) ---------- */
	.menu-overlay {
		background: rgba(0, 0, 0, 0.5);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.menu-overlay.is-visible {
		opacity: 1;
	}

	.menu-drawer {
		background: #ffffff;
		color: #00001C;
		box-shadow: -20px 0 50px -20px rgba(0, 0, 0, 0.45);
		transform: translateX(100%);
		transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.menu-drawer.is-open {
		transform: translateX(0);
	}

	.close-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 9999px;
		color: #00001C;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	.close-btn:hover {
		background: #D4AF37;
		color: #00001C;
	}

	.drawer-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 0;
		border-bottom: 1px solid #e5e7eb;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 17px;
		font-weight: 600;
		color: #00001C;
		text-align: left;
		transition: color 0.3s ease, padding-left 0.3s ease;
	}

	.drawer-link:hover,
	.drawer-link.is-active {
		color: #B8860B;
	}

	.drawer-group.is-open > .drawer-link svg {
		transform: rotate(90deg);
	}

	.drawer-sub {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s ease;
	}

	.drawer-group.is-open > .drawer-sub {
		grid-template-rows: 1fr;
	}

	.drawer-sub-link {
		display: block;
		padding: 10px 0 10px 14px;
		border-left: 2px solid #D4AF37;
		margin-left: 2px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		color: #374151;
		transition: color 0.2s ease;
	}

	.drawer-sub-link:hover,
	.drawer-sub-link.is-active {
		color: #B8860B;
	}

	.drawer-group > .drawer-sub > .overflow-hidden {
		min-height: 0;
	}

	.tile {
		aspect-ratio: 1 / 1;
		transition: transform 0.3s ease;
	}

	.tile:hover {
		transform: translateY(-2px);
	}

	.tile img {
		transition: transform 0.5s ease;
	}

	.tile:hover img {
		transform: scale(1.06);
	}

	.social-icon {
		background: #00001C;
		color: #FACC6B;
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease, color 0.3s ease;
	}

	.social-icon:hover {
		transform: translateY(-2px);
		background: #D4AF37;
		color: #00001C;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-drawer,
		.menu-overlay,
		.pill,
		.dropdown,
		.btn-cta,
		.burger-pill,
		.drawer-sub {
			transition: none;
		}
	}
</style>
