---
const NAV_LINKS = [
	{ label: 'Accueil', href: '/' },
	{ label: 'À propos', href: '/about' },
	{ label: 'Nos services', href: '/services' },
	{ label: 'Nos réalisations', href: '/projects' },
	{ label: 'Contact', href: '/contact' },
];

const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="cu-navbar" id="site-navbar">
	<div class="cu-navbar__inner">
		<a class="cu-brand" href="/" aria-label="Confection Univers — accueil">
			<img
				src="/images/logo.png"
				alt="Confection Univers"
				class="cu-brand__logo"
				width="200"
				height="76"
				loading="eager"
				decoding="async"
			/>
			<span class="cu-brand__descriptor">Confectionnement industriel</span>
		</a>

		<nav class="cu-nav-links" aria-label="Navigation principale">
			{NAV_LINKS.map((link) => {
				const isActive = currentPath === normalizePath(link.href);
				return (
					<a href={link.href} class:list={["cu-nav-link", { "is-active": isActive }]} aria-current={isActive ? 'page' : undefined}>
						{link.label}
					</a>
				);
			})}
		</nav>

		<div class="cu-navbar__actions">
			<a class="cu-nav-cta" href="/contact">Demander un devis <span aria-hidden="true">→</span></a>
			<button class="cu-menu-toggle" id="cu-menu-toggle" type="button" aria-expanded="false" aria-controls="cu-mobile-menu">
				<span class="sr-only">Ouvrir le menu</span>
				<span></span><span></span>
			</button>
		</div>
	</div>

	<nav class="cu-mobile-menu" id="cu-mobile-menu" aria-label="Navigation mobile">
		{NAV_LINKS.map((link) => {
			const isActive = currentPath === normalizePath(link.href);
			return <a href={link.href} class:list={["cu-mobile-link", { "is-active": isActive }]}>{link.label}</a>;
		})}
		<a class="cu-mobile-cta" href="/contact">Demander un devis <span aria-hidden="true">→</span></a>
	</nav>
</header>

<script>
	const toggle = document.getElementById('cu-menu-toggle');
	const menu = document.getElementById('cu-mobile-menu');

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!isOpen));
		menu?.classList.toggle('is-open', !isOpen);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			toggle?.setAttribute('aria-expanded', 'false');
			menu?.classList.remove('is-open');
		});
	});
</script>

<style>
	.cu-navbar {
		position: fixed;
		inset: 0 0 auto;
		z-index: 60;
		padding: 16px 28px;
		background: rgba(249, 247, 241, 0.96);
		border-bottom: 1px solid rgba(18, 35, 58, 0.08);
		box-shadow: 0 12px 30px rgba(5, 17, 35, 0.07);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.cu-navbar__inner {
		display: flex;
		align-items: center;
		gap: 34px;
		width: min(100%, 1510px);
		min-height: 56px;
		margin: 0 auto;
	}

	.cu-brand {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		flex-shrink: 0;
		color: #12233a;
		text-decoration: none;
	}

	.cu-brand__logo {
		display: block;
		width: 132px;
		height: auto;
		max-height: 52px;
		object-fit: contain;
		object-position: left center;
	}

	.cu-brand__descriptor {
		padding-left: 16px;
		border-left: 1px solid rgba(18, 35, 58, 0.18);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.35;
		text-transform: uppercase;
		color: #667085;
		white-space: nowrap;
	}

	.cu-nav-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(20px, 2.2vw, 38px);
		margin-inline: auto;
	}

	.cu-nav-link {
		position: relative;
		padding: 12px 0;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.13em;
		line-height: 1;
		text-transform: uppercase;
		color: #344054;
		text-decoration: none;
		transition: color 220ms ease;
	}

	.cu-nav-link::after {
		position: absolute;
		bottom: 3px;
		left: 0;
		width: 0;
		height: 1px;
		background: #b8872c;
		content: '';
		transition: width 220ms ease;
	}

	.cu-nav-link:hover,
	.cu-nav-link.is-active {
		color: #9a6b16;
	}

	.cu-nav-link:hover::after,
	.cu-nav-link.is-active::after {
		width: 100%;
	}

	.cu-navbar__actions {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-shrink: 0;
	}

	.cu-nav-cta,
	.cu-mobile-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 13px;
		min-height: 44px;
		padding: 0 19px;
		border: 1px solid #b8872c;
		background: #be8d32;
		color: #fffdf8;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 220ms ease, box-shadow 220ms ease, transform 220ms ease;
	}

	.cu-nav-cta:hover,
	.cu-mobile-cta:hover {
		background: #a9761d;
		box-shadow: 0 10px 20px rgba(164, 113, 27, 0.2);
		transform: translateY(-1px);
	}

	.cu-nav-cta span,
	.cu-mobile-cta span {
		font-size: 17px;
		font-weight: 400;
		line-height: 0;
	}

	.cu-menu-toggle {
		display: none;
		width: 42px;
		height: 42px;
		padding: 10px;
		border: 1px solid rgba(18, 35, 58, 0.14);
		background: transparent;
		color: #12233a;
		cursor: pointer;
	}

	.cu-menu-toggle span:not(.sr-only) {
		display: block;
		width: 20px;
		height: 1px;
		margin: 5px auto;
		background: currentColor;
		transition: transform 220ms ease, opacity 220ms ease;
	}

	.cu-menu-toggle[aria-expanded='true'] span:nth-last-child(2) {
		transform: translateY(3px) rotate(45deg);
	}

	.cu-menu-toggle[aria-expanded='true'] span:last-child {
		transform: translateY(-3px) rotate(-45deg);
	}

	.cu-mobile-menu {
		display: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1100px) {
		.cu-navbar {
			padding-inline: 20px;
		}

		.cu-brand__descriptor {
			display: none;
		}

		.cu-nav-links {
			gap: 19px;
		}

		.cu-nav-link {
			font-size: 10px;
			letter-spacing: 0.08em;
		}
	}

	@media (max-width: 820px) {
		.cu-navbar {
			padding: 12px 18px;
		}

		.cu-navbar__inner {
			min-height: 50px;
		}

		.cu-brand__logo {
			width: 122px;
			max-height: 46px;
		}

		.cu-nav-links,
		.cu-nav-cta {
			display: none;
		}

		.cu-navbar__actions {
			margin-left: auto;
		}

		.cu-menu-toggle {
			display: block;
		}

		.cu-mobile-menu {
			display: flex;
			flex-direction: column;
			gap: 3px;
			max-height: 0;
			overflow: hidden;
			width: min(100%, 1510px);
			margin: 0 auto;
			op: 100%;
			transition: max-height 360ms ease, padding 360ms ease;
		}

		.cu-mobile-menu.is-open {
			max-height: 430px;
			padding: 18px 0 8px;
		}

		.cu-mobile-link {
			padding: 15px 2px;
			border-bottom: 1px solid rgba(18, 35, 58, 0.08);
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 0.13em;
			text-transform: uppercase;
			color: #344054;
			text-decoration: none;
		}

		.cu-mobile-link.is-active,
		.cu-mobile-link:hover {
			color: #9a6b16;
		}

		.cu-mobile-cta {
			margin-top: 16px;
		}
	}
</style>
