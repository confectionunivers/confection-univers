---
import Picture from './Picture.astro';
/**
 * Header : logo (sur fond blanc), 6 liens de navigation, bouton « Demander un devis »
 * et bouton menu qui ouvre un tiroir blanc. Palette : bleu nuit (#00001C) et or (#D4AF37).
 */

const NAV = [
	{ label: 'Accueil', href: '/' },
	{ label: 'À propos', href: '/about' },
	{ label: 'Services', href: '/services' },
	{ label: 'Catalogue', href: '/catalogue' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));

const gallery = ['/images/gallery1.jpg', '/images/gallery2.jpg', '/images/gallery3.jpg', '/images/gallery4.jpg'];
const social = [
	{ label: 'Facebook', href: 'https://facebook.com/confectionunivers', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
	{ label: 'Instagram', href: 'https://instagram.com/confectionunivers', icon: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 2a2.5 2.5 0 100 5 2.5 2.5 0 000-5z' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/company/confectionunivers', icon: 'M4 3a2 2 0 110 4 2 2 0 010-4zm-1 6h3v12H3V9zm6 0h3v2c.5-1 1.8-2 3.6-2C19.5 9 21 10.5 21 13.5V21h-3v-6.5c0-1.6-.6-2.5-2-2.5s-2.5 1-2.5 2.6V21H9V9z' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@ConfectionUnivers', icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
	{ label: 'WhatsApp', href: 'https://wa.me/221772960776', icon: 'M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z' },
];
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-[60]">
	<div class="top-info-bar" role="region" aria-label="Informations de contact">
		<div class="top-info-inner">
			<p class="top-info-typer">
				<span class="typer-text">Confection de vêtements professionnels au Sénégal</span><span class="typer-caret" aria-hidden="true"></span>
			</p>
			<div class="top-info-details">
				<a href="tel:+221772960776" class="top-info-chip">
					<svg class="top-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z" /></svg>
					<span>+221 77 296 07 76</span>
				</a>
				<a href="mailto:confectionunivers@gmail.com" class="top-info-chip top-info-email">
					<svg class="top-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
					<span>confectionunivers@gmail.com</span>
				</a>
				<span class="top-info-chip top-info-location">
					<svg class="top-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
					<span>Thiès, Sénégal</span>
				</span>
				<a href="https://wa.me/221772960776" target="_blank" rel="noopener noreferrer" class="top-info-chip top-info-wa">
					<svg class="top-info-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3.1s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.7.9-.5 1.2.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.7.8 2 1 .3.2.5.2.6.4 0 .1 0 .7-.2 1.4z" /></svg>
					<span>WhatsApp</span>
				</a>
			</div>
		</div>
	</div>
	<div class="header-inner mx-auto flex items-center justify-between gap-4">
		<a href="/" class="logo-link logo-chip logo-chip-header shrink-0" aria-label="Confection Univers — accueil">
			<Picture src="/images/logo.png" alt="Confection Univers — atelier de confection industrielle au Sénégal" class="w-auto" loading="eager" fetchpriority="high" />
		</a>

		<!-- Liens de navigation (grand écran) -->
		<nav class="hidden items-center gap-2 xl:flex" aria-label="Navigation principale">
			{
				NAV.map((item) => (
					<a href={item.href} class:list={['pill', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
						<span>{item.label}</span>
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1.5">
			<a href="/contact" class="btn-cta hidden items-center md:inline-flex">Demander un devis</a>
			<button type="button" id="menu-toggle" class="burger-pill" aria-expanded="false" aria-controls="menu-drawer" aria-label="Ouvrir le menu">
				<span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
			</button>
		</div>
	</div>
</header>

<div id="menu-overlay" class="menu-overlay fixed inset-0 z-[68]" hidden></div>

<aside id="menu-drawer" class="menu-drawer fixed inset-y-0 right-0 z-[70] flex w-[min(360px,92vw)] flex-col" aria-label="Menu" aria-hidden="true">
	<div class="flex items-center justify-between px-7 pb-4 pt-7">
		<a href="/" aria-label="Accueil" class="logo-chip"><Picture src="/images/logo.png" alt="Confection Univers" class="h-11 w-auto" loading="eager" /></a>
		<button type="button" id="menu-close" class="close-btn" aria-label="Fermer le menu">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
	</div>

	<div class="flex-1 overflow-y-auto px-7 pb-8">
		<nav aria-label="Menu mobile" class="drawer-nav">
			{
				NAV.map((item) => (
					<a href={item.href} class:list={['drawer-link', isActive(item.href) && 'is-active']}>
						<span>{item.label}</span>
					</a>
				))
			}
		</nav>

		<section class="mt-10" aria-labelledby="drawer-gallery">
			<h2 id="drawer-gallery" class="mb-4 text-lg font-semibold text-[#00001C]">Nos réalisations</h2>
			<div class="grid grid-cols-2 gap-3">
				{
					gallery.map((src) => (
						<a href="/catalogue" class="tile block overflow-hidden rounded-xl">
							<Picture src={src} alt="" class="h-full w-full object-cover" sizes="64px" loading="lazy" />
						</a>
					))
				}
			</div>
		</section>

		<section class="mt-10" aria-labelledby="drawer-follow">
			<h2 id="drawer-follow" class="mb-4 text-lg font-semibold text-[#00001C]">Suivez-nous</h2>
			<div class="flex gap-3">
				{
					social.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer" class="social-icon flex h-10 w-10 items-center justify-center rounded-full" aria-label={s.label}>
							<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
						</a>
					))
				}
			</div>
		</section>

		<a href="/contact" class="btn-cta mt-10 flex w-full justify-center">Demander un devis</a>
	</div>
</aside>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const drawer = document.getElementById('menu-drawer');
	const overlay = document.getElementById('menu-overlay');
	const closeBtn = document.getElementById('menu-close');

	const setDrawer = (open: boolean) => {
		drawer?.classList.toggle('is-open', open);
		drawer?.setAttribute('aria-hidden', open ? 'false' : 'true');
		if (overlay) {
			overlay.hidden = !open;
			overlay.classList.toggle('is-visible', open);
		}
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle?.classList.toggle('is-open', open);
		document.body.classList.toggle('menu-locked', open);
	};

	toggle?.addEventListener('click', () => setDrawer(!drawer?.classList.contains('is-open')));
	closeBtn?.addEventListener('click', () => setDrawer(false));
	overlay?.addEventListener('click', () => setDrawer(false));
	drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));

	// Accordéons du tiroir
	drawer?.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const open = btn.getAttribute('aria-expanded') !== 'true';
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			btn.parentElement?.classList.toggle('is-open', open);
		});
	});

	// Sous-menus des pilules : au clic (tactile)
	const dropdowns = document.querySelectorAll<HTMLButtonElement>('[data-dropdown]');
	const closeDropdowns = () => dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
	dropdowns.forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = btn.getAttribute('aria-expanded') !== 'true';
			closeDropdowns();
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('.pill-group')) closeDropdowns();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			setDrawer(false);
			closeDropdowns();
		}
	});

	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	/* Barre du haut : les accroches se tapent puis s'effacent, en boucle. */
	const typer = document.querySelector<HTMLElement>('.typer-text');
	if (typer && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const messages = [
			'Confection de vêtements professionnels au Sénégal',
			'Devis gratuit sous 24 h',
			'Fabrication locale — atelier de Thiès',
			'Production en gros & détail',
			'Broderie & personnalisation incluses',
		];
		let mi = 0;
		let ci = messages[0].length;
		let deleting = true;
		const tick = () => {
			if (!deleting) {
				ci += 1;
				if (ci === messages[mi].length) {
					deleting = true;
					window.setTimeout(tick, 2300);
					typer.textContent = messages[mi].slice(0, ci);
					return;
				}
			} else {
				ci -= 1;
				if (ci === 0) {
					deleting = false;
					mi = (mi + 1) % messages.length;
					window.setTimeout(tick, 400);
					typer.textContent = '';
					return;
				}
			}
			typer.textContent = messages[mi].slice(0, ci);
			window.setTimeout(tick, deleting ? 26 : 58);
		};
		window.setTimeout(tick, 2600);
	}
</script>

<style>
	/* ---------- Header ---------- */
	.site-header {
		padding: 0;
		pointer-events: none;
	}

	.top-info-bar {
		position: relative;
		width: 100%;
		height: 38px;
		overflow: hidden;
		pointer-events: auto;
		border-bottom: 1px solid rgba(184, 134, 11, 0.62);
		background: linear-gradient(180deg, #ffffff 0%, #fff8e2 52%, #facc6b 100%);
		color: #00001c;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.96),
			inset 0 -1px 0 rgba(145, 96, 0, 0.28),
			0 5px 18px rgba(0, 0, 0, 0.16);
		transition: height 0.35s ease, opacity 0.25s ease, border-color 0.35s ease;
	}

	/* Reflet doré qui glisse périodiquement sur le ruban. */
	.top-info-bar::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.85) 50%, transparent 58%);
		transform: translateX(-100%);
		animation: top-sheen 7s ease-in-out infinite;
		pointer-events: none;
	}

	@keyframes top-sheen {
		0%, 55% { transform: translateX(-100%); }
		85%, 100% { transform: translateX(100%); }
	}

	/* Au scroll, le ruban se replie pour laisser respirer le logo. */
	.site-header.is-scrolled .top-info-bar {
		height: 0;
		opacity: 0;
		border-bottom-color: transparent;
	}

	.top-info-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: 92vw;
		height: 100%;
		margin: 0 auto;
	}

	.top-info-typer {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		margin: 0;
		color: rgba(0, 0, 28, 0.78);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.typer-caret {
		width: 2px;
		height: 12px;
		margin-left: 6px;
		background: #b8860b;
		animation: caret-blink 1s steps(1) infinite;
	}

	@keyframes caret-blink {
		50% { opacity: 0; }
	}

	.top-info-details {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* Pastilles de contact : balayage doré au survol. */
	.top-info-chip {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border: 1px solid rgba(184, 134, 11, 0.4);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.55);
		color: #00001c;
		font-size: 11px;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
	}

	.top-info-chip::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		background: linear-gradient(90deg, rgba(212, 175, 55, 0.92), rgba(250, 204, 107, 0.96));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.top-info-chip > * {
		position: relative;
		z-index: 1;
	}

	.top-info-chip:is(:hover, :focus-visible) {
		color: #00001c;
		border-color: transparent;
	}

	.top-info-chip:is(:hover, :focus-visible)::before {
		transform: scaleX(1);
	}

	.top-info-chip:focus-visible {
		outline: 2px solid #8a6500;
		outline-offset: 2px;
	}

	.top-info-icon {
		width: 12px;
		height: 12px;
		flex: 0 0 12px;
	}

	.top-info-chip:hover .top-info-icon {
		animation: icon-pop 0.45s ease;
	}

	@keyframes icon-pop {
		40% { transform: translateY(-2px) scale(1.15); }
	}

	.top-info-wa {
		border-color: rgba(37, 211, 102, 0.5);
		background: rgba(37, 211, 102, 0.1);
	}

	.top-info-wa:is(:hover, :focus-visible) {
		color: #ffffff;
	}

	.top-info-wa::before {
		background: linear-gradient(90deg, #25d366, #7ae0a3);
	}

	@media (max-width: 1023px) {
		.top-info-typer,
		.top-info-email,
		.top-info-location {
			display: none;
		}

		.top-info-inner {
			justify-content: flex-end;
		}
	}

	@media (max-width: 540px) {
		.top-info-bar {
			height: 34px;
		}

		.top-info-inner {
			justify-content: center;
		}

		.top-info-chip {
			font-size: 10px;
			padding: 3px 9px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.top-info-bar::before,
		.typer-caret,
		.top-info-chip:hover .top-info-icon {
			animation: none;
		}

		.top-info-bar,
		.top-info-chip,
		.top-info-chip::before {
			transition: none;
		}
	}

	/* Respiration entre le ruban du haut et la barre du logo. */
	.header-inner {
		width: 100%;
		padding-inline: clamp(12px, 1.8vw, 28px);
		margin-top: 14px;
		pointer-events: auto;
		transition: margin-top 0.35s ease;
	}

	.site-header.is-scrolled .header-inner {
		margin-top: 8px;
	}

	@media (min-width: 1536px) {
		.header-inner {
			width: 100%;
		}

		.top-info-inner {
			width: min(66vw, 1240px);
		}
	}

	/* Une plaque blanche opaque assure le contraste du logo sur tous les visuels. */
	.logo-chip {
		display: inline-flex;
		align-items: center;
		padding: 8px 18px;
		border-radius: 18px;
		background: #ffffff;
		box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.5), inset 0 -2px 0 rgba(212, 175, 55, 0.5);
	}

	.logo-chip :global(img) {
		display: block;
		height: 44px;
		width: auto;
	}

	/* Le logo reste sur blanc pur, présenté comme une étiquette d'atelier. */
	.logo-chip-header {
		position: relative;
		isolation: isolate;
		padding: 5px 22px 5px 12px;
		border: 1px solid rgba(198, 149, 54, 0.62);
		border-left: 3px solid #c99b42;
		border-radius: 14px 2px 14px 14px;
		background: #ffffff;
		box-shadow: 0 12px 28px rgba(0, 0, 28, 0.27), 0 0 0 3px rgba(255, 255, 255, 0.22);
	}

	.logo-chip-header :global(img) {
		height: 40px;
	}

	/* Coin replié : le bleu nuit révèle une fine face dorée. */
	.logo-chip-header::before {
		content: '';
		position: absolute;
		z-index: 2;
		top: -1px;
		right: -1px;
		width: 19px;
		height: 19px;
		background: linear-gradient(135deg, #dfb85b 0 23%, #192758 26%, #0b1743 100%);
		clip-path: polygon(0 0, 100% 0, 100% 100%);
		transform-origin: top right;
		transition: transform 0.25s ease;
		pointer-events: none;
	}

	.logo-chip-header:is(:hover, :focus-visible)::before {
		transform: translate(-2px, 2px);
	}

	.logo-chip-header:focus-visible {
		outline: 2px solid #facc6b;
		outline-offset: 5px;
	}

	@media (max-width: 540px) {
		.logo-chip-header {
			padding: 4px 14px 4px 7px;
			border-radius: 10px 2px 10px 10px;
		}

		.logo-chip-header :global(img) {
			height: 34px;
		}

		.logo-chip-header::before {
			width: 12px;
			height: 12px;
		}

		.logo-chip-header:is(:hover, :focus-visible)::before {
			transform: none;
		}
	}

	/* ---------- Pilules ---------- */
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 14px;
		border-radius: 9999px;
		border: 1px solid rgba(212, 175, 55, 0.12);
		background: rgba(6, 8, 26, 0.72);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.pill:hover {
		background: rgba(212, 175, 55, 0.18);
		border-color: rgba(212, 175, 55, 0.45);
		color: #FACC6B;
	}

	.pill.is-active {
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 100%);
		border-color: transparent;
		color: #00001C;
	}

	.pill .chevron {
		transition: transform 0.3s ease;
	}

	.pill-group:hover .chevron,
	.pill-group:focus-within .chevron,
	.pill[aria-expanded='true'] .chevron {
		transform: rotate(180deg);
	}

	/* Sous-menu */
	.dropdown {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		z-index: 5;
		min-width: 230px;
		max-height: 70vh;
		overflow-y: auto;
