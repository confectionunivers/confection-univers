---
import SewingDecor from './decor/SewingDecor.astro';
import StitchFrame from './decor/StitchFrame.astro';
import StitchLine from './decor/StitchLine.astro';
import SectionHead from './ui/SectionHead.astro';
import RollButton from './ui/RollButton.astro';

/**
 * Section « Production industrielle » — structure Noryx :
 *   { 02 } # Production  →  grand titre  →  visuel + liste numérotée.
 */
const productionPrinciples = [
	{
		number: '01',
		title: 'Séries cohérentes',
		text: 'Modèle, pièces et déclinaisons définis pour garder une tenue homogène au sein de vos équipes.',
	},
	{
		number: '02',
		title: 'Traçabilité des lots',
		text: 'Chaque commande est suivie de la coupe à la livraison, avec des repères de contrôle clairs.',
	},
	{
		number: '03',
		title: 'Finitions contrôlées',
		text: 'Les pièces sont vérifiées avant emballage : coutures, tailles et rendu final.',
	},
];
---

<section
	id="production-industrielle"
	class="nx-grain relative overflow-hidden px-6 py-24 text-white md:py-32" style="background: linear-gradient(200deg, #00004B 0%, #00004A 45%, #000058 100%);"
	aria-labelledby="industrial-production-heading"
>
	<div class="pointer-events-none absolute -right-32 top-1/4 h-96 w-96 rounded-full bg-[#F5B544]/[0.07] blur-[100px]" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl">
		<SectionHead
			index="02"
			tag="Production industrielle"
			title="Une production pensée pour <span class='nx-accent'>les séries</span>"
			lead="Nous produisons des quantités importantes sans perdre la précision : le même soin du premier au dernier vêtement."
		/>

		<div class="mt-16 grid gap-12 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:gap-16">
			<!-- Visuel -->
			<figure
				class="production-visual nx-zoom group relative overflow-hidden rounded-[1.5rem] border border-[#F5B544]/35 bg-[#000058] shadow-[0_24px_60px_rgba(0,0,0,0.42)] sm:rounded-[1.8rem]"
				data-motion="scale"
			>
				<StitchFrame class="pointer-events-none absolute z-10 text-[#F5B544] opacity-40" inset="inset-3" size={30} stroke={2} />
				<div class="relative aspect-[4/3] overflow-hidden sm:aspect-[5/4]" data-motion-clip>
					<img
						src="/images/project-tenues-industrielles.jpg"
						alt="Équipe portant des tenues de travail coordonnées"
						class="h-full w-full object-cover"
						width="1200"
						height="960"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<figcaption class="nx-badge absolute bottom-4 left-4 backdrop-blur-md">
					Atelier — Thiès
				</figcaption>
			</figure>

			<!-- Liste numérotée -->
			<div>
				<ol class="space-y-1" data-motion-group data-motion-stagger="0.1">
					{productionPrinciples.map((item) => (
						<li class="group border-b border-[#F5B544]/15 py-6 transition-colors hover:border-[#F5B544]/45">
							<div class="flex items-start gap-5">
								<span class="font-display text-sm font-bold tracking-[0.1em] text-[#F5B544]">{item.number}</span>
								<div>
									<h3 class="font-display text-lg font-semibold leading-snug text-white md:text-xl">{item.title}</h3>
									<p class="mt-2 max-w-md text-sm leading-relaxed text-white/55">{item.text}</p>
								</div>
							</div>
						</li>
					))}
				</ol>

				<div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<p class="max-w-sm text-xs leading-relaxed text-white/45">
						Quantités, options et planning sont confirmés après étude du projet.
					</p>
					<RollButton href="/contact" label="Présenter votre projet" variant="solid" />
				</div>
			</div>
		</div>
	</div>

	<StitchLine class="pointer-events-none absolute inset-x-8 bottom-4 text-[#F5B544]" step={18} opacity={0.25} />

	<!-- Décors de couture -->
	<SewingDecor variant="thimble" class="pointer-events-none absolute -left-3 -top-2 h-20 w-20 -rotate-12 text-[#F5B544] opacity-[0.16] md:left-2 md:top-4" />
	<SewingDecor variant="tape" class="pointer-events-none absolute -bottom-6 -right-4 h-28 w-28 text-[#F5B544] opacity-[0.16]" />
	<SewingDecor variant="scissors" class="pointer-events-none absolute bottom-4 left-2 hidden h-20 w-20 rotate-[-14deg] text-[#F5B544] opacity-[0.13] xl:block" />
	<SewingDecor variant="yarn" class="pointer-events-none absolute -top-4 right-8 hidden h-20 w-20 text-[#F5B544] opacity-[0.12] lg:block" />
	<SewingDecor variant="ruler" class="pointer-events-none absolute bottom-8 right-6 hidden h-14 w-14 rotate-[-8deg] text-[#F5B544] opacity-[0.14] xl:block" />
</section>
