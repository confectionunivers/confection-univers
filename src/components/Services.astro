---
import SewingDecor from './decor/SewingDecor.astro';
import StitchLine from './decor/StitchLine.astro';
import SectionHead from './ui/SectionHead.astro';
import RollButton from './ui/RollButton.astro';
import { SERVICES } from '../lib/services';

/**
 * Bandeau des services — défilement continu.
 *
 * Pourquoi toutes les gammes et non 4 « principales » :
 * la boucle n'est invisible que si la piste contient assez de matière. Avec
 * 4 cartes, le motif se répétait tous les ~1 440 px et la reprise se voyait
 * à l'écran. Les 8 gammes portent un passage à ~2 300–2 900 px, soit toujours
 * plus large que le conteneur (1 280 px max) : la couture reste hors champ.
 *
 * La piste contient deux groupes identiques et se décale de -50 %, donc le
 * second groupe atterrit exactement sur le premier : la boucle est sans raccord.
 */
const marqueeItems = SERVICES;
const groups = [false, true];
---

<section
	id="services"
	class="nx-grain relative z-10 scroll-mt-24 overflow-hidden rounded-[1.5rem] px-6 py-20 text-white md:rounded-[2.5rem] md:py-28"
	lang="fr"
	aria-labelledby="services-heading"
>
	<div class="mx-auto max-w-7xl">
		<div class="mb-12 flex flex-col gap-8 md:mb-14 lg:flex-row lg:items-end lg:justify-between">
			<SectionHead
				index="03"
				tag="Nos services"
				title="La confection adaptée à <span class='nx-accent'>votre activité</span>"
				lead="Des uniformes et tenues professionnelles pour les entreprises, les établissements et les équipes."
			/>
			<div class="shrink-0">
				<RollButton href="/services" label="Tous nos services" />
			</div>
		</div>

		<div class="services-carousel" data-services-carousel>
			<div class="services-marquee" tabindex="0" role="region" aria-label="Nos gammes de confection, défilement continu">
				<div class="services-track">
					{groups.map((isDuplicate) => (
						<div class="services-track-group" aria-hidden={isDuplicate ? 'true' : undefined} inert={isDuplicate}>
							{marqueeItems.map((service) => (
								<article class="service-card nx-card-lift nx-zoom group overflow-hidden rounded-[1.5rem] border border-[#F5B544]/20 bg-[#000058]/80 shadow-[0_18px_42px_rgba(0,0,0,0.26)]">
									<a href={`/services/${service.slug}`} class="service-card-image-link block overflow-hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#F5B544]" tabindex={isDuplicate ? -1 : undefined} aria-label={`Découvrir : ${service.title}`}>
										<div class="aspect-[4/3] overflow-hidden bg-surface/40">
											<img
												src={service.image}
												alt={service.title}
												class="service-card-img h-full w-full object-cover"
												width="640"
												height="480"
												loading="lazy"
												decoding="async"
											/>
										</div>
									</a>
									<div class="p-5 md:p-6">
										<h3 class="font-display text-lg font-semibold leading-snug md:text-xl">
											<a href={`/services/${service.slug}`} tabindex={isDuplicate ? -1 : undefined} class="hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
												{service.title}
											</a>
										</h3>
										<p class="mt-3 min-h-[4.5rem] text-sm leading-relaxed text-foreground/70">{service.description}</p>
										<a href={`/services/${service.slug}`} tabindex={isDuplicate ? -1 : undefined} class="mt-5 inline-flex min-h-10 items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary hover:text-primary-light">
											Voir le service <span aria-hidden="true">→</span>
										</a>
									</div>
								</article>
							))}
						</div>
					))}
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between gap-4 text-xs text-white/45">
				<p class="hidden sm:block">Survolez ou sélectionnez une carte pour interrompre le défilement.</p>
				<button type="button" data-services-toggle aria-pressed="false" aria-label="Mettre le défilement en pause" class="services-toggle ml-auto inline-flex min-h-10 items-center gap-2 rounded-full border border-white/15 bg-white/[0.035] px-4 py-2 text-[9px] font-semibold uppercase tracking-[0.12em] text-white/75 transition-colors hover:border-[#F5B544]/50 hover:text-[#FACC6B] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F5B544]">
					<svg data-pause-icon class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3.5h2.6v9H4zm5.4 0H12v9H9.4z" /></svg>
					<svg data-play-icon class="hidden h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" /></svg>
					<span data-toggle-label>Pause</span>
				</button>
			</div>
		</div>
	</div>


	<StitchLine class="pointer-events-none absolute inset-x-8 bottom-4 text-[#F5B544]" step={18} opacity={0.24} />

	<!-- Décors de couture (purement décoratifs) -->
	<SewingDecor variant="mannequin" class="pointer-events-none absolute right-4 top-[30%] hidden h-24 w-24 text-[#F5B544] opacity-[0.12] xl:block" />
	<SewingDecor variant="zipper" class="pointer-events-none absolute left-4 bottom-20 hidden h-16 w-16 text-[#F5B544] opacity-[0.13] xl:block" />
	<SewingDecor variant="chalk" class="pointer-events-none absolute right-[30%] bottom-6 hidden h-16 w-16 text-[#F5B544] opacity-[0.14] lg:block" />
	<SewingDecor variant="spool" class="pointer-events-none absolute left-5 top-4 hidden h-14 w-14 text-[#F5B544] opacity-[0.10] lg:block" />
	<SewingDecor variant="needle" class="pointer-events-none absolute bottom-4 right-5 hidden h-16 w-16 rotate-[10deg] text-[#F5B544] opacity-[0.16] xl:block" />
</section>

<script>
	// Scopé par instance : chaque carrousel pilote son propre bouton.
	document.querySelectorAll<HTMLElement>('[data-services-carousel]').forEach((carousel) => {
		const toggle = carousel.querySelector<HTMLButtonElement>('[data-services-toggle]');
		const pauseIcon = carousel.querySelector<SVGElement>('[data-pause-icon]');
		const playIcon = carousel.querySelector<SVGElement>('[data-play-icon]');
		const toggleLabel = carousel.querySelector<HTMLElement>('[data-toggle-label]');

		toggle?.addEventListener('click', () => {
			const paused = carousel.classList.toggle('is-paused');
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.setAttribute('aria-label', paused ? 'Reprendre le défilement' : 'Mettre le défilement en pause');
			if (toggleLabel) toggleLabel.textContent = paused ? 'Lecture' : 'Pause';
			pauseIcon?.classList.toggle('hidden', paused);
			playIcon?.classList.toggle('hidden', !paused);
		});
	});
</script>

<style>
	.services-marquee {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent 0%, #000 4%, #000 96%, transparent 100%);
	}

	.services-track {
		display: flex;
		width: max-content;
		/* Transform GPU : évite les micro-saccades de repaint pendant le défilement. */
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
		will-change: transform;
		animation: services-marquee 60s linear infinite;
	}

	.services-track-group {
		display: flex;
		flex: none;
		gap: 1.25rem;
		/* Le remplissage de fin fait la même largeur que les gouttières internes :
		   le raccord entre les deux groupes est invisible. */
		padding-right: 1.25rem;
	}

	.service-card {
		flex: 0 0 clamp(270px, 27vw, 340px);
		transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease;
	}

	.service-card:hover,
	.service-card:focus-within {
		transform: translateY(-4px);
		border-color: rgba(250, 204, 107, 0.62);
		box-shadow: 0 25px 52px rgba(0, 0, 0, 0.36), 0 0 18px rgba(245, 181, 68, 0.07);
	}

	.service-card-img { transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1); }
	.service-card:hover .service-card-img,
	.service-card:focus-within .service-card-img { transform: scale(1.035); }

	/*
	 * Le défilement ne s'arrête QUE via le bouton Pause.
	 * Avant, le survol et le focus le figeaient : dès qu'on approchait la souris
	 * ou qu'on cliquait une carte, le bandeau restait arrêté et semblait cassé.
	 */
	.services-carousel.is-paused .services-track { animation-play-state: paused; }

	@keyframes services-marquee {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(-50%, 0, 0); }
	}

	/*
	 * Mouvement réduit : le bandeau continue de défiler (c'est le principe même
	 * du carrousel), mais beaucoup plus lentement, et les effets de survol sont
	 * neutralisés. Le bouton Pause reste disponible.
	 */
	@media (prefers-reduced-motion: reduce) {
		.services-track { animation-duration: 200s; }
		.service-card,
		.service-card-img { transition: none; }
		.service-card:hover,
		.service-card:focus-within { transform: none; }
		.service-card:hover .service-card-img,
		.service-card:focus-within .service-card-img { transform: none; }
	}
</style>
