---
import { SERVICES } from '../lib/services';

const featuredSlugs = new Set([
	'toges-graduation',
	'uniformes-scolaires',
	'tenue-travail',
	'blouses-medicales',
]);
const featuredServices = SERVICES.filter(({ slug }) => featuredSlugs.has(slug));
---

<section
	id="services"
	class="relative z-10 scroll-mt-24 rounded-[2rem] px-6 py-20 text-white premium-section md:rounded-[3rem] md:py-28"
	lang="fr"
	aria-labelledby="services-heading"
>
	<div class="mx-auto max-w-7xl">
		<header class="mx-auto mb-12 max-w-3xl text-center md:mb-16">
			<p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-primary md:text-xs">Nos services</p>
			<h2 id="services-heading" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl lg:text-5xl">
				La confection adaptée à votre activité
			</h2>
			<p class="mt-5 text-base leading-relaxed text-foreground/70 md:text-lg">
				Uniformes et tenues personnalisables pour les établissements scolaires, les cérémonies, les entreprises et les professionnels de santé.
			</p>
		</header>

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{featuredServices.map((service) => (
				<article class="service-card group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]">
					<a href={`/services/${service.slug}`} class="block overflow-hidden" aria-label={`Découvrir : ${service.title}`}>
						<div class="aspect-[4/3] overflow-hidden bg-surface/40">
							<img
								src={service.image}
								alt={service.title}
								class="service-card-img h-full w-full object-cover"
								width="640"
								height="480"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</a>
					<div class="p-5 md:p-6">
						<h3 class="font-display text-lg font-semibold leading-snug md:text-xl">
							<a href={`/services/${service.slug}`} class="hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
								{service.title}
							</a>
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-foreground/70">{service.description}</p>
						<a href={`/services/${service.slug}`} class="mt-5 inline-flex min-h-10 items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary hover:text-primary-light">
							Voir le service <span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))}
		</div>

		<div class="mt-9 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-7 text-center sm:flex-row sm:text-left">
			<p class="text-sm text-foreground/70">Vous avez un besoin particulier ou souhaitez explorer les autres services ?</p>
			<a href="/services" class="inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-background hover:bg-primary-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
				Tous nos services
			</a>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.service-card,
		.service-card-img {
			transition: transform 220ms ease, border-color 220ms ease;
		}

		.service-card:hover {
			transform: translateY(-3px);
			border-color: rgba(250, 204, 107, 0.35);
		}

		.service-card:hover .service-card-img {
			transform: scale(1.025);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.service-card,
		.service-card-img {
			transition: none;
		}
	}
</style>
