---
import Picture from './Picture.astro';
/**
 * Hero « vitrine » reproduit d'après la référence Xriver Home 03.
 * Composition : grand titre condensé à gauche, portrait dominant à droite,
 * texte descriptif, carte projet, bouton circulaire, barre sociale verticale
 * et image secondaire qui déborde sur la section suivante.
 * Palette de marque : bleu nuit (#00001C) et or (#D4AF37).
 */

/**
 * Silhouettes détourées du hero. Les fichiers vivent dans public/images/hero-slides
 * (PNG transparents) et une version WebP ~12x plus légère est générée à côté
 * avec `node scripts/optimize-hero-images.mjs`. Le WebP est servi en priorité,
 * le PNG sert de repli.
 */
const slides = [
	{ name: 'cutout-business-suit', width: 1152, height: 2064, label: 'Uniforme scolaire', alt: 'Élève en uniforme scolaire bordeaux et gris, en pied' },
	{ name: 'cutout-graduation-gown', width: 1152, height: 2064, label: 'Toges de graduation', alt: 'Diplômée en toge bleu nuit et or, en pied' },
	{ name: 'cutout-workwear', width: 1152, height: 2064, label: 'Tenues de travail', alt: 'Professionnel en tenue de travail bleu nuit, en pied' },
	{ name: 'cutout-medical', width: 1152, height: 2064, label: 'Blouses médicales', alt: 'Professionnelle de santé en blouse blanche, en pied' },
	{ name: 'cutout-sport', width: 1152, height: 2064, label: 'Tenue de travail', alt: 'Professionnel en tenue de travail grise tenant un casque, en pied' },
].map((slide) => ({
	...slide,
	webp: `/images/hero-slides/${slide.name}.webp`,
	png: `/images/hero-slides/${slide.name}.png`,
}));

// Les questions sont déjà prêtes dans WhatsApp : le client n'a qu'à compléter sa demande.
const projectMessage = [
	'Bonjour Confection Univers, je souhaite discuter d’un projet sur mesure.',
	'',
	'Type de tenue : ',
	'Quantité souhaitée : ',
	'Personnalisation / logo : ',
	'Date souhaitée : ',
	'Ville de livraison : ',
].join('\n');
const projectWhatsAppHref = `https://wa.me/221772960776?text=${encodeURIComponent(projectMessage)}`;

const social = [
	{ label: 'Instagram', href: 'https://instagram.com/confectionunivers', icon: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 2a2.5 2.5 0 100 5 2.5 2.5 0 000-5z' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/company/confectionunivers', icon: 'M4 3a2 2 0 110 4 2 2 0 010-4zm-1 6h3v12H3V9zm6 0h3v2c.5-1 1.8-2 3.6-2C19.5 9 21 10.5 21 13.5V21h-3v-6.5c0-1.6-.6-2.5-2-2.5s-2.5 1-2.5 2.6V21H9V9z' },
	{ label: 'Facebook', href: 'https://facebook.com/confectionunivers', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
	{ label: 'WhatsApp', href: 'https://wa.me/221772960776', icon: 'M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z' },
];
---

<section id="hero-cu" class="hero-cu relative z-20 min-h-[100svh] w-full text-white" aria-label="Accueil">
	<!-- Défilé de l'atelier : lumière et podium sous les silhouettes détourées. -->
	<div class="hero-bg pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
		<div class="hero-shade absolute inset-0"></div>
		<div class="glow glow-1"></div>
		<div class="glow glow-2"></div>
		<div class="glow glow-3"></div>

		<div class="hero-photos">
			<div class="runway-stage">
				<span class="runway-beam"></span>
				<span class="runway-halo"></span>
				<span class="runway-floor"></span>
				<span class="runway-number" data-runway-number>01</span>
			</div>
			{
				slides.map((s, idx) => (
					<picture
						data-slide
						data-label={s.label}
						class:list={['hero-photo', idx === 0 && 'is-active']}
					>
						<source srcset={s.webp} type="image/webp" />
						<img
							src={s.png}
							alt=""
							width={s.width}
							height={s.height}
							loading={idx < 2 ? 'eager' : 'lazy'}
							fetchpriority={idx === 0 ? 'high' : 'auto'}
							decoding="async"
						/>
					</picture>
				))
			}
			<span class="runway-sweep"></span>
			<span class="runway-pulse"></span>
			<div class="runway-tag">
				<span class="runway-tag-pin"></span>
				<span class="runway-tag-eyebrow">PIÈCE <span data-runway-tag-number>01</span> / {String(slides.length).padStart(2, '0')}</span>
				<span class="runway-tag-name" data-runway-tag-name>{slides[0].label}</span>
				<span class="runway-tag-signature">ATELIER · SÉNÉGAL</span>
			</div>
		</div>
	</div>

	<div class="hero-layout">
		<!-- Titre et description restent dans un même flux pour éviter tout chevauchement -->
		<div class="hero-copy">
			<div class="reveal hero-title">
				<h1 class="title-gradient uppercase hero-h1"><span class="block">Confection</span><span class="block">Univers</span></h1>
				<p class="subtitle font-anton uppercase hero-sub">
					Confection de vêtements professionnels - Sénégal
				</p>
			</div>

			<!-- Texte descriptif -->
			<div class="reveal reveal-d1 hero-desc text-white/90">
				<p class="hero-lead">
					Vêtements de qualité supérieure fabriqués avec précision. Designs personnalisés adaptés à vos spécifications.
					Production en gros fiable pour les institutions et entreprises de toutes tailles.
				</p>
				<div class="hero-actions">
					<a href="/contact" class="hero-btn hero-btn-primary">Demander un devis</a>
					<a href="/catalogue" class="hero-btn hero-btn-ghost">Voir nos produits</a>
				</div>
					<ul class="hero-badges" aria-label="Nos produits">
						<li>Uniformes scolaires</li>
						<li>Toges de graduation</li>
						<li>Tenues de travail</li>
						<li>Blouses médicales</li>
						<li>Tenues de sport</li>
						<li>Costumes africains</li>
					</ul>
			</div>
		</div>

		<!-- Une seule action : décrire son projet dans un message WhatsApp prérempli. -->
		<a
			href={projectWhatsAppHref}
			target="_blank"
			rel="noopener noreferrer"
			class="start-card reveal reveal-d2"
			aria-label="Décrire mon projet sur mesure sur WhatsApp (nouvel onglet)"
		>
			<span class="card-img" aria-hidden="true">
				<img src="/images/production-atelier.jpg" alt="" width="700" height="553" loading="lazy" decoding="async" />
			</span>
			<span class="start-card-copy">
				<span class="font-anton card-title uppercase">Projet sur mesure ?</span>
				<span class="card-description">Tenue · quantité · délai</span>
				<span class="card-action">
					<span class="card-action-text">Décrire mon projet <span class="card-action-platform">sur WhatsApp</span></span>
					<span class="card-action-arrow" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
					</span>
				</span>
			</span>
		</a>

		<!-- Bouton circulaire -->
		<a
			href="/services"
			class="circle-cta"
			aria-label="Habillez votre réussite — découvrir nos services"
		>
			<span class="relative z-10 text-center text-[11px] font-medium leading-tight tracking-wide">Habillez<br />votre<br />réussite</span>
		</a>

		<!-- Navigation du diaporama, visible aussi sur mobile. -->
		<div class="hero-slide-controls" role="group" aria-label="Parcourir les créations">
			<div class="hero-slide-info">
				<div class="hero-slide-kicker">
					<span class="hero-slide-kicker-label">Nos collections</span>
					<span class="hero-slide-index" aria-hidden="true"><span data-slide-number>01</span> / {String(slides.length).padStart(2, '0')}</span>
				</div>
				<span class="hero-slide-name" data-slide-name>{slides[0].label}</span>
			</div>
			<div class="hero-slide-actions">
				<button type="button" class="hero-slide-action" data-slide-prev aria-label="Voir l’image précédente">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg>
				</button>
				<button type="button" class="hero-slide-action" data-slide-next aria-label="Voir l’image suivante">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg>
				</button>
			</div>
			<span class="hero-slide-progress" aria-hidden="true"><span data-slide-progress></span></span>
			<span class="sr-only" role="status" aria-live="polite" data-slide-status></span>
		</div>

		<!-- Vignette portfolio : cadrée sur le sujet et liée à la collection. -->
		<a
			href="/collections/toges-graduation"
			class="secondary-img reveal reveal-d3"
			aria-label="Découvrir nos toges de graduation"
		>
			<Picture src="/images/hero-toges-graduation.jpg" alt="Diplômée portant une tenue et une toge de graduation Confection Univers" class="h-full w-full object-cover" sizes="(min-width: 1024px) 40vw, 90vw" loading="lazy" />
			<span class="secondary-img-shade" aria-hidden="true"></span>
			<span class="secondary-img-copy" aria-hidden="true">
				<span class="secondary-img-kicker">Nos réalisations</span>
				<span class="secondary-img-title">Toges de graduation</span>
			</span>
			<span class="secondary-img-arrow" aria-hidden="true">
				<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" /></svg>
			</span>
		</a>
	</div>

	<!-- Barre sociale verticale (grand écran) -->
	<aside
		class="social-bar"
		aria-label="Réseaux sociaux et visuels"
	>
		<a href="#hero-cu" class="round-btn flex h-12 w-12 items-center justify-center rounded-full" aria-label="Haut de page">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 15l6-6 6 6" /></svg>
		</a>

		<div class="flex flex-col items-center gap-3">
			{
				social.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" class="social-btn flex h-[30px] w-[30px] items-center justify-center rounded-full" aria-label={s.label}>
						<svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
					</a>
				))
			}
		</div>

		<p class="vertical-label font-anton text-[13px] uppercase tracking-[0.2em] text-white/90">Follow us :</p>

		<div class="flex flex-col items-center gap-3">
			{
				slides.map((s, idx) => (
					<button type="button" data-thumb class:list={['thumb relative h-12 w-12 rounded-full', idx === 0 && 'is-active']} aria-label={`Afficher ${s.label}`} aria-pressed={idx === 0}>
						<Picture src={s.webp} alt="" class="h-full w-full rounded-full object-cover object-top" sizes="96px" width={s.width} height={s.height} loading="lazy" />
						<span class="thumb-num absolute -right-1 -top-1 rounded-[4px] px-1 font-anton text-[10px] leading-[16px]">
							{String(idx + 1).padStart(2, '0')}
						</span>
					</button>
				))
			}
		</div>
	</aside>
</section>

<script>
	import gsap from 'gsap';
	import { initHeroFx } from '../scripts/hero-fx';

	const root = document.getElementById('hero-cu');
	if (root) {
		initHeroFx(root);
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
		const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
		const controls = root.querySelector<HTMLElement>('.hero-slide-controls')!;
		const socialBar = root.querySelector<HTMLElement>('.social-bar')!;
		const beam = root.querySelector<HTMLElement>('.runway-beam')!;
		const halo = root.querySelector<HTMLElement>('.runway-halo')!;
		const floor = root.querySelector<HTMLElement>('.runway-floor')!;
		const sweep = root.querySelector<HTMLElement>('.runway-sweep')!;
		const pulse = root.querySelector<HTMLElement>('.runway-pulse')!;
		const tag = root.querySelector<HTMLElement>('.runway-tag')!;
		const lookNumber = root.querySelector<HTMLElement>('[data-runway-number]')!;
		const tagNumber = root.querySelector<HTMLElement>('[data-runway-tag-number]')!;
		const tagName = root.querySelector<HTMLElement>('[data-runway-tag-name]')!;
		const progress = root.querySelector<HTMLElement>('[data-slide-progress]')!;
		const label = root.querySelector<HTMLElement>('[data-slide-name]')!;
		const number = root.querySelector<HTMLElement>('[data-slide-number]')!;
		const status = root.querySelector<HTMLElement>('[data-slide-status]')!;
		const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const compact = window.matchMedia('(max-width: 767px)');
		const HOLD_SECONDS = 6.2;
		let current = 0;
		let transition: gsap.core.Timeline | undefined;
		let hold: gsap.core.Tween | undefined;
		let inView = true;
		let pointerOnControls = false;
		let focusOnControls = false;

		const isPaused = () => motion.matches || document.hidden || !inView || pointerOnControls || focusOnControls;

		const updateUI = (manual = false, animate = false) => {
			const name = slides[current].dataset.label ?? '';
			const index = String(current + 1).padStart(2, '0');
			gsap.killTweensOf([label, number]);
			gsap.set([label, number], { clearProps: 'all' });
			label.textContent = name;
			number.textContent = index;
			tagName.textContent = name;
			tagNumber.textContent = index;
			lookNumber.textContent = index;
			thumbs.forEach((thumb, thumbIndex) => {
				thumb.classList.toggle('is-active', thumbIndex === current);
				thumb.setAttribute('aria-pressed', String(thumbIndex === current));
			});
			if (animate && !motion.matches) {
				gsap.fromTo([number, label], { opacity: 0, y: 8 }, {
					opacity: 1, y: 0, duration: 0.55, delay: 0.3, stagger: 0.08,
					ease: 'power3.out', clearProps: 'all',
				});
			}
			// Annoncer uniquement les changements demandés par l'utilisateur, pas le défilement automatique.
			if (manual) status.textContent = `Image ${current + 1} sur ${slides.length} : ${name}`;
		};

		const resetVisuals = () => {
			gsap.set(slides, { clearProps: 'all' });
			gsap.set([beam, halo, floor, sweep, pulse, tag, lookNumber], { clearProps: 'all' });
			slides.forEach((slide, index) => {
				slide.classList.remove('is-exiting');
				slide.classList.toggle('is-active', index === current);
			});
		};

		const startHold = () => {
			if (hold) hold.kill();
			hold = undefined;
			gsap.set(progress, { clipPath: 'inset(0 100% 0 0)' });
			if (motion.matches || slides.length < 2) return;
			hold = gsap.to(progress, {
				clipPath: 'inset(0 0% 0 0)',
				duration: HOLD_SECONDS,
				ease: 'none',
				onComplete: () => {
					hold = undefined;
					show(current + 1, true);
				},
			});
			if (isPaused()) hold.pause();
		};

		const show = (requestedIndex: number, forward: boolean, manual = false) => {
			if (slides.length < 2) return;
			const next = ((requestedIndex % slides.length) + slides.length) % slides.length;
			if (next === current) {
				if (manual && !transition) startHold();
				return;
			}

			hold?.kill();
			hold = undefined;
			transition?.kill();
			transition = undefined;
			// Un nouveau clic pendant la transition repart de l'image sélectionnée,
			// sans laisser de masque ni de silhouette fantôme à l'écran.
			resetVisuals();
			const outgoing = slides[current];
			const incoming = slides[next];
			current = next;
			outgoing.classList.remove('is-active');
			outgoing.classList.add('is-exiting');
			incoming.classList.add('is-active');
			updateUI(manual, true);
			gsap.set(progress, { clipPath: 'inset(0 100% 0 0)' });

			if (motion.matches) {
				resetVisuals();
				return;
			}

			// L'ancien look recule dans l'ombre ; le suivant avance sous le projecteur.
			// Sur téléphone, la profondeur est volontairement plus discrète.
			const small = compact.matches;
			const shift = small ? 4 : 9;
			gsap.set(outgoing, { opacity: 1, scale: 1, xPercent: 0, yPercent: 0, rotateY: 0, transformOrigin: '55% 100%' });
			gsap.set(incoming, {
				opacity: 0, scale: small ? 0.94 : 0.82, xPercent: forward ? shift : -shift,
				yPercent: small ? 4 : 11, rotateY: small ? 0 : (forward ? -10 : 10),
				transformPerspective: 1100, transformOrigin: '55% 100%',
			});

			transition = gsap.timeline({
				onComplete: () => {
					resetVisuals();
					transition = undefined;
					startHold();
				},
			});
			transition
				.to(outgoing, {
					opacity: 0, scale: small ? 0.94 : 0.86, xPercent: forward ? -shift : shift,
					yPercent: small ? 2 : 7, rotateY: small ? 0 : (forward ? 10 : -10),
					duration: 0.9, ease: 'power2.in',
				}, 0)
				.to(incoming, { opacity: 1, duration: 0.9, ease: 'power2.inOut' }, 0.24)
				.to(incoming, {
					scale: 1, xPercent: 0, yPercent: 0, rotateY: 0,
					duration: 1.35, ease: 'power3.out',
				}, 0.24)
				.fromTo(beam, { opacity: 0.42, scaleX: 0.88 }, {
					opacity: 0.95, scaleX: 1.08, duration: 0.7, ease: 'power2.out', yoyo: true, repeat: 1,
				}, 0)
				.fromTo(halo, { opacity: 0.35, scale: 0.94 }, {
					opacity: 0.85, scale: 1.05, duration: 0.72, ease: 'power2.out', yoyo: true, repeat: 1,
				}, 0)
				.fromTo(floor, { opacity: 0.45, scale: 0.9 }, {
					opacity: 1, scale: 1, duration: 1.2, ease: 'power2.out',
				}, 0.2)
				.fromTo(sweep, { opacity: 0, xPercent: forward ? -280 : 280 }, {
					opacity: 0.75, xPercent: forward ? 280 : -280, duration: 0.65, ease: 'power2.inOut',
				}, 0.16)
				.to(sweep, { opacity: 0, duration: 0.35, ease: 'power2.out' }, 0.81)
				.fromTo(pulse, { opacity: 0, scale: 0.5 }, {
					opacity: 0.7, scale: 1, duration: 0.32, ease: 'power2.out',
				}, 0.81)
				.to(pulse, { opacity: 0, scale: 1.5, duration: 0.55, ease: 'power2.out' }, 1.13)
				.fromTo(tag, { opacity: 0, y: -20, rotation: -12 }, {
					opacity: 1, y: 0, rotation: -4, duration: 0.85, ease: 'back.out(1.2)',
				}, 0.32)
				.fromTo(lookNumber, { opacity: 0, xPercent: forward ? 8 : -8, scale: 1.1 }, {
					opacity: 0.8, xPercent: 0, scale: 1, duration: 0.85, ease: 'power3.out',
				}, 0.24);
		};

		const syncPlayback = () => {
			if (hold) {
				if (isPaused()) hold.pause();
				else hold.resume();
			} else if (!transition && !motion.matches) {
				startHold();
			}
		};

		root.querySelector('[data-slide-prev]')?.addEventListener('click', () => show(current - 1, false, true));
		root.querySelector('[data-slide-next]')?.addEventListener('click', () => show(current + 1, true, true));
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index, index >= current, true)));
		controls.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
				event.preventDefault();
				show(current + (event.key === 'ArrowRight' ? 1 : -1), event.key === 'ArrowRight', true);
			}
		});

		// L'animation continue si la souris survole simplement le hero ; elle ne
		// s'arrête que pendant l'utilisation des commandes ou hors de l'écran.
		for (const area of [controls, socialBar]) {
			area.addEventListener('pointerenter', () => { pointerOnControls = true; syncPlayback(); });
			area.addEventListener('pointerleave', () => { pointerOnControls = false; syncPlayback(); });
			area.addEventListener('focusin', () => { focusOnControls = true; syncPlayback(); });
			area.addEventListener('focusout', () => {
				queueMicrotask(() => {
					focusOnControls = [controls, socialBar].some((el) => el.contains(document.activeElement));
					syncPlayback();
				});
			});
		}
		document.addEventListener('visibilitychange', syncPlayback);
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(([entry]) => {
				inView = entry.isIntersecting;
				syncPlayback();
			}, { threshold: 0.15 }).observe(root);
		}
		motion.addEventListener('change', () => {
			if (motion.matches) {
				hold?.kill();
				hold = undefined;
				transition?.kill();
				transition = undefined;
				gsap.killTweensOf([label, number]);
				gsap.set([label, number], { clearProps: 'all' });
				resetVisuals();
				gsap.set(progress, { clipPath: 'inset(0 100% 0 0)' });
			} else startHold();
		});

		updateUI();
		startHold();
	}
</script>

<style>
	/* ---------- Typographie ---------- */
	.font-anton {
		font-family: 'Anton', 'Space Grotesk', sans-serif;
	}

	.hero-cu .subtitle {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-weight: 500;
		letter-spacing: 0.16em;
	}

	/* Titre : blanc vers or champagne (équivalent du dégradé rose de la référence) */
	.title-gradient {
		background: linear-gradient(180deg, #ffffff 0%, #fff6d5 42%, #facc6b 78%, #d4af37 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: none;
		filter: drop-shadow(0 8px 26px rgba(0, 0, 20, 0.45));
	}

	.subtitle {
		color: #ffffff;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
	}

	/* ---------- Fond bleu conservé sous les silhouettes détourées ---------- */
	.hero-bg {
		/* Le décor (dont la photo) reste sous le texte du hero. */
		z-index: 0;
		background-color: #00001C;
	}

	.glow {
		position: absolute;
		z-index: 1;
		border-radius: 9999px;
		filter: blur(110px);
		animation: cu-float 16s ease-in-out infinite;
	}
	.glow-1 { left: -8%; top: 0; width: 46vw; height: 46vw; background: #2236a8; opacity: 0.45; }
	.glow-2 { left: 28%; bottom: 0; width: 30vw; height: 30vw; background: #D4AF37; opacity: 0.18; animation-delay: -5s; }
	.glow-3 { right: 20%; top: 20%; width: 26vw; height: 26vw; background: #3d6bff; opacity: 0.22; animation-delay: -9s; }

	.hero-shade {
		z-index: 0;
		background:
			linear-gradient(90deg, #00001C 0%, rgba(0, 0, 28, 0.85) 30%, rgba(0, 0, 28, 0.25) 60%, rgba(0, 0, 28, 0) 75%),
			linear-gradient(0deg, #00001C 0%, rgba(0, 0, 28, 0) 22%);
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		transform: scale(1.025);
		transform-origin: 55% bottom;
		filter: saturate(1.04) contrast(1.02) drop-shadow(0 18px 36px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 24px rgba(212, 175, 55, 0.1));
	}

	/* Le <picture> gère l'animation, l'<img> gère le cadrage de la silhouette. */
	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: 75% bottom;
	}

	.hero-photo.is-active {
		z-index: 3;
		opacity: 1;
		transform: scale(1);
	}

	.hero-photo.is-exiting {
		z-index: 2;
		opacity: 1;
	}

	.hero-photo.is-active,
	.hero-photo.is-exiting {
		will-change: transform, opacity;
	}

	/* Décor de podium : patron circulaire, faisceau et lumière au sol. */
	.runway-stage {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	.runway-beam {
		position: absolute;
		inset: 0;
		opacity: 0.72;
		transform-origin: 67% 0;
		background:
			radial-gradient(ellipse 18% 10% at 67% 0, rgba(255, 247, 218, 0.3), transparent 95%),
			radial-gradient(ellipse 40% 82% at 67% 20%, rgba(255, 237, 190, 0.22), rgba(250, 204, 107, 0.08) 46%, transparent 78%);
		mix-blend-mode: screen;
	}

	.runway-halo {
		position: absolute;
		right: 3%;
		bottom: 11%;
		width: 72%;
		height: 76%;
		opacity: 0.6;
		border: 1px dashed rgba(255, 226, 163, 0.28);
		border-radius: 50%;
		background: radial-gradient(ellipse at 50% 62%, rgba(212, 175, 55, 0.12), transparent 66%);
		box-shadow: 0 0 50px rgba(212, 175, 55, 0.07), inset 0 0 65px rgba(212, 175, 55, 0.06);
	}

	.runway-floor {
		position: absolute;
		right: 4%;
		bottom: -9%;
		width: 78%;
		height: 33%;
		border-radius: 50%;
		border-top: 2px solid rgba(255, 223, 154, 0.5);
		transform: perspective(460px) rotateX(68deg);
		background: radial-gradient(ellipse at 50% 30%, rgba(255, 214, 121, 0.36), rgba(212, 175, 55, 0.1) 42%, transparent 72%);
		box-shadow: 0 -12px 45px rgba(212, 175, 55, 0.12);
	}

	.runway-number {
		position: absolute;
		right: 7%;
		top: 26%;
		color: transparent;
		font-family: 'Anton', 'Space Grotesk', sans-serif;
		font-size: clamp(11rem, 23vw, 22rem);
		line-height: 1;
		letter-spacing: -0.08em;
		-webkit-text-stroke: 1px rgba(255, 231, 170, 0.26);
		text-shadow: 0 0 34px rgba(250, 204, 107, 0.05);
	}

	/* Un reflet traverse le look, puis l'onde du podium marque son arrivée. */
	.runway-sweep {
		position: absolute;
		z-index: 4;
		top: 0;
		bottom: 0;
		left: 37%;
		width: 26%;
		opacity: 0;
		transform: skewX(-12deg);
		background: linear-gradient(90deg, transparent, rgba(255, 238, 190, 0.32), transparent);
		filter: blur(14px);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.runway-pulse {
		position: absolute;
		z-index: 4;
		right: 15%;
		bottom: 0;
		width: 64%;
		height: 19%;
		opacity: 0;
		border: 1px solid rgba(255, 225, 154, 0.75);
		border-radius: 50%;
		box-shadow: 0 0 25px rgba(250, 204, 107, 0.35);
		pointer-events: none;
	}

	/* Étiquette de collection suspendue à côté du mannequin. */
	.runway-tag {
		position: absolute;
		z-index: 5;
		left: 27%;
		top: 16%;
		display: flex;
		flex-direction: column;
		gap: 7px;
		width: clamp(150px, 14vw, 202px);
		padding: 20px 16px 16px 19px;
		transform: rotate(-4deg);
		transform-origin: 17px 12px;
		border: 1px solid rgba(236, 196, 113, 0.82);
		border-radius: 4px 4px 14px 4px;
		background: linear-gradient(145deg, #fff9e8, #e8d8b1);
		box-shadow: 0 20px 45px rgba(0, 0, 20, 0.38), 0 0 28px rgba(250, 204, 107, 0.14);
		color: #0e1431;
	}

	.runway-tag::before {
		content: '';
		position: absolute;
		inset: 6px;
		border: 1px dashed rgba(150, 106, 38, 0.4);
		border-radius: 2px 2px 9px 2px;
	}

	.runway-tag::after {
		content: '';
		position: absolute;
		top: -22px;
		left: 16px;
		height: 22px;
		border-left: 1px dashed rgba(255, 231, 174, 0.75);
	}

	.runway-tag-pin {
		position: absolute;
		left: 11px;
		top: 10px;
		width: 9px;
		height: 9px;
		border: 2px solid #af873e;
		border-radius: 50%;
		background: #091333;
	}

	.runway-tag-eyebrow,
	.runway-tag-signature {
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.runway-tag-eyebrow {
		color: #a4772a;
	}

	.runway-tag-name {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(13px, 1.1vw, 17px);
		font-weight: 700;
		line-height: 1.12;
		text-wrap: balance;
	}

	.runway-tag-signature {
		color: #6d6a61;
		font-size: 8px;
		letter-spacing: 0.11em;
	}

	/* ---------- Scène photo : hauteur complète et silhouettes sans rognage ---------- */
	.hero-photos {
		position: absolute;
		top: 112px;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		height: calc(100% - 112px);
		overflow: hidden;
	}

	.hero-layout {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		margin: 0 auto;
		padding: 46svh 6% 3.5rem;
	}

	/* Une petite console éditoriale relie la silhouette, son nom et la navigation. */
	.hero-slide-controls {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		align-self: flex-end;
		gap: 8px;
		width: min(61%, 238px);
		min-height: 72px;
		margin-top: 1.25rem;
		padding: 11px 12px 15px;
		border: 1px solid rgba(250, 204, 107, 0.38);
		border-radius: 18px;
		background: linear-gradient(125deg, rgba(16, 24, 54, 0.92), rgba(0, 0, 28, 0.8));
		box-shadow: 0 20px 45px rgba(0, 0, 12, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.hero-slide-controls::before {
		content: '';
		position: absolute;
		top: 0;
		left: 18px;
		right: 18px;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 231, 174, 0.9), transparent);
	}

	.hero-slide-info {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.hero-slide-kicker {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		color: #facc6b;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.hero-slide-index {
		color: #f7f5f0;
		font-variant-numeric: tabular-nums;
	}

	.hero-slide-name {
		min-width: 0;
		overflow: hidden;
		color: #fff;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 12px;
		font-weight: 600;
		line-height: 1.2;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* La jauge remplit les points de couture un à un, sans étirer leur motif. */
	.hero-slide-progress {
		position: absolute;
		right: 12px;
		bottom: 0;
		left: 12px;
		height: 5px;
		overflow: hidden;
		background: radial-gradient(ellipse 4px 1.5px at 4px 50%, rgba(250, 204, 107, 0.3) 98%, transparent 100%) 0 0 / 12px 5px repeat-x;
	}

	.hero-slide-progress > span {
		display: block;
		width: 100%;
		height: 100%;
		clip-path: inset(0 100% 0 0);
		background: radial-gradient(ellipse 4px 1.5px at 4px 50%, #facc6b 98%, transparent 100%) 0 0 / 12px 5px repeat-x;
	}

	.hero-slide-actions {
		display: flex;
		flex-shrink: 0;
		gap: 4px;
	}

	.hero-slide-action {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px solid rgba(250, 204, 107, 0.48);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		color: #facc6b;
		cursor: pointer;
		transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
	}

	.hero-slide-action svg {
		width: 16px;
		height: 16px;
	}

	.hero-slide-action:hover {
		transform: translateY(-2px);
		border-color: #facc6b;
		background: #facc6b;
		color: #00001c;
	}

	.hero-slide-action:focus-visible,
	.thumb:focus-visible {
		outline: 2px solid #fff4d0;
		outline-offset: 3px;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
	}

	.hero-title {
		position: relative;
	}

	.hero-h1 {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		font-size: 12vw;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.hero-sub {
		margin-top: 0.25rem;
		font-size: 7vw;
		line-height: 1;
	}

	.hero-desc {
		margin-top: 2rem;
		max-width: 24rem;
		font-size: 15px;
		line-height: 1.5;
	}

	.hero-lead {
		margin: 0 0 1.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 22px;
		border-radius: 9999px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
	}

	.hero-btn-primary {
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		color: #00001C;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 10px 24px -10px rgba(212, 175, 55, 0.7);
	}

	.hero-btn-ghost {
		border: 1px solid rgba(255, 255, 255, 0.4);
		color: #ffffff;
		background: rgba(0, 0, 20, 0.35);
		backdrop-filter: blur(6px);
	}

	.hero-btn:hover {
		transform: translateY(-2px);
	}

	.hero-btn-ghost:hover {
		border-color: #D4AF37;
		color: #FACC6B;
	}

	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0;
		list-style: none;
	}

	.hero-badges li {
		padding: 5px 12px;
		border-radius: 9999px;
		border: 1px solid rgba(212, 175, 55, 0.4);
		background: rgba(0, 0, 28, 0.5);
		color: #FFE9A8;
		font-size: 12px;
		font-weight: 600;
	}

	/* Carte de contact, dans le prolongement des finitions bleu nuit et or du hero. */
	.start-card {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: stretch;
		width: min(250px, 100%);
		min-height: 110px;
		margin-top: 2rem;
		overflow: hidden;
		border: 1px solid rgba(250, 204, 107, 0.48);
		border-radius: 16px;
		background: linear-gradient(135deg, rgba(26, 39, 79, 0.97), rgba(5, 11, 37, 0.97));
		box-shadow: 0 20px 45px -16px rgba(0, 0, 20, 0.82), inset 0 1px rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(12px);
		color: #fff;
		text-decoration: none;
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.start-card::before {
		content: '';
		position: absolute;
		z-index: 2;
		top: 0;
		right: 9%;
		left: 35%;
		height: 1px;
		background: linear-gradient(90deg, transparent, #facc6b, transparent);
		pointer-events: none;
	}

	.start-card:hover {
		border-color: #facc6b;
		box-shadow: 0 24px 50px -16px rgba(0, 0, 20, 0.85), 0 0 22px rgba(250, 204, 107, 0.13);
	}

	.start-card:focus-visible {
		outline: 2px solid #fff4d0;
		outline-offset: 4px;
	}

	.card-img {
		position: relative;
		width: 76px;
		min-height: 112px;
		align-self: stretch;
		flex-shrink: 0;
		overflow: hidden;
	}

	.card-img img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% center;
		transition: transform 0.35s ease;
	}

	.card-img::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(5, 11, 37, 0.05), rgba(5, 11, 37, 0.2) 58%, rgba(5, 11, 37, 0.8));
		pointer-events: none;
	}

	.start-card:hover .card-img img {
		transform: scale(1.07);
	}

	.start-card-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 3px;
		min-width: 0;
		padding: 11px 12px;
	}

	.card-title {
		font-size: clamp(15px, 1.15vw, 18px);
		line-height: 1.05;
	}

	.card-description {
		color: #d4dbea;
		font-size: 11px;
		line-height: 1.3;
	}

	.card-action {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
		margin-top: 5px;
		padding-top: 7px;
		border-top: 1px solid rgba(250, 204, 107, 0.28);
		color: #facc6b;
		font-size: 11px;
		font-weight: 700;
		line-height: 1.15;
	}

	.card-action-text {
		min-width: 0;
	}

	.card-action-platform {
		display: block;
		margin-top: 2px;
		color: #e9dfc5;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.025em;
	}

	.card-action-arrow {
		display: grid;
		width: 23px;
		height: 23px;
		flex: 0 0 23px;
		place-items: center;
		border: 1px solid rgba(250, 204, 107, 0.58);
		border-radius: 50%;
		background: rgba(250, 204, 107, 0.07);
		transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
	}

	.card-action-arrow svg {
		width: 12px;
		height: 12px;
	}

	.start-card:is(:hover, :focus-visible) .card-action-arrow {
		transform: translateX(2px);
		background: #facc6b;
		color: #080f30;
	}

	.circle-cta {
		display: none;
	}

	.secondary-img {
		position: relative;
		width: 100%;
		margin-top: 2.5rem;
		aspect-ratio: 2.2 / 1;
		overflow: hidden;
		border: 1px solid rgba(250, 204, 107, 0.38);
		border-radius: 16px;
		color: #fff;
		text-decoration: none;
		isolation: isolate;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.secondary-img :global(img) {
		position: relative;
		z-index: 0;
		object-position: center 20%;
	}

	.secondary-img-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgba(0, 0, 28, 0.5), rgba(0, 0, 28, 0.04) 75%),
			linear-gradient(0deg, rgba(0, 0, 28, 0.88), transparent 72%);
	}

	.secondary-img-copy {
		position: absolute;
		z-index: 2;
		left: clamp(12px, 1.4vw, 20px);
		bottom: clamp(10px, 1.2vw, 18px);
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.secondary-img-kicker {
		color: #FACC6B;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.secondary-img-title {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(14px, 1.15vw, 17px);
		font-weight: 600;
		line-height: 1.2;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
	}

	.secondary-img-arrow {
		position: absolute;
		top: clamp(9px, 1.2vw, 16px);
		right: clamp(9px, 1.2vw, 16px);
		z-index: 2;
		display: grid;
		width: clamp(28px, 2.8vw, 38px);
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 9999px;
		background: rgba(0, 0, 28, 0.42);
		color: #fff;
		backdrop-filter: blur(8px);
		transition: color 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
	}

	.secondary-img:hover {
		border-color: rgba(250, 204, 107, 0.8);
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7), 0 0 24px rgba(212, 175, 55, 0.16);
	}

	.secondary-img:hover .secondary-img-arrow {
		transform: translate(2px, -2px);
		background: #FACC6B;
		color: #00001C;
	}

	.social-bar {
		display: none;
	}

	@media (min-width: 768px) {
		.hero-photos {
			top: 112px;
			bottom: 0;
			left: auto;
			height: calc(100% - 112px);
			width: 62%;
		}

		.hero-photo img {
			object-position: 90% bottom;
		}

		.hero-layout {
			--portfolio-width: min(35%, 540px);
			--project-width: 250px;
			--bottom-row-gap: 12px;
			display: block;
			/* La vignette basse grandit avec l'écran : conserver de l'air sous le texte. */
			min-height: max(100svh, clamp(820px, calc(40vw + 320px), 1000px));
			padding: 0;
		}

		.hero-slide-controls {
			position: absolute;
			right: 8.7%;
			bottom: 3%;
			width: min(26vw, 295px);
			min-width: 260px;
			margin-top: 0;
		}

		.hero-copy {
			position: absolute;
			left: 4%;
			top: 19%;
			width: min(45%, 720px);
		}

		.hero-title {
			position: relative;
		}

		.hero-h1 {
			font-size: clamp(2.75rem, 5.8vw, 6.25rem);
			line-height: 1.02;
		}

		.hero-sub {
			margin-top: 0.8vw;
			font-size: 1.1vw;
		}

		.hero-desc {
			position: relative;
			left: auto;
			top: auto;
			width: 100%;
			max-width: none;
			margin-top: clamp(1.25rem, 1.4vw, 1.5rem);
			font-size: clamp(15px, 1.05vw, 17px);
			line-height: 1.55;
		}

		/* Vignette et projet partagent un alignement bas et un espacement constant. */
		.start-card {
			position: absolute;
			left: calc(6.4% + var(--portfolio-width) + var(--bottom-row-gap));
			bottom: 3%;
			width: var(--project-width);
			margin-top: 0;
