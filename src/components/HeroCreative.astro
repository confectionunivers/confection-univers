---
/**
 * Hero « vitrine » reproduit d'après la référence Xriver Home 03.
 * Composition : grand titre condensé à gauche, portrait dominant à droite,
 * texte descriptif, carte projet, bouton circulaire, barre sociale verticale
 * et image secondaire qui déborde sur la section suivante.
 * Palette de marque : bleu nuit (#00001C) et or (#D4AF37).
 */

/**
 * Silhouettes détourées du hero. Les fichiers vivent dans public/images/hero-slides
 * (PNG transparents) et une version WebP ~12x plus légère est générée à côté
 * avec `node scripts/optimize-hero-images.mjs`. Le WebP est servi en priorité,
 * le PNG sert de repli.
 */
const slides = [
	{ name: 'cutout-business-suit', width: 1152, height: 2064, label: 'Costume professionnel', alt: 'Homme en costume professionnel bleu nuit et or, en pied' },
	{ name: 'cutout-graduation-gown', width: 1152, height: 2064, label: 'Toges de graduation', alt: 'Diplômée en toge bleu nuit et or, en pied' },
	{ name: 'cutout-workwear', width: 1152, height: 2064, label: 'Tenues de travail', alt: 'Professionnel en tenue de travail bleu nuit, en pied' },
	{ name: 'cutout-medical', width: 1152, height: 2064, label: 'Blouses médicales', alt: 'Professionnelle de santé en blouse blanche, en pied' },
	{ name: 'cutout-sport', width: 1152, height: 2064, label: 'Tenues de sport', alt: 'Homme en tenue de sport noire avec liserés blancs, en pied' },
].map((slide) => ({
	...slide,
	webp: `/images/hero-slides/${slide.name}.webp`,
	png: `/images/hero-slides/${slide.name}.png`,
}));

const social = [
	{ label: 'Instagram', href: 'https://instagram.com/confectionunivers', icon: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H7zm5 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 2a2.5 2.5 0 100 5 2.5 2.5 0 000-5z' },
	{ label: 'LinkedIn', href: 'https://linkedin.com/company/confectionunivers', icon: 'M4 3a2 2 0 110 4 2 2 0 010-4zm-1 6h3v12H3V9zm6 0h3v2c.5-1 1.8-2 3.6-2C19.5 9 21 10.5 21 13.5V21h-3v-6.5c0-1.6-.6-2.5-2-2.5s-2.5 1-2.5 2.6V21H9V9z' },
	{ label: 'Facebook', href: 'https://facebook.com/confectionunivers', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
	{ label: 'WhatsApp', href: 'https://wa.me/221772960776', icon: 'M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z' },
];
---

<section id="hero-cu" class="hero-cu relative z-20 min-h-[100svh] w-full text-white" aria-label="Accueil">
	<!-- Fond bleu et lueurs fixes ; seules les silhouettes PNG transparentes défilent. -->
	<div class="hero-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<div class="hero-shade absolute inset-0"></div>
		<div class="glow glow-1"></div>
		<div class="glow glow-2"></div>
		<div class="glow glow-3"></div>

		<div class="hero-photos">
			{
				slides.map((s, idx) => (
					<picture
						data-slide
						data-label={s.label}
						class:list={['hero-photo', idx === 0 && 'is-active']}
					>
						<source srcset={s.webp} type="image/webp" />
						<img
							src={s.png}
							alt=""
							width={s.width}
							height={s.height}
							loading={idx === 0 ? 'eager' : 'lazy'}
							fetchpriority={idx === 0 ? 'high' : 'auto'}
							decoding="async"
						/>
					</picture>
				))
			}
		</div>
	</div>

	<div class="hero-layout">
		<!-- Titre et description restent dans un même flux pour éviter tout chevauchement -->
		<div class="hero-copy">
			<div class="reveal hero-title">
				<h1 class="title-gradient uppercase hero-h1"><span class="block">Confection</span><span class="block">Univers</span></h1>
				<p class="subtitle font-anton uppercase hero-sub">
					Confection de vêtements professionnels - Sénégal
				</p>
			</div>

			<!-- Texte descriptif -->
			<div class="reveal reveal-d1 hero-desc text-white/90">
				<p class="hero-lead">
					Vêtements de qualité supérieure fabriqués avec précision. Designs personnalisés adaptés à vos spécifications.
					Production en gros fiable pour les institutions et entreprises de toutes tailles.
				</p>
				<div class="hero-actions">
					<a href="/contact" class="hero-btn hero-btn-primary">Demander un devis</a>
					<a href="/catalogue" class="hero-btn hero-btn-ghost">Voir nos produits</a>
				</div>
				<ul class="hero-badges" aria-label="Points forts">
					<li>Uniformes sur mesure</li>
					<li>Qualité premium</li>
					<li>Production en gros</li>
				</ul>
			</div>
		</div>

		<!-- Carte « Démarrer un projet » -->
		<a
			href="/contact"
			class="start-card reveal reveal-d2"
		>
			<span class="card-img">
				<img src={slides[1].src} alt="" class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
			</span>
			<span class="flex flex-col justify-center gap-1 px-4 py-3">
				<span class="font-anton card-title uppercase">Démarrer un projet</span>
				<span class="text-[12.5px] leading-snug text-white/75">Parlez-en directement à notre équipe</span>
			</span>
		</a>

		<!-- Bouton circulaire -->
		<a
			href="/services"
			class="circle-cta"
			aria-label="Découvrir nos services"
		>
			<span class="relative z-10 text-[11px] font-medium tracking-wide">Commencer</span>
		</a>

		<!-- Image secondaire : déborde sur la section suivante -->
		<div class="secondary-img reveal reveal-d3">
			<img src="/images/hero-toges-graduation.jpg" alt="Toges de graduation Confection Univers" class="h-full w-full object-cover" loading="lazy" decoding="async" />
		</div>
	</div>

	<!-- Barre sociale verticale (grand écran) -->
	<aside
		class="social-bar"
		aria-label="Réseaux sociaux et visuels"
	>
		<a href="#hero-cu" class="round-btn flex h-12 w-12 items-center justify-center rounded-full" aria-label="Haut de page">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 15l6-6 6 6" /></svg>
		</a>

		<div class="flex flex-col items-center gap-3">
			{
				social.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" class="social-btn flex h-[30px] w-[30px] items-center justify-center rounded-full" aria-label={s.label}>
						<svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
					</a>
				))
			}
		</div>

		<p class="vertical-label font-anton text-[13px] uppercase tracking-[0.2em] text-white/90">Follow us :</p>

		<div class="flex flex-col items-center gap-3">
			{
				slides.map((s, idx) => (
					<button type="button" data-thumb class:list={['thumb relative h-12 w-12 rounded-full', idx === 0 && 'is-active']} aria-label={`Afficher ${s.label}`}>
						<img src={s.webp} alt="" class="h-full w-full rounded-full object-cover object-top" loading="lazy" decoding="async" />
						<span class="thumb-num absolute -right-1 -top-1 rounded-[4px] px-1 font-anton text-[10px] leading-[16px]">
							{String(idx + 1).padStart(2, '0')}
						</span>
					</button>
				))
			}
		</div>
	</aside>
</section>

<script>
	import gsap from 'gsap';
	import { initHeroFx } from '../scripts/hero-fx';

	const root = document.getElementById('hero-cu');
	if (root) {
		initHeroFx(root);
		const slides = Array.from(root.querySelectorAll<HTMLImageElement>('[data-slide]'));
		const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;
		let timer: number | undefined;
		let slideAnimation: gsap.core.Animation | undefined;
		let imageDrift: gsap.core.Tween | undefined;

		const stop = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		};

		const setThumb = (activeIndex: number, animate = false) => {
			thumbs.forEach((thumb, index) => thumb.classList.toggle('is-active', index === activeIndex));
			const activeThumb = thumbs[activeIndex];
			if (animate && activeThumb && !reduceMotion) {
				gsap.fromTo(
					activeThumb,
					{ scale: 0.84, transformOrigin: '50% 50%' },
					{ scale: 1, duration: 0.6, ease: 'back.out(2.4)', clearProps: 'transform' },
				);
			}
		};

		const show = (requestedIndex: number) => {
			if (!slides.length) return;
			const nextIndex = ((requestedIndex % slides.length) + slides.length) % slides.length;
			if (nextIndex === current) return;

			slideAnimation?.kill();
			imageDrift?.kill();
			gsap.set(slides, { clearProps: 'all' });

			const previousIndex = current;
			const outgoing = slides[previousIndex];
			const incoming = slides[nextIndex];
			const forward = nextIndex > previousIndex;
			current = nextIndex;
			setThumb(nextIndex, true);

			if (reduceMotion) {
				slides.forEach((slide, index) => slide.classList.toggle('is-active', index === nextIndex));
				return;
			}

			slides.forEach((slide, index) => slide.classList.toggle('is-active', index === nextIndex));
			gsap.set(outgoing, { opacity: 1, scale: 1, xPercent: 0, filter: 'blur(0px)', clipPath: 'inset(0)' });
			gsap.set(incoming, {
				opacity: 0,
				scale: 1.025,
				xPercent: forward ? 1.5 : -1.5,
				filter: 'blur(8px)',
				clipPath: forward ? 'inset(0 0 0 58%)' : 'inset(0 42% 0 0)',
			});

			slideAnimation = gsap.timeline({
				onComplete: () => {
					gsap.set([outgoing, incoming], { clearProps: 'all' });
					imageDrift = gsap.to(incoming, { scale: 1.018, duration: 4.5, ease: 'none' });
				},
			});
			slideAnimation
				.to(outgoing, {
					opacity: 0,
					scale: 1.015,
					xPercent: forward ? -1 : 1,
					filter: 'blur(3px)',
					duration: 0.9,
					ease: 'power2.in',
				}, 0)
				.to(incoming, {
					opacity: 1,
					scale: 1,
					xPercent: 0,
					filter: 'blur(0px)',
					clipPath: 'inset(0)',
					duration: 1.35,
					ease: 'power4.out',
				}, 0);
		};

		const start = () => {
			if (reduceMotion || slides.length < 2) return;
			stop();
			timer = window.setInterval(() => show((current + 1) % slides.length), 6500);
		};

		thumbs.forEach((thumb, index) =>
			thumb.addEventListener('click', () => {
				show(index);
				start();
			}),
		);
		root.addEventListener('mouseenter', stop);
		root.addEventListener('mouseleave', start);

		// Effet 3D léger sur la carte projet
		const card = root.querySelector<HTMLElement>('.start-card');
		if (card && !reduceMotion) {
			card.addEventListener('mousemove', (e) => {
				const r = card.getBoundingClientRect();
				const x = (e.clientX - r.left) / r.width - 0.5;
				const y = (e.clientY - r.top) / r.height - 0.5;
				card.style.transform = `perspective(700px) rotateX(${-y * 8}deg) rotateY(${x * 10}deg)`;
			});
			card.addEventListener('mouseleave', () => (card.style.transform = ''));
		}

		// Première image : entrée cinématique, puis léger zoom continu.
		slides.forEach((slide, index) => slide.classList.toggle('is-active', index === 0));
		setThumb(0);
		if (!reduceMotion && slides[0]) {
			slideAnimation = gsap.fromTo(
				slides[0],
					{ opacity: 0, scale: 1.025, xPercent: 1.5, filter: 'blur(8px)', clipPath: 'inset(0 0 0 58%)' },
					{
						opacity: 1,
						scale: 1,
						xPercent: 0,
						filter: 'blur(0px)',
						clipPath: 'inset(0)',
						duration: 1.55,
						delay: 0.15,
						ease: 'power4.out',
						clearProps: 'all',
						onComplete: () => {
							imageDrift = gsap.to(slides[0], { scale: 1.018, duration: 4.5, ease: 'none' });
						},
					},
			);
		}
		start();
	}
</script>

<style>
	/* ---------- Typographie ---------- */
	.font-anton {
		font-family: 'Anton', 'Space Grotesk', sans-serif;
	}

	.hero-cu .subtitle {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-weight: 500;
		letter-spacing: 0.16em;
	}

	/* Titre : blanc vers or champagne (équivalent du dégradé rose de la référence) */
	.title-gradient {
		background: linear-gradient(180deg, #ffffff 0%, #fff6d5 42%, #facc6b 78%, #d4af37 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: none;
		filter: drop-shadow(0 8px 26px rgba(0, 0, 20, 0.45));
	}

	.subtitle {
		color: #ffffff;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
	}

	/* ---------- Fond bleu conservé sous les silhouettes détourées ---------- */
	.hero-bg {
		background-color: #00001C;
	}

	.glow {
		position: absolute;
		z-index: 1;
		border-radius: 9999px;
		filter: blur(110px);
		animation: cu-float 16s ease-in-out infinite;
	}
	.glow-1 { left: -8%; top: 0; width: 46vw; height: 46vw; background: #2236a8; opacity: 0.45; }
	.glow-2 { left: 28%; bottom: 0; width: 30vw; height: 30vw; background: #D4AF37; opacity: 0.18; animation-delay: -5s; }
	.glow-3 { right: 20%; top: 20%; width: 26vw; height: 26vw; background: #3d6bff; opacity: 0.22; animation-delay: -9s; }

	.hero-shade {
		z-index: 0;
		background:
			linear-gradient(90deg, #00001C 0%, rgba(0, 0, 28, 0.85) 30%, rgba(0, 0, 28, 0.25) 60%, rgba(0, 0, 28, 0) 75%),
			linear-gradient(0deg, #00001C 0%, rgba(0, 0, 28, 0) 22%);
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		transform: scale(1.025);
		transform-origin: center center;
		filter: saturate(1.04) contrast(1.02) drop-shadow(0 18px 36px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 24px rgba(212, 175, 55, 0.1));
		will-change: opacity, transform, filter, clip-path;
	}

	/* Le <picture> gère l'animation, l'<img> gère le cadrage de la silhouette. */
	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: 75% bottom;
	}

	.hero-photo.is-active {
		z-index: 1;
		opacity: 1;
		transform: scale(1);
	}

	/* ---------- Scène photo : hauteur complète et silhouettes sans rognage ---------- */
	.hero-photos {
		position: absolute;
		top: 112px;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		height: calc(100% - 112px);
		overflow: hidden;
	}

	.hero-layout {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		margin: 0 auto;
		padding: 46svh 6% 3.5rem;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
	}

	.hero-title {
		position: relative;
	}

	.hero-h1 {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		font-size: 12vw;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.hero-sub {
		margin-top: 0.25rem;
		font-size: 7vw;
		line-height: 1;
	}

	.hero-desc {
		margin-top: 2rem;
		max-width: 24rem;
		font-size: 15px;
		line-height: 1.5;
	}

	.hero-lead {
		margin: 0 0 1.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 22px;
		border-radius: 9999px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
	}

	.hero-btn-primary {
		background: linear-gradient(135deg, #FACC6B 0%, #D4AF37 50%, #B8860B 100%);
		color: #00001C;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 10px 24px -10px rgba(212, 175, 55, 0.7);
	}

	.hero-btn-ghost {
		border: 1px solid rgba(255, 255, 255, 0.4);
		color: #ffffff;
		background: rgba(0, 0, 20, 0.35);
		backdrop-filter: blur(6px);
	}

	.hero-btn:hover {
		transform: translateY(-2px);
	}

	.hero-btn-ghost:hover {
		border-color: #D4AF37;
		color: #FACC6B;
	}

	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0;
		list-style: none;
	}

	.hero-badges li {
		padding: 5px 12px;
		border-radius: 9999px;
		border: 1px solid rgba(212, 175, 55, 0.4);
		background: rgba(0, 0, 28, 0.5);
		color: #FFE9A8;
		font-size: 12px;
		font-weight: 600;
	}

	.start-card {
		display: flex;
		align-items: stretch;
		width: min(250px, 100%);
		margin-top: 2rem;
		overflow: hidden;
		border-radius: 14px;
	}

	.card-img {
		position: relative;
		width: 84px;
		height: 80px;
		flex-shrink: 0;
	}

	.card-title {
		font-size: 20px;
		line-height: 1;
	}

	.circle-cta {
		display: none;
	}

	.secondary-img {
		position: relative;
		width: 100%;
		margin-top: 2.5rem;
		aspect-ratio: 2.2 / 1;
		overflow: hidden;
		border-radius: 14px;
	}

	.social-bar {
		display: none;
	}

	@media (min-width: 768px) {
		.hero-photos {
			top: 112px;
			bottom: 0;
			left: auto;
			height: calc(100% - 112px);
			width: 62%;
		}

		.hero-photo img {
			object-position: 90% bottom;
		}

		.hero-layout {
			display: block;
			padding: 0;
		}

		.hero-copy {
			position: absolute;
			left: 4%;
			top: 19%;
			width: min(45%, 720px);
		}

		.hero-title {
			position: relative;
		}

		.hero-h1 {
			font-size: 6.2vw;
			line-height: 1.02;
		}

		.hero-sub {
			margin-top: 0.8vw;
			font-size: 1.1vw;
		}

		.hero-desc {
			position: relative;
			left: auto;
			top: auto;
			width: 100%;
			max-width: none;
			margin-top: clamp(1.25rem, 1.4vw, 1.5rem);
			font-size: clamp(15px, 1.05vw, 17px);
			line-height: 1.55;
		}

		.start-card {
			position: absolute;
			left: 50.8%;
			top: 82.5%;
			width: 250px;
			margin-top: 0;
		}

		.card-img {
			width: 96px;
			height: 94px;
		}

		.card-title {
			font-size: clamp(16px, 1.35vw, 22px);
		}

		.circle-cta {
			display: none;
		}

		.secondary-img {
			position: absolute;
			left: 6.4%;
			top: auto;
			bottom: 3%;
			width: min(35%, 540px);
			margin-top: 0;
		}
	}

	/* Garde une colonne libre pour la silhouette sur tablette, sans superposer la carte. */
	@media (min-width: 768px) and (max-width: 1279px) {
		.hero-photos {
			width: 56%;
		}

		.start-card {
			left: 36%;
			width: min(250px, 24vw);
		}

		.circle-cta {
			display: none;
		}

		.secondary-img {
			width: min(28%, 360px);
		}
	}

	/* Sur téléphone, la personne reste à droite et le texte conserve sa propre colonne. */
	@media (max-width: 767px) {
		.hero-photos {
			left: 52%;
			width: 48%;
		}

		.hero-layout {
			padding: clamp(188px, 25svh, 230px) 6% clamp(4.5rem, 15svh, 7rem);
		}

		.hero-copy {
			width: 54%;
		}

		.hero-h1 {
			font-size: clamp(1.8rem, 8vw, 2.5rem);
			line-height: 0.98;
		}

		.hero-sub {
			margin-top: 0.35rem;
			font-size: clamp(0.75rem, 3.6vw, 0.9rem);
			line-height: 1.25;
		}

		.hero-desc {
			max-width: none;
			margin-top: 1rem;
			font-size: 12px;
			line-height: 1.45;
		}

		.hero-lead {
			margin-bottom: 1rem;
		}

		.hero-actions {
			gap: 0.5rem;
		}

		.hero-btn {
			height: 40px;
			padding: 0 12px;
			font-size: 12px;
