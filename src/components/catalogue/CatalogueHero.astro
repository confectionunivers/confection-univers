---
import MarqueeBand from '../ui/MarqueeBand.astro';
import SewingDecor from '../decor/SewingDecor.astro';
import RollButton from '../ui/RollButton.astro';
---

<section class="catalogue-hero relative overflow-hidden px-6 pb-14 pt-36 text-white md:pb-20 md:pt-44" style="background: linear-gradient(160deg, #00004B 0%, #00004A 50%, #000039 100%);" aria-labelledby="catalogue-heading">
	<div class="relative mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:items-center lg:gap-8">
		<div class="relative z-10 lg:col-span-5">
			<div class="nx-badge mb-7" data-motion="fade">
				<span class="h-1.5 w-1.5 rounded-full bg-[#F5B544]"></span>
				Confection professionnelle · Thiès, Sénégal
			</div>
			<h1 id="catalogue-heading" class="nx-display nx-display--xl">
				<span class="nx-mask block"><span data-motion="up" data-motion-delay="0.05">Notre</span></span>
				<span class="nx-mask mt-1 block"><span class="nx-accent" data-motion="up" data-motion-delay="0.14">catalogue.</span></span>
			</h1>
			<p class="mt-7 max-w-xl font-display text-lg font-medium leading-snug text-[#F7F5F0] md:text-xl" data-motion="up" data-motion-delay="0.2">
				Des solutions textiles conçues pour répondre aux exigences des professionnels.
			</p>
			<p class="mt-4 max-w-xl text-sm leading-[1.85] text-white/65 md:text-base" data-motion="up" data-motion-delay="0.26">
				De la conception à la production, Confection Univers accompagne les entreprises, établissements et organisations dans la réalisation de vêtements professionnels, uniformes et tenues personnalisées.
			</p>

			<div class="mt-8 flex flex-col gap-3 sm:flex-row" data-motion="up" data-motion-delay="0.3">
				<RollButton href="#catalogue-offres" label="Explorer le catalogue" variant="solid" />
				<RollButton href="#devis" label="Demander un devis" />
			</div>

			<p class="mt-7 text-[10px] uppercase tracking-[0.18em] text-white/40">
				Uniformes · Tenues de travail · Confection à façon
			</p>
		</div>

		<figure class="catalogue-hero-visual relative lg:col-span-7">
			<div class="absolute -inset-3 hidden rounded-[1.8rem] border border-[#F5B544]/20 lg:block" aria-hidden="true"></div>
			<div class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] border border-[#F5B544]/35 bg-[#000058] shadow-[0_24px_60px_rgba(0,0,0,0.45)] sm:aspect-[16/10]">
				<picture>
					<source
						type="image/webp"
						srcset="/images/catalogue/manufacture-hero-1280.webp 1280w, /images/catalogue/manufacture-hero-1600.webp 1600w"
						sizes="(min-width: 1024px) 58vw, 100vw"
					/>
					<img
						src="/images/catalogue/manufacture-hero-1280.webp"
						alt="Table de confection, vêtements professionnels et poste de couture — visuel d’illustration généré"
						class="h-full w-full object-cover object-center"
						width="1672"
						height="941"
						fetchpriority="high"
						decoding="async"
					/>
				</picture>
				<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#00004B]/25 via-transparent to-[#00004B]/5" aria-hidden="true"></div>
				<div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-4 border-t border-white/25 pt-3 text-[9px] font-medium uppercase tracking-[0.16em] text-white/75 sm:bottom-6 sm:left-6 sm:right-6 sm:text-[10px]">
					<span>Textile · Coupe · Assemblage</span>
					<span class="text-right text-white/50">Illustration générée</span>
				</div>
			</div>
			<figcaption class="mt-3 flex items-center justify-between gap-4 text-[10px] leading-relaxed text-white/40">
				<span>Un univers de confection professionnelle, présenté à titre illustratif.</span>
				<span class="hidden uppercase tracking-[0.18em] sm:block">Confection Univers</span>
			</figcaption>
		</figure>
	</div>

	<div class="mx-auto mt-12 max-w-7xl border-t border-white/10 pt-5 md:mt-16">
		<div class="grid gap-2 text-[10px] font-medium uppercase tracking-[0.2em] text-white/45 sm:grid-cols-3">
			<p><span class="mr-3 text-[#F5B544]">01</span>Uniformes & vêtements professionnels</p>
			<p><span class="mr-3 text-[#F5B544]">02</span>Personnalisation selon votre cahier des charges</p>
			<p><span class="mr-3 text-[#F5B544]">03</span>Demande étudiée sur devis</p>
		</div>
	</div>

	<!-- Bandeau défilant -->
	<MarqueeBand
		class="relative z-10 mt-14 border-t border-white/10 pt-8"
		tone="dark"
		duration={17}
		words={['Scolaire', 'Professionnel', 'Médical', 'Académique', 'Sportif', 'Africain']}
		accent={3}
	/>

	<SewingDecor variant="tape" class="pointer-events-none absolute -bottom-4 right-6 hidden h-24 w-24 text-[#F5B544] opacity-[0.12] lg:block" />
</section>

<style>
	.catalogue-hero-visual img {
		animation: catalogue-image-arrive 900ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
	}

	@keyframes catalogue-image-arrive {
		from { opacity: 0.6; transform: scale(1.025); }
		to { opacity: 1; transform: scale(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.catalogue-hero-visual img { animation: none; }
	}
</style>
